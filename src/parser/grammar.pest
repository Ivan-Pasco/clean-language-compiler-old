// Basic tokens - DISABLE AUTOMATIC WHITESPACE for indentation-sensitive parsing
WHITESPACE = _{ " " | "\r" }
COMMENT = _{ ("#" | "//") ~ (!"\n" ~ ANY)* | "/*" ~ (!"*/" ~ ANY)* ~ "*/" }

// Trivia rules for handling comments in indented contexts
// LINE_TRIVIA handles single-line comments with proper indentation preservation
LINE_TRIVIA = _{ INDENT* ~ "//" ~ (!"\n" ~ ANY)* ~ ("\n" | EOI) }
// BLOCK_TRIVIA handles multi-line comments
BLOCK_TRIVIA = _{ INDENT* ~ "/*" ~ (!"*/" ~ ANY)* ~ "*/" }
// Empty line with optional whitespace (for clean whitespace handling)
EMPTY_LINE_TRIVIA = _{ INDENT* ~ NEWLINE }
// Combined trivia rule for any comment or empty line with indentation
TRIVIA = _{ LINE_TRIVIA | BLOCK_TRIVIA | EMPTY_LINE_TRIVIA }

// Keywords and identifiers
keyword = { ("return" | "if" | "else" | "then" | "iterate" | "in" | "to" | "step" | "tests" | "error" | "function" | "functions" | "input" | "description" | "class" | "constructor" | "is" | "and" | "or" | "not" | "true" | "false" | "none" | "onError" | "constant" | "private" | "base" | "list" | "matrix" | "pairs" | "integer" | "number" | "boolean" | "string" | "void" | "any" | "import" | "from" | "as" | "later" | "background" | "start" | "print" | "break" | "continue" | "while" | "state" | "watch" | "computed" | "screen" | "guard" | "reset" | "require" | "rules" | "spec" | "intent" | "source" | "build") ~ !(ASCII_ALPHANUMERIC | "_") }
// Identifiers can start with letter or underscore (underscore prefix for internal/bridge functions)
identifier = @{ !keyword ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

// Extended numeric literals
hex_integer = @{ "-"? ~ "0" ~ ("x" | "X") ~ ASCII_HEX_DIGIT+ }
binary_integer = @{ "-"? ~ "0" ~ ("b" | "B") ~ ASCII_BIN_DIGIT+ }
octal_integer = @{ "-"? ~ "0" ~ ("o" | "O") ~ ASCII_OCT_DIGIT+ }
decimal_integer = @{ "-"? ~ ASCII_DIGIT+ }

integer = _{ hex_integer | binary_integer | octal_integer | decimal_integer }
// Float supports both decimal notation (1.23) and scientific notation (1e-100, 1.23e-45, 6.02e23)
float = @{ "-"? ~ ASCII_DIGIT+ ~ (
    ("." ~ ASCII_DIGIT+ ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)?) |
    (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)
)}
number = _{ float | integer }
boolean = { "true" | "false" }

// null-support - None literal for representing absence of value
none_literal = { "none" }

// Advanced size specifiers for types
size_specifier = { ":" ~ ASCII_DIGIT+ ~ ("u")? }

// String interpolation with {} syntax and escaped quotes
string_content = @{ (!("\"" | "\\") ~ ANY)+ }
escaped_char = @{ "\\" ~ ("\"" | "{" | "}" | "\\" | "n" | "r" | "t") }
string_interpolation = { "{" ~ logical_expression ~ "}" }
string_part = { escaped_char | string_interpolation | string_content }
string = { "\"" ~ string_part* ~ "\"" }

// Core types from specification
core_type = { 
    "boolean" |
    "integer" |
    "number" |
    "string" |
    "void" |
    "any"
}

// Advanced types with size specifiers
sized_type = @{ core_type ~ size_specifier }

// Composite types
matrix_type = { "matrix" ~ "<" ~ " "* ~ type_ ~ " "* ~ ">" }
list_type = { "list" ~ "<" ~ " "* ~ type_ ~ " "* ~ ">" }
pairs_type = { "pairs" ~ "<" ~ " "* ~ type_ ~ " "* ~ "," ~ " "* ~ type_ ~ " "* ~ ">" }

// Generic types
generic_type = { identifier ~ "<" ~ type_arguments ~ ">" }
type_parameter = @{ identifier }
type_parameters = { "<" ~ type_parameter ~ ("," ~ type_parameter)* ~ ">" }
type_arguments = { type_ ~ ("," ~ type_)* }

// Type definition - Order matters: sized types before core types to prioritize precision modifiers
type_ = {
    matrix_type |
    list_type |
    pairs_type |
    generic_type |
    sized_type |
    core_type |
    identifier |
    type_parameter
}

// Indentation-based blocks
INDENT = _{ "\t" }
NEWLINE = _{ "\n" | "\r\n" }
empty_line = _{ INDENT* ~ NEWLINE }
comment_line = _{ INDENT* ~ ("/*" ~ (!"*/" ~ ANY)* ~ "*/" | "//" ~ (!"\n" ~ ANY)*) ~ NEWLINE? }
trivia_line = _{ empty_line | comment_line }
// Comments in function bodies are handled by the global COMMENT rule automatically

// Stack-based context-aware indentation for functions blocks
indent_context = { PUSH(INDENT*) }
indent_match = { PEEK_ALL }
indent_end = { DROP }

// Context-aware indented block for functions blocks
context_indented_block = { 
    NEWLINE ~ (empty_line)* ~ 
    PUSH(INDENT+) ~ 
    PEEK_ALL ~ function_in_block ~ 
    ((NEWLINE ~ (empty_line)*) ~ PEEK_ALL ~ function_in_block)* ~ 
    (NEWLINE ~ (empty_line)*)? ~
    DROP 
}

// Smart indented block - uses different strategies based on context
indented_block = { simple_indented_block | function_nested_block }

// Simple indented block for top-level contexts (start function, etc.)
// Fixed to enforce consistent single-tab indentation per Clean Language Specification
// Each indentation level must use exactly ONE tab character
simple_indented_block = {
    NEWLINE ~ (empty_line)* ~
    INDENT ~ statement ~
    (NEWLINE ~ (empty_line)* ~ INDENT ~ statement)*
}

// Removed indented_statement rule - was allowing INDENT+ which mixed indentation levels

// Nested block within function bodies - flexible indentation pattern for nested contexts
function_nested_block = { 
    NEWLINE ~ (empty_line)* ~ 
    INDENT ~ INDENT+ ~ statement ~ 
    (NEWLINE ~ (empty_line)* ~ INDENT ~ INDENT+ ~ statement)* 
}

// Apply-blocks (core language feature) - Specification compliant
apply_block = { constant_apply_block | type_apply_block | method_apply_block | function_apply_block }

// Constant apply-blocks: constant: integer MAX_SIZE = 100 (most specific first)
constant_apply_block = { "constant" ~ ":" ~ indented_constant_assignments }
indented_constant_assignments = { NEWLINE ~ (empty_line)* ~ INDENT+ ~ constant_assignment ~ (NEWLINE ~ (empty_line)* ~ INDENT+ ~ constant_assignment)* }
constant_assignment = { type_ ~ WHITESPACE* ~ identifier ~ WHITESPACE* ~ "=" ~ WHITESPACE* ~ single_line_expression }

// Type apply-blocks: integer: count = 0, maxSize = 100 (types before generic identifiers)
// Note: sized_type now included to support precision modifiers like integer:32
type_apply_block = { (sized_type | core_type | matrix_type | list_type | pairs_type) ~ ":" ~ &(NEWLINE) ~ indented_variable_assignments }
indented_variable_assignments = { NEWLINE ~ (empty_line)* ~ INDENT+ ~ variable_assignment ~ (NEWLINE ~ (empty_line)* ~ INDENT+ ~ variable_assignment)* }
variable_assignment = { identifier ~ WHITESPACE* ~ "=" ~ WHITESPACE* ~ single_line_expression }

// Method apply-blocks: array.push: item1, item2, item3 (object.method before generic identifiers)
method_apply_block = { method_call_chain ~ ":" ~ indented_expressions }
method_call_chain = { identifier ~ ("." ~ identifier)+ }

// Function apply-blocks: print: "Hello", "World" (catch-all for identifiers and specific keywords)
function_name_in_apply_block = { "print" | identifier }
function_apply_block = { !("functions" ~ ":") ~ function_name_in_apply_block ~ ":" ~ indented_expressions }
// Fixed: Match only expressions at deeper indentation than parent statement
indented_expressions = {
    NEWLINE ~ (empty_line)* ~
    &(INDENT ~ INDENT) ~ // Lookahead: require at least 2 levels of indentation
    INDENT+ ~ expression ~
    (NEWLINE ~ (empty_line)* ~ &(INDENT ~ INDENT) ~ INDENT+ ~ !apply_block_start ~ expression)*
}

// Helper rule to detect the start of a new apply-block
apply_block_start = { (sized_type | core_type | matrix_type | list_type | pairs_type) ~ ":" | identifier ~ ("." ~ identifier)+ ~ ":" | "constant" ~ ":" | function_name_in_apply_block ~ ":" }

// Framework blocks for DSL plugins (endpoints:, data, component, screen, etc.)
// Captures raw content without parsing - plugins handle their own DSL syntax
// Supports: "identifier:", "identifier string:", "identifier identifier:"
framework_block = { !keyword ~ !("constant" | "functions" | "tests" | "private") ~ identifier ~ (WHITESPACE* ~ (string | identifier))? ~ ":" ~ framework_block_content }
framework_block_content = @{
    NEWLINE ~ (empty_line)* ~
    (INDENT+ ~ (!NEWLINE ~ ANY)* ~ (NEWLINE | EOI))+
}

// Setup blocks for functions
description_block = { "description" ~ string }
input_type = { 
    matrix_type |
    list_type |
    pairs_type |
    generic_type |
    core_type |
    sized_type |
    type_parameter
}
input_declaration = { input_type ~ identifier ~ ("=" ~ expression)? }
standalone_input_declaration = { "input" ~ input_type ~ identifier ~ ("=" ~ expression)? }
input_block = { "input" ~ indented_input_block }
indented_input_block = { NEWLINE ~ (empty_line)* ~ INDENT+ ~ input_declaration ~ (NEWLINE ~ (empty_line)* ~ INDENT+ ~ input_declaration)* }
indented_block_with_declarations = { NEWLINE ~ INDENT+ ~ input_declaration ~ (NEWLINE ~ INDENT+ ~ input_declaration)* }

setup_block = { (description_block ~ NEWLINE ~ input_block) | (input_block ~ NEWLINE ~ description_block) | input_block | description_block }

// Object access and method calls
builtin_class_name = { "list" | "file" | "http" | "math" | "input" | "logical" | "conditional" | "compare" | "Math" | "String" | "List" | "File" | "Http" | "Console" }
// Basic static class identifiers and namespace identifiers
static_class_identifier = { "StringUtils" | "Math" | "String" | "List" | "File" | "Http" | "Console" | "conditional" | "compare" | "logical" | "math" | "string" | "list" | "file" | "http" | "console" | "number" | "integer" | "boolean" }
namespace_identifier = { identifier }

// Multi-level namespace chain (e.g., compare.number, compare.integer)
static_class_name = { static_class_identifier ~ ("." ~ static_class_identifier)* }

// Argument expression - bounded expression that allows arithmetic but stops at natural boundaries
// Argument expressions now support full logical expressions including comparisons
argument_expression = { argument_logical }

// Argument expressions support logical, comparison, and arithmetic operations
argument_logical = { argument_comparison ~ (WHITESPACE* ~ logical_op ~ WHITESPACE* ~ argument_comparison)* }
argument_comparison = { argument_unary ~ (WHITESPACE* ~ comparison_op ~ WHITESPACE* ~ argument_unary)* }
argument_unary = { (unary_op ~ WHITESPACE*)* ~ argument_additive }
argument_additive = { argument_multiplicative ~ (WHITESPACE* ~ additive_op ~ WHITESPACE* ~ argument_multiplicative)* }
argument_multiplicative = { argument_power ~ (WHITESPACE* ~ multiplicative_op ~ WHITESPACE* ~ argument_power)* }
argument_power = { argument_primary ~ (WHITESPACE* ~ power_op ~ WHITESPACE* ~ argument_primary)* }
argument_primary = { primary }

// Named argument: label: expression (grammar.ebnf: named_argument)
// Only valid inside call argument lists; resolved to positional order by HIR.
// FUNC008–FUNC011: validated by the HIR builder (hir/hir_builder.rs).
named_argument = { parameter_name ~ ":" ~ argument_expression }

// A single argument slot — either a named argument or a plain expression.
// grammar.ebnf: argument_item
argument_item = { named_argument | argument_expression }

// Argument list pattern for comma-separated expressions
// Allow newlines and indentation between arguments for multiline function calls
argument_list = { argument_item ~ ("," ~ (WHITESPACE | NEWLINE | INDENT)* ~ argument_item)* }

function_call = { identifier ~ type_arguments? ~ "(" ~ (WHITESPACE | NEWLINE | INDENT)* ~ argument_list? ~ (WHITESPACE | NEWLINE | INDENT)* ~ ")" }

// FIXED: Simplified method chaining using existing proven approach
// Method call syntax for value.method() patterns
method_call_base = { builtin_class_name | string | number | boolean | identifier | "(" ~ single_line_expression ~ ")" }
method_name = { identifier | "greaterThan" | "lessThan" | "equal" | "greaterEqual" | "lessEqual" | "number" | "integer" | "boolean" | "string" | "length" | "isDefined" | "isNotDefined" | "isEmpty" | "isNotEmpty" | "mustBeTrue" | "mustBeFalse" | "mustBeEqual" | "mustNotBeEqual" | "toString" | "toInteger" | "toNumber" | "toBoolean" | "keepBetween" | "yesNo" | "prompt" | "and" | "or" | "not" | "start" | "stop" }
method_call_segment = { "." ~ method_name ~ "(" ~ (WHITESPACE | NEWLINE | INDENT)* ~ argument_list? ~ (WHITESPACE | NEWLINE | INDENT)* ~ ")" }

// FIXED: Use atomic postfix repetition to avoid left recursion
chained_method_call = { (function_call | property_access | identifier) ~ method_call_segment+ }

// Multiple chained method calls (2 or more method calls in sequence)
multiple_method_call = { method_call_base ~ method_call_segment ~ method_call_segment+ }

// Single method call
method_call = { method_call_base ~ method_call_segment }

// Parenthesized expression with method call(s)
// Handles cases like (a + b).toString() or (x * y).toInteger().toString()
parenthesized_method_call = { "(" ~ parenthesized_expr ~ ")" ~ method_call_segment+ }

// Three-level chained method call: namespace.class.method() patterns (most specific)
three_level_method_call = { identifier ~ "." ~ identifier ~ "." ~ method_name ~ "(" ~ (WHITESPACE | NEWLINE | INDENT)* ~ argument_list? ~ (WHITESPACE | NEWLINE | INDENT)* ~ ")" }

// Chained property method call: property.access.method() patterns (two+ levels)
property_method_call = { identifier ~ ("." ~ identifier) ~ ("." ~ identifier)+ ~ "." ~ method_name ~ "(" ~ (WHITESPACE | NEWLINE | INDENT)* ~ argument_list? ~ (WHITESPACE | NEWLINE | INDENT)* ~ ")" }

// Static method call syntax for ClassName.method() patterns (single level)
static_method_call = { static_class_name ~ "." ~ method_name ~ "(" ~ (WHITESPACE | NEWLINE | INDENT)* ~ argument_list? ~ (WHITESPACE | NEWLINE | INDENT)* ~ ")" }

// Namespace function call with optional method chaining (e.g., math.sqrt(x).toString())
namespace_method_chain = { namespace_identifier ~ "." ~ identifier ~ "(" ~ (WHITESPACE | NEWLINE | INDENT)* ~ argument_list? ~ (WHITESPACE | NEWLINE | INDENT)* ~ ")" ~ method_call_segment+ }

// Namespace function call syntax for namespace.function() patterns (e.g., math.sin)
namespace_function_call = { namespace_identifier ~ "." ~ identifier ~ "(" ~ (WHITESPACE | NEWLINE | INDENT)* ~ argument_list? ~ (WHITESPACE | NEWLINE | INDENT)* ~ ")" }

// Property access and list access
property_access = { identifier ~ ("." ~ identifier)+ }
list_access = { identifier ~ ("[" ~ additive_expression ~ "]")+ }

// Primary expressions (basic terms without circular dependencies)
primary = {
    // Simple literals first - they can't partially match and fail
    number |
    boolean |
    none_literal |  // null-support - None literal in primary expressions
    string |
    matrix_literal |
    list_literal |
    pairs_literal |
    // Parenthesized expressions with method calls MUST come before plain parenthesized expressions
    // This handles cases like (a + b).toString()
    parenthesized_method_call |
    // Parenthesized expressions - flexible indentation for multiline expressions
    "(" ~ parenthesized_expr ~ ")" |
    // Complex patterns that might partially match - put after literals
    constructor_call |
    // base_call must come AFTER base_identifier to allow "base" as variable name
    // It requires "base(", not just "base", so it's unambiguous
    base_call |
    // Namespace method chain must come before plain namespace call to match longer patterns first
    namespace_method_chain |
    // Three-level calls MUST come before namespace calls to match longer patterns first
    three_level_method_call |
    property_method_call |
    // Namespace calls must come before method calls to prevent 'math.sin()' being parsed as method on 'math' variable
    namespace_function_call |
    // Multiple method calls MUST come before single method calls for proper chaining
    multiple_method_call |
    chained_method_call |
    method_call |
    function_call |
    static_method_call |
    start_expr |
    list_access |
    property_access |
    error_variable |
    // "base" can be both a keyword (for base() calls) and a variable/parameter name
    // Check it explicitly before general identifier to allow it as a variable
    base_identifier |
    identifier
}

// Special rule to allow "base" as a variable/parameter name
// This comes before identifier to match "base" when not followed by "("
base_identifier = @{ "base" ~ !("(" | ASCII_ALPHANUMERIC | "_") }

// Base constructor call
base_call = { "base" ~ "(" ~ (WHITESPACE | NEWLINE | INDENT)* ~ argument_list? ~ (WHITESPACE | NEWLINE | INDENT)* ~ ")" }

// Constructor call (object instantiation)
constructor_call = { class_name ~ "(" ~ (WHITESPACE | NEWLINE | INDENT)* ~ argument_list? ~ (WHITESPACE | NEWLINE | INDENT)* ~ ")" }

// Class name for constructor calls (capitalized identifier)
class_name = { ('A'..'Z') ~ (ASCII_ALPHANUMERIC | "_")* }

// Error variable (only valid in error contexts)
error_variable = { "error" ~ !(ASCII_ALPHANUMERIC | "_") }

// Conditional expressions: if condition then value else value
conditional_expr = { "if" ~ comparison_expression ~ "then" ~ additive_expression ~ "else" ~ additive_expression }

// Parenthesized expressions now support optional newlines and indentation within

// Error handling with onError
on_error_expr = { base_expression ~ "onError" ~ base_expression }
on_error_block = { base_expression ~ "onError" ~ ":" ~ indented_block }
standalone_on_error = { "onError" ~ ":" ~ indented_block }

// Expression with proper operator precedence (logical < comparison < arithmetic < unary)
// Now supports optional whitespace (spaces, newlines, and indentation) around operators for multi-line expressions
logical_expression = { comparison_expression ~ (whitespace_around_op ~ logical_op ~ whitespace_around_op ~ comparison_expression)* }
comparison_expression = { unary_expression ~ (whitespace_around_op ~ comparison_op ~ whitespace_around_op ~ unary_expression)* }
unary_expression = { (unary_op ~ WHITESPACE*)* ~ additive_expression }

// Arithmetic expressions with proper precedence: power > multiplicative > additive
additive_expression = { multiplicative_expression ~ (whitespace_around_op ~ additive_op ~ whitespace_around_op ~ multiplicative_expression)* }
multiplicative_expression = { power_expression ~ (whitespace_around_op ~ multiplicative_op ~ whitespace_around_op ~ power_expression)* }
power_expression = { primary ~ (whitespace_around_op ~ power_op ~ whitespace_around_op ~ primary)* }

// Whitespace handling for operators - supports spaces only within single line expressions
// Removed NEWLINE and INDENT to prevent consuming next statement's indentation
whitespace_around_op = _{ " "* }

// Multiline expression rules for use within parentheses
multiline_whitespace_around_op = _{ (WHITESPACE | NEWLINE | INDENT)* }
multiline_default_expression = { multiline_logical_expression }
multiline_logical_expression = { multiline_comparison_expression ~ (multiline_whitespace_around_op ~ logical_op ~ multiline_whitespace_around_op ~ multiline_comparison_expression)* }
multiline_comparison_expression = { multiline_unary_expression ~ (multiline_whitespace_around_op ~ comparison_op ~ multiline_whitespace_around_op ~ multiline_unary_expression)* }
multiline_unary_expression = { (unary_op ~ (WHITESPACE | NEWLINE | INDENT)*)* ~ multiline_additive_expression }
multiline_additive_expression = { multiline_multiplicative_expression ~ (multiline_whitespace_around_op ~ additive_op ~ multiline_whitespace_around_op ~ multiline_multiplicative_expression)* }
multiline_multiplicative_expression = { multiline_power_expression ~ (multiline_whitespace_around_op ~ multiplicative_op ~ multiline_whitespace_around_op ~ multiline_power_expression)* }
multiline_power_expression = { multiline_primary ~ (multiline_whitespace_around_op ~ power_op ~ multiline_whitespace_around_op ~ multiline_primary)* }
multiline_primary = { primary }

// Legacy arithmetic_expression for backward compatibility
arithmetic_expression = { additive_expression }
base_expression = { conditional_expr | logical_expression }
expression = { on_error_block | on_error_expr | base_expression }

// Parenthesized expression - uses multiline expressions to support comparisons and logical ops
// Fixed: Support multiline expressions within parentheses with flexible indentation
parenthesized_expr = { (WHITESPACE | NEWLINE | INDENT)* ~ multiline_default_expression ~ (WHITESPACE | NEWLINE | INDENT)* }

// Operators with proper precedence levels
// For keyword operators, use word boundaries to prevent matching inside identifiers
// e.g., "notEmpty" should parse as identifier, not "not" + "Empty"
logical_op_and = @{ "and" ~ !(ASCII_ALPHANUMERIC | "_") }
logical_op_or = @{ "or" ~ !(ASCII_ALPHANUMERIC | "_") }
logical_op = { logical_op_and | logical_op_or }

comparison_op_is = @{ "is" ~ !(ASCII_ALPHANUMERIC | "_") }
comparison_op = { "==" | "!=" | "<=" | ">=" | "<" | ">" | comparison_op_is }
unary_op_not = @{ "not" ~ !(ASCII_ALPHANUMERIC | "_") }
unary_op = { unary_op_not | "-" }
additive_op = { "+" | "-" }
multiplicative_op = { "*" | "/" | "%" }
power_op = { "^" }
// Legacy arithmetic_op for backward compatibility
arithmetic_op = { additive_op | multiplicative_op | power_op }

// Lists, Matrices, and Pairs
list_literal = { "[" ~ (list_element ~ ("," ~ " "* ~ list_element)*)? ~ "]" }

// List element - simpler than full expression to avoid hierarchy issues
list_element = { pairs_literal | number | boolean | string | identifier | "(" ~ single_line_expression ~ ")" }
matrix_row = { "[" ~ (single_line_expression ~ ("," ~ single_line_expression)*)? ~ "]" }
matrix_literal = { "[" ~ matrix_row ~ ("," ~ matrix_row)* ~ "]" }

// Pairs literal - key-value syntax
pairs_literal = { "{" ~ (pair_element ~ ("," ~ " "* ~ pair_element)*)? ~ "}" }
pair_element = { (string | identifier | decimal_integer) ~ " "* ~ ":" ~ " "* ~ single_line_expression }

// Single-line expressions for variable declarations (no newlines/indentation)
single_line_expression = { single_line_default_expression }
single_line_default_expression = { single_line_logical_expression }
single_line_logical_expression = { single_line_comparison_expression ~ (" "* ~ logical_op ~ " "* ~ single_line_comparison_expression)* }
single_line_comparison_expression = { single_line_unary_expression ~ (" "* ~ comparison_op ~ " "* ~ single_line_unary_expression)* }
single_line_unary_expression = { (unary_op ~ " "*)* ~ single_line_additive_expression }
single_line_additive_expression = { single_line_multiplicative_expression ~ (" "* ~ additive_op ~ " "* ~ single_line_multiplicative_expression)* }
single_line_multiplicative_expression = { single_line_power_expression ~ (" "* ~ multiplicative_op ~ " "* ~ single_line_power_expression)* }
single_line_power_expression = { single_line_primary ~ (" "* ~ power_op ~ " "* ~ single_line_primary)* }

// Single-line primary expression (no newlines/indentation)
single_line_primary = {
    number |
    boolean |
    none_literal |  // null-support - None literal in single-line expressions
    string |
    matrix_literal |
    list_literal |
    pairs_literal |
    constructor_call |
    base_call |
    // Namespace calls must come before method calls to prevent 'math.sin()' being parsed as method on 'math' variable
    namespace_function_call |
    // Multiple method calls MUST come before single method calls for proper chaining
    three_level_method_call |
    property_method_call |
    multiple_method_call |
    chained_method_call |
    method_call |
    static_method_call |
    function_call |
    list_access |
    property_access |
    "(" ~ single_line_expression ~ ")" |
    error_variable |
    identifier
}

// Type-first variable declarations (no let keyword)
// More explicit matching to prevent ambiguity with expressions
// Made atomic to prevent backtracking and incorrect splitting
variable_decl_with_assignment = { variable_type ~ variable_name ~ "=" ~ expression }
variable_decl_without_assignment = { !("print") ~ variable_type ~ variable_name ~ !("(" | WHITESPACE* ~ "(") }
variable_type = { matrix_type | list_type | pairs_type | sized_type | core_type | identifier }
variable_name = @{ identifier }
variable_decl = { variable_decl_with_assignment | variable_decl_without_assignment }

// Print statements (both parenthesized and bare forms)
print_parenthesized_stmt = { "print" ~ "(" ~ (WHITESPACE | NEWLINE | INDENT)* ~ argument_list ~ (WHITESPACE | NEWLINE | INDENT)* ~ ")" }
print_newline_stmt = { "print" ~ "(" ~ (WHITESPACE | NEWLINE | INDENT)* ~ argument_list ~ (WHITESPACE | NEWLINE | INDENT)* ~ ")" ~ WHITESPACE* ~ "+" }
print_bare_stmt = { "print" ~ !(ASCII_ALPHANUMERIC | "_" | ":") ~ WHITESPACE* ~ single_line_expression }
// Note: bare print using same pattern as return statement

// Assignment
assignment = { assignment_target ~ WHITESPACE* ~ "=" ~ WHITESPACE* ~ expression }
assignment_target = {
    identifier ~ (("[" ~ additive_expression ~ "]") | ("." ~ identifier)+)?
}

// Error statement (function call syntax)
error_stmt = { "error" ~ "(" ~ expression ~ ")" }


// Control flow with indentation
if_stmt = { "if" ~ WHITESPACE* ~ expression ~ indented_block ~ else_block? }
else_block = { NEWLINE ~ (empty_line)* ~ INDENT* ~ "else" ~ (WHITESPACE* ~ "if" ~ WHITESPACE* ~ expression ~ indented_block ~ else_block? | indented_block) }

// Iteration
iterate_stmt = { "iterate" ~ WHITESPACE* ~ identifier ~ WHITESPACE* ~ "in" ~ WHITESPACE* ~ expression ~ indented_block }
range_iterate_stmt = { "iterate" ~ WHITESPACE* ~ identifier ~ WHITESPACE* ~ "in" ~ WHITESPACE* ~ expression ~ WHITESPACE* ~ "to" ~ WHITESPACE* ~ expression ~ (WHITESPACE* ~ "step" ~ WHITESPACE* ~ expression)? ~ indented_block }

// While loop
while_stmt = { "while" ~ WHITESPACE* ~ expression ~ indented_block }

// Test
test = { "test" ~ string ~ indented_block }

// Return
return_stmt = { "return" ~ (WHITESPACE* ~ expression)? }

// Break and Continue for loops
break_stmt = { "break" }
continue_stmt = { "continue" }

// Function declarations - All functions must be in functions: blocks per specification

// Parameter definitions for function declarations
parameter_list = { parameter ~ ("," ~ " "* ~ parameter)* }
parameter_name = @{ !critical_keyword ~ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* | "base" }
critical_keyword = { ("return" | "if" | "else" | "then" | "iterate" | "in" | "to" | "step" | "tests" | "error" | "function" | "functions" | "input" | "description" | "class" | "constructor" | "is" | "and" | "or" | "not" | "true" | "false" | "onError" | "constant" | "private" | "void" | "any" | "import" | "from" | "as" | "later" | "background" | "start" | "break" | "continue" | "while" | "spec" | "intent" | "source") ~ !(ASCII_ALPHANUMERIC | "_") }
parameter = { parameter_type? ~ " "* ~ parameter_name ~ (" "* ~ "=" ~ " "* ~ logical_expression)? }
parameter_type = {
    matrix_type |
    list_type |
    pairs_type |
    sized_type |
    core_type |
    identifier
}

// Functions block (the main supported syntax for function declarations)  
functions_block = { "functions" ~ ":" ~ indented_functions_block }
class_functions_block = { "functions" ~ ":" ~ class_indented_functions_block }
indented_functions_block = {
    NEWLINE ~
    (empty_line)* ~
    function_declaration_line ~
    ((NEWLINE ~ (empty_line)*) ~ function_declaration_line)*
}

// Function declaration line - uses lookahead to distinguish from function body statements
// Simplified to not handle empty lines internally (handled by parent rule)
function_declaration_line = {
    INDENT+ ~ &(function_signature) ~ function_in_block
}

// Function signature lookahead to distinguish function declarations from statements
// Uses function_return_type to avoid identifier ambiguity
function_signature = {
    class_name ~ " "+ ~ function_name ~ " "* ~ "(" |
    function_return_type ~ " "* ~ function_name ~ " "* ~ "(" |
    "void" ~ " "* ~ function_name ~ " "* ~ "(" |
    function_name ~ " "* ~ "("
}

class_indented_functions_block = { 
    NEWLINE ~ 
    (class_function_line | empty_line)*
}

class_function_line = {
    INDENT+ ~ function_in_block
}

// Legacy function_line rule - maintained for backward compatibility
function_line = {
    INDENT+ ~ function_in_block
}



// Function header (declaration without body) inside functions block
function_header = { function_type? ~ " "* ~ function_name ~ " "* ~ "(" ~ parameter_list? ~ ")" ~ " "* }

// Function return type - like function_type but WITHOUT plain identifier and class_name to avoid ambiguity
// class_name is handled separately in function_in_block
function_return_type = {
    matrix_type |
    list_type |
    pairs_type |
    generic_type |
    sized_type |
    core_type
}

// Function declaration inside functions block - Clean Language spec compliant
// Ordered choice: try class return type first (uppercase), then other types, then no return type
function_in_block = {
    (class_name ~ " "+ ~ function_name ~ " "* ~ "(" ~ parameter_list? ~ ")" ~ " "* ~ function_body_in_block) |
    ((function_return_type | "void") ~ " "* ~ function_name ~ " "* ~ "(" ~ parameter_list? ~ ")" ~ " "* ~ function_body_in_block) |
    (function_name ~ " "* ~ "(" ~ parameter_list? ~ ")" ~ " "* ~ function_body_in_block)
}

// Function name - allows identifiers (but not class names which start with uppercase) and certain contextual keywords
// Class names start with uppercase, function names start with lowercase or are keywords
function_name = { lowercase_identifier | "start" | "stop" | "toString" | "input" | "error" | "test" | "from" | "to" | "step" }
lowercase_identifier = @{ !keyword ~ ('a'..'z' | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

// Function body can have setup blocks (description and input) or just statements
// Also supports single-line function bodies and empty functions
function_body = {
    (NEWLINE ~ function_body_statements ~ EOI) |
    (NEWLINE ~ INDENT+ ~ setup_block ~ (NEWLINE)? ~ function_body_statements ~ EOI) |
    (NEWLINE ~ INDENT+ ~ setup_block ~ EOI) |
    (NEWLINE ~ EOI) // Allow empty function body with newline
}

// Function body for functions inside blocks (no EOI required)
// Allow multiple empty lines after function declaration for flexible formatting
function_body_in_block = {
    (NEWLINE ~ (empty_line)* ~ function_body_statements) |
    (NEWLINE ~ (empty_line)* ~ INDENT+ ~ setup_block ~ (NEWLINE)? ~ function_body_statements) |
    (NEWLINE ~ (empty_line)* ~ INDENT+ ~ setup_block) |
    (NEWLINE ~ (empty_line)*) // Allow empty function body with newline and empty lines
}

// Function body statements - simplified to not consume trailing empty lines
// This prevents conflicts with the parent functions block rule
// Fixed: Handle empty lines after print_newline_stmt properly
function_body_statements = {
    function_body_statement ~ (NEWLINE+ ~ (empty_line)* ~ &(INDENT+ ~ !function_signature) ~ function_body_statement)*
}

// Function body statements must be indented relative to the function declaration
function_body_statement = { INDENT+ ~ statement }

// Helper rule to detect the start of a new function
function_declaration_start = { INDENT ~ (function_type | "void") ~ " " }

// Helper rule to detect the start of a new function in functions: blocks
// Matches either: 1) function with return type, 2) void function
// Uses lookahead to match function signature without consuming parameters
function_start = { &function_signature }

// Function return type (includes identifiers for custom class types)
// Order matters: sized types before core types to prioritize precision modifiers  
function_type = { 
    matrix_type |
    list_type |
    pairs_type |
    generic_type |
    sized_type |
    core_type |
    identifier
}

// Private blocks (removed duplicate - defined later in async/import section)

// Tests block
tests_block = { "tests" ~ ":" ~ indented_tests_block }
indented_tests_block = { NEWLINE ~ (empty_line)* ~ INDENT+ ~ test_case ~ (NEWLINE ~ (empty_line)* ~ INDENT+ ~ test_case)* }
test_case = { named_test | anonymous_test }
named_test = { string ~ ":" ~ expression ~ "=" ~ expression }
anonymous_test = { expression ~ "=" ~ expression }

// ============================================================================
// STATE MANAGEMENT
// State is a first-class language concept with persistent memory, observability,
// and explicit scoping (app-level vs screen-level)
// ============================================================================

// State block - declares persistent state variables
// Top-level state: = app scope, state: inside screen: = screen scope
state_block = { "state" ~ ":" ~ indented_state_declarations ~ rules_block? }
indented_state_declarations = {
    NEWLINE ~ (empty_line)* ~
    INDENT+ ~ state_declaration ~
    (NEWLINE ~ (empty_line)* ~ INDENT+ ~ (state_declaration | computed_block))*
}

// Rules block - declares state invariants that must always be true
// Must appear after all state declarations, inside state: block
// Requires build: block to configure when rules are checked
rules_block = {
    NEWLINE ~ (empty_line)* ~
    INDENT ~ "rules" ~ ":" ~
    (NEWLINE ~ (empty_line)* ~ INDENT ~ INDENT ~ expression)+
}

// State declaration with optional guard clause
// Example: integer count = 0
// Example with guard: integer count = 0
//                         guard value >= 0 else "Cannot be negative"
state_declaration = {
    type_ ~ WHITESPACE* ~ identifier ~ WHITESPACE* ~ "=" ~ WHITESPACE* ~ single_line_expression ~
    guard_clause?
}

// Guard clause - validates state before mutation
// Example: guard value >= 0 else "Count cannot be negative"
guard_clause = {
    NEWLINE ~ (empty_line)* ~ INDENT+ ~ INDENT+ ~
    "guard" ~ WHITESPACE+ ~ expression ~ WHITESPACE+ ~ "else" ~ WHITESPACE+ ~ string
}

// Computed block - derived state that auto-updates when dependencies change
// Must be inside state: block
computed_block = { "computed" ~ ":" ~ indented_computed_declarations }
indented_computed_declarations = {
    NEWLINE ~ (empty_line)* ~
    INDENT+ ~ computed_declaration ~
    (NEWLINE ~ (empty_line)* ~ INDENT+ ~ computed_declaration)*
}

// Computed declaration - type, name, and expression body
// Example: string fullName
//              return firstName + " " + lastName
computed_declaration = {
    type_ ~ WHITESPACE* ~ identifier ~
    computed_body
}
computed_body = {
    NEWLINE ~ (empty_line)* ~
    INDENT+ ~ statement ~
    (NEWLINE ~ (empty_line)* ~ INDENT+ ~ statement)*
}

// Watch block - react to state changes
// Example: watch count:
//              print("Count changed")
// Example: watch (count, username):
//              print("State changed")
watch_block = { "watch" ~ WHITESPACE* ~ watch_targets ~ ":" ~ indented_block }
watch_targets = {
    "(" ~ WHITESPACE* ~ identifier ~ (WHITESPACE* ~ "," ~ WHITESPACE* ~ identifier)* ~ WHITESPACE* ~ ")" |
    identifier
}

// Reset statement - reset state to initial value
// Example: reset count
// Example: reset state
reset_stmt = { "reset" ~ WHITESPACE+ ~ (("state" ~ !(ASCII_ALPHANUMERIC | "_")) | identifier) }

// Screen block - defines a UI screen with its own state scope
// Example: screen Home:
//              state:
//                  integer count = 0
//              functions:
//                  void increment()
//                      count = count + 1
screen_block = { "screen" ~ WHITESPACE+ ~ identifier ~ ":" ~ indented_screen_body }
indented_screen_body = {
    NEWLINE ~ (empty_line)* ~
    screen_body_item ~
    (NEWLINE ~ (empty_line)* ~ screen_body_item)*
}
screen_body_item = {
    INDENT+ ~ (state_block | watch_block | functions_block | class_functions_block)
}

// ============================================================================
// END STATE MANAGEMENT
// ============================================================================

// Class definition with "is" inheritance
class_field = { type_ ~ WHITESPACE* ~ identifier ~ ("=" ~ expression)? }
class_body_item = { class_functions_block | constructor | class_field }
indented_class_body = { NEWLINE ~ (empty_line)* ~ INDENT+ ~ class_body_item ~ (NEWLINE ~ (empty_line)* ~ INDENT+ ~ !end_of_class ~ class_body_item)* ~ (NEWLINE ~ (empty_line)*)? }

// Helper to detect end of class context
end_of_class = { "class" | "start:" | EOI }

class_decl = {
    "class" ~ WHITESPACE* ~ identifier ~
    (WHITESPACE* ~ "is" ~ WHITESPACE* ~ type_)? ~
    indented_class_body?
}

constructor = { "constructor" ~ "(" ~ constructor_parameter_list? ~ ")" ~ constructor_block? }
constructor_block = { NEWLINE ~ (empty_line)* ~ INDENT ~ INDENT+ ~ statement ~ (NEWLINE ~ (empty_line)* ~ INDENT ~ INDENT+ ~ statement)* }
constructor_parameter_list = { constructor_parameter ~ ("," ~ " "* ~ constructor_parameter)* }
constructor_parameter = { type_? ~ WHITESPACE* ~ parameter_name }

// Import statements - supports both specification and simple syntax
// import Math                    # simple module import
// import: Math                   # whole module (specification)
// import: Math.sqrt              # single symbol
// import: Utils as U             # module alias
// import: Json.decode as jd      # symbol alias
// import "path/to/file.cln"      # file path import (relative to current file)

// Module name allows keywords in import context (math, string, list, etc.)
module_name = @{ (ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")*) | ("string" | "integer" | "number" | "boolean" | "list" | "matrix" | "void" | "any") }

// File path import - import "path/to/file.cln"
file_path_import = { "\"" ~ file_path_inner ~ "\"" }
file_path_inner = @{ (!("\"") ~ ANY)* }

import_item = {
    file_path_import |                                       // "app/data/models.cln"
    (module_name ~ "." ~ module_name ~ "as" ~ module_name) |  // Math.sqrt as msqrt
    (module_name ~ "." ~ module_name) |                      // Math.sqrt
    (module_name ~ "as" ~ module_name) |                     // Utils as U
    module_name                                              // Math
}
import_list = { NEWLINE ~ (empty_line)* ~ INDENT+ ~ import_item ~ (NEWLINE ~ (empty_line)* ~ INDENT+ ~ import_item)* }
import_stmt = { ("import" ~ file_path_import) | ("import" ~ identifier) | ("import" ~ ":" ~ import_item) }

// Async expressions and statements
start_expr = { "start" ~ WHITESPACE* ~ expression }
background_stmt = { "background" ~ WHITESPACE* ~ expression }
later_assignment = { "later" ~ WHITESPACE* ~ identifier ~ WHITESPACE* ~ "=" ~ WHITESPACE* ~ expression }

// Import and export blocks (consolidate with import_stmt)
import_block = { "import" ~ ":" ~ import_list }
private_block = { "private" ~ ":" ~ indented_private_list }
indented_private_list = { NEWLINE ~ (empty_line)* ~ INDENT+ ~ private_item ~ (NEWLINE ~ (empty_line)* ~ INDENT+ ~ private_item)* }
private_item = { identifier | function_in_block }

// External function block - declares functions provided by the WASM host
// Syntax: external: (for "env" module) or external "module_name": (for custom module)
external_block = { "external" ~ (WHITESPACE+ ~ string)? ~ ":" ~ indented_external_functions }

indented_external_functions = {
    NEWLINE ~ (empty_line)* ~
    INDENT+ ~ external_function_declaration ~
    (NEWLINE ~ (empty_line)* ~ INDENT+ ~ external_function_declaration)*
}

// External function declaration: return_type function_name(params)
external_function_declaration = {
    external_return_type ~ WHITESPACE+ ~ function_name ~ WHITESPACE* ~ "(" ~ parameter_list? ~ ")"
}

// External function return type - same as function types but includes void
external_return_type = {
    "void" |
    matrix_type |
    list_type |
    pairs_type |
    generic_type |
    sized_type |
    core_type |
    identifier
}

// Require statement - declares a precondition that must be true
// Can only appear inside functions or class methods
// Always checked at runtime (cannot be disabled)
require_stmt = { "require" ~ WHITESPACE+ ~ expression }

// Update statements to include async features, imports, and state management
// Critical fix: Add function_call before expression to prevent parameter parsing confusion
// Method calls must come before assignment to avoid grammar ambiguity with property_access
statement = {
    (require_stmt |
    print_newline_stmt |
    print_parenthesized_stmt |
    print_bare_stmt |
    framework_block |
    apply_block |
    standalone_on_error |
    on_error_block |
    reset_stmt |
    function_call |
    method_call |
    assignment |
    return_stmt |
    break_stmt |
    continue_stmt |
    error_stmt |
    if_stmt |
    while_stmt |
    iterate_stmt |
    range_iterate_stmt |
    test |
    background_stmt |
    later_assignment |
    standalone_input_declaration |
    base_call |
    start_expr |
    variable_decl)
}

// Program with proper newline handling
// State management blocks: state_block (app-level), watch_block (top-level observers), screen_block (UI screens)
// External blocks: external_block for WASM host-provided functions
program_item = { import_block | import_stmt | private_block | external_block | state_block | watch_block | screen_block | framework_block | start_block | functions_block | tests_block | class_decl | apply_block }
program = { SOI ~ (empty_line)* ~ (program_item ~ (empty_line)*)* ~ EOI }

// Start block - the entry point of a Clean Language program
// Uses block syntax (start:) instead of function syntax (start())
start_block = { "start" ~ ":" ~ simple_indented_block } 