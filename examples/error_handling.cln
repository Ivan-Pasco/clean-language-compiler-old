// Error Handling Example in Clean Language

start:
	print("Starting error handling example")

	// Division with error fallback
	number divisor = 0
	number result = 10 / divisor onError -1

	print(result)

	// Function call with error handling
	string data = loadData() onError "no data"
	print(data)

	print("Error handling example completed")

functions:
	string loadData()
		error("404")
