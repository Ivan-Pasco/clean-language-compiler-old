{
  "projects": {
    "clean-language-compiler": {
      "path": ".",
      "language": "rust",
      "context": "compiler-development",
      "modes": ["desktop-app", "code-analysis"],
      "tools": {
        "enabled": [
          "find_symbol",
          "get_symbols_overview", 
          "find_referencing_symbols",
          "search_for_pattern",
          "replace_symbol_body",
          "insert_after_symbol",
          "insert_before_symbol",
          "read_file",
          "create_text_file",
          "execute_shell_command",
          "list_dir",
          "find_file"
        ],
        "optional": [
          "delete_lines",
          "replace_lines",
          "insert_at_line",
          "restart_language_server"
        ]
      },
      "memory": {
        "project_structure": "Clean Language compiler written in Rust with modules for lexer, parser, semantic analysis, IR, codegen, and WASM target",
        "key_components": [
          "src/lexer/ - Tokenization and lexical analysis",
          "src/parser/ - AST construction and parsing",
          "src/semantic/ - Type checking and semantic validation", 
          "src/ir/ - Intermediate representation",
          "src/codegen/ - Code generation",
          "src/targets/ - Target-specific code generation (WASM)",
          "src/stdlib/ - Standard library implementations",
          "src/runtime/ - Runtime support for Clean Language features"
        ],
        "testing_strategy": "Comprehensive test suite with unit tests, integration tests, and property-based tests in qa/ directory",
        "build_system": "Cargo-based build with custom Makefile for testing workflows"
      }
    }
  },
  "contexts": {
    "compiler-development": {
      "description": "Context for developing and debugging the Clean Language compiler",
      "focus_areas": [
        "Parser correctness and error handling",
        "Semantic analysis and type checking",
        "Code generation and optimization",
        "WASM target compatibility",
        "Test coverage and validation"
      ],
      "common_tasks": [
        "Debug parsing errors in Clean Language files",
        "Fix semantic analysis issues",
        "Optimize code generation",
        "Add new language features",
        "Improve error messages and diagnostics"
      ]
    }
  },
  "modes": {
    "desktop-app": {
      "description": "Desktop application development mode with shell access",
      "enabled_tools": ["execute_shell_command"]
    },
    "code-analysis": {
      "description": "Deep code analysis and understanding mode",
      "enabled_tools": [
        "find_symbol",
        "get_symbols_overview",
        "find_referencing_symbols",
        "search_for_pattern"
      ]
    }
  }
}
