// Test conditional expressions and comparisons

functions:

	void testIntegerConditionals()

		print "=== Testing Integer Conditionals ===" ln
		integer a = 10
		integer b = 5
		
		// Test basic conditional using standard operators
		boolean comparison = a > b
		integer result = if comparison then a else b
		print "Max of 10 and 5: " + result.toString( ln)
		
		// Test with equality
		boolean isEqual = a == a
		integer equal = if isEqual then 100 else 200
		print "Equal test (should be 100 ln: " + equal.toString())
		
		// Test less than
		boolean isLess = b < a
		integer min = if isLess then b else a
		print "Min of 10 and 5: " + min.toString( ln)

	void testNumberConditionals()

		print "=== Testing Number Conditionals ===" ln
		number x = 3.14
		number y = 2.71
		
		// Test number conditional using standard operators
		boolean numComparison = x > y
		number maxNum = if numComparison then x else y
		print "Max of 3.14 and 2.71: " + maxNum.toString( ln)
		
		// Test number equality
		boolean numEqual = x == x
		number equalNum = if numEqual then 100.0 else 200.0
		print "Equal test (should be 100.0 ln: " + equalNum.toString())

	void testLogicalOperations()

		print "=== Testing Logical Operations ===" ln
		integer a = 10
		integer b = 5
		integer c = 15
		
		// Test logical AND using standard operators
		boolean greater = a > b
		boolean less = a < c
		boolean andResult = greater and less
		print "10 > 5 AND 10 < 15: " + andResult.toString( ln)
		
		// Test logical OR
		boolean equal = a == b
		boolean greaterOr = a > b
		boolean orResult = equal or greaterOr
		print "10 == 5 OR 10 > 5: " + orResult.toString( ln)
		
		// Test logical NOT using != operator
		boolean equalNot = a == b
		boolean notResult = not equalNot
		print "NOT (10 == 5 ln: " + notResult.toString())

	void testComplexConditionals()

		print "=== Testing Complex Conditionals ===" ln
		integer score = 85
		
		// Test nested conditionals for grade assignment using standard operators
		boolean gradeA = score >= 90
		boolean gradeB = score >= 80
		boolean gradeC = score >= 70
		
		string grade = if gradeA then "A" else if gradeB then "B" else if gradeC then "C" else "F"
		print "Score " + score.toString( ln + " gets grade: " + grade)

start()

	print "Clean Language Conditional Expressions Test" ln
	print "==========================================" ln
	testIntegerConditionals()
	print "" ln
	testNumberConditionals()
	print "" ln
	testLogicalOperations()
	print "" ln
	testComplexConditionals()
	print "" ln
	print "All conditional tests completed!" ln