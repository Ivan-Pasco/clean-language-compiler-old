// Test list behavior modifiers - FIFO, LIFO, and unique elements

functions:
	void testQueueBehavior()
		print "=== Testing Queue (FIFO ln Behavior ===")
		list<string> taskQueue
		taskQueue.type = "line"
		
		taskQueue.add("Task 1")
		taskQueue.add("Task 2")
		taskQueue.add("Task 3")
		
		print "Queue size: " + taskQueue.size( ln.toString())
		
		string first = list.remove(taskQueue, 0)  // Queue removes from front (FIFO)
		print "Removed: " + first ln
		
		string second = list.remove(taskQueue, 0)  // Next item moves to front
		print "Removed: " + second ln
		
		string next = taskQueue.peek()
		print "Next (peek ln: " + next)
		print "Queue size after peek: " + taskQueue.size( ln.toString())
	
	void testStackBehavior()
		print "=== Testing Stack (LIFO ln Behavior ===")
		list<string> undoStack
		undoStack.type = "pile"
		
		undoStack.add("Operation 1")
		undoStack.add("Operation 2")
		undoStack.add("Operation 3")
		
		print "Stack size: " + undoStack.size( ln.toString())
		
		integer lastIndex = undoStack.size() - 1
		string last = list.remove(undoStack, lastIndex)  // Stack removes from end (LIFO)
		print "Undone: " + last ln
		
		integer newLastIndex = undoStack.size() - 1
		string secondLast = list.remove(undoStack, newLastIndex)
		print "Undone: " + secondLast ln
		
		string top = undoStack.peek()
		print "Top (peek ln: " + top)
	
	void testUniqueBehavior()
		print "=== Testing Unique (Set ln Behavior ===")
		list<integer> uniqueNumbers
		uniqueNumbers.type = "unique"
		
		uniqueNumbers.add(5)
		uniqueNumbers.add(10)
		uniqueNumbers.add(5)
		uniqueNumbers.add(15)
		uniqueNumbers.add(10)
		
		print "Unique numbers count: " + uniqueNumbers.size( ln.toString())
		
		boolean hasFive = uniqueNumbers.contains(5)
		boolean hasTen = uniqueNumbers.contains(10)
		boolean hasTwenty = uniqueNumbers.contains(20)
		
		print "Contains 5: " + hasFive.toString( ln)
		print "Contains 10: " + hasTen.toString( ln)
		print "Contains 20: " + hasTwenty.toString( ln)
	
	void testCombinedBehaviors()
		print "=== Testing Combined Behaviors ===" ln
		
		list<string> uniqueQueue
		uniqueQueue.type = "line-unique"
		
		uniqueQueue.add("First")
		uniqueQueue.add("Second")
		uniqueQueue.add("First")
		uniqueQueue.add("Third")
		
		print "Unique queue size: " + uniqueQueue.size( ln.toString())
		string removed = list.remove(uniqueQueue, 0)  // Queue behavior, remove from front
		print "Removed from unique queue: " + removed ln
	
	void testUtilityMethods()
		print "=== Testing Utility Methods ===" ln
		list<integer> numbers
		
		boolean empty = numbers.isEmpty()
		print "Empty list isEmpty: " + empty.toString( ln)
		
		numbers.add(42)
		boolean notEmpty = numbers.isNotEmpty()
		print "Non-empty list isNotEmpty: " + notEmpty.toString( ln)
		
		numbers.type = "pile"
		string behavior = numbers.type
		print "Current behavior: " + behavior ln


start()
	print "Clean Language List Behavior Test" ln
	print "==================================" ln
	testQueueBehavior()
	print "" ln
	testStackBehavior()
	print "" ln
	testUniqueBehavior()
	print "" ln
	testCombinedBehaviors()
	print "" ln
	testUtilityMethods()
	print "" ln
	print "All list behavior tests completed!" ln