// Test method-style syntax - Clean Language Specification compliance

functions:

	void testStringMethods()
		print "=== Testing String Method-Style Syntax ===" ln
		string text = "Hello World"
		integer textLength = text.length()
		print "Text length: " + textLength.toString( ln)
		
		// Test string operations with method-style syntax
		string upperText = text.toUpperCase()
		print "Uppercase: " + upperText ln
		
		string lowerText = text.toLowerCase()
		print "Lowercase: " + lowerText ln

	void testNumberMethods()
		print "=== Testing Number Method-Style Syntax ===" ln
		integer num = 123
		string numStr = num.toString()
		print "Integer to string: " + numStr ln
		
		number decimal = 42.0
		string decimalStr = decimal.toString()
		print "Number to string: " + decimalStr ln
		
		// Test type conversions
		integer fromNumber = decimal.toInteger()
		print "Number to integer: " + fromNumber.toString( ln)
		
		number fromInteger = num.toNumber()
		print "Integer to number: " + fromInteger.toString( ln)

	void testBooleanMethods()
		print "=== Testing Boolean Method-Style Syntax ===" ln
		boolean flag = true
		string boolStr = flag.toString()
		print "Boolean to string: " + boolStr ln
		
		integer boolValue = 1
		boolean converted = boolValue.toBoolean()
		print "Integer to boolean (1 ln: " + converted.toString())
		
		integer zeroValue = 0
		boolean zeroConverted = zeroValue.toBoolean()
		print "Integer to boolean (0 ln: " + zeroConverted.toString())

start()
	print "Clean Language Method-Style Syntax Test" ln
	print "======================================" ln
	testStringMethods()
	print "" ln
	testNumberMethods()
	print "" ln
	testBooleanMethods()
	print "" ln
	print "All method-style tests completed!" ln