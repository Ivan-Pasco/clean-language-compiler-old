// Test conditional expressions and comparisons

functions:

	void testIntegerConditionals()

		print("=== Testing Integer Conditionals ===")
		integer a = 10
		integer b = 5
		
		// Test basic conditional
		integer result = conditional.integer(compare.integer.greaterThan(a, b), a, b)
		print("Max of 10 and 5: " + result.toString())
		
		// Test with equality
		integer equal = conditional.integer(compare.integer.equal(a, a), 100, 200)
		print("Equal test (should be 100): " + equal.toString())
		
		// Test less than
		integer min = conditional.integer(compare.integer.lessThan(b, a), b, a)
		print("Min of 10 and 5: " + min.toString())

	void testNumberConditionals()

		print("=== Testing Number Conditionals ===")
		number x = 3.14
		number y = 2.71
		
		// Test number conditional
		number maxNum = conditional.number(compare.number.greaterThan(x, y), x, y)
		print("Max of 3.14 and 2.71: " + maxNum.toString())
		
		// Test number equality
		number equalNum = conditional.number(compare.number.equal(x, x), 100.0, 200.0)
		print("Equal test (should be 100.0): " + equalNum.toString())

	void testLogicalOperations()

		print("=== Testing Logical Operations ===")
		integer a = 10
		integer b = 5
		integer c = 15
		
		// Test logical AND
		boolean andResult = logical.and(compare.integer.greaterThan(a, b), compare.integer.lessThan(a, c))
		print("10 > 5 AND 10 < 15: " + andResult.toString())
		
		// Test logical OR
		boolean orResult = logical.or(compare.integer.equal(a, b), compare.integer.greaterThan(a, b))
		print("10 == 5 OR 10 > 5: " + orResult.toString())
		
		// Test logical NOT
		boolean notResult = logical.not(compare.integer.equal(a, b))
		print("NOT (10 == 5): " + notResult.toString())

	void testComplexConditionals()

		print("=== Testing Complex Conditionals ===")
		integer score = 85
		
		// Test nested conditionals for grade assignment
		string grade = conditional.string(
			compare.integer.greaterEqual(score, 90),
			"A",
			conditional.string(
				compare.integer.greaterEqual(score, 80),
				"B",
				conditional.string(
					compare.integer.greaterEqual(score, 70),
					"C",
					"F"
				)
			)
		)
		print("Score " + score.toString() + " gets grade: " + grade)

start()

	print("Clean Language Conditional Expressions Test")
	print("==========================================")
	testIntegerConditionals()
	print("")
	testNumberConditionals()
	print("")
	testLogicalOperations()
	print("")
	testComplexConditionals()
	print("")
	print("All conditional tests completed!")