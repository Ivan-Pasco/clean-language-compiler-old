// String interpolation comprehensive test - demonstrates {variable} syntax

functions:
	testBasicInterpolation()
		print("=== Basic String Interpolation ===")
		string name = "World"
		integer count = 42
		number price = 19.99
		boolean isActive = true
		
		// Basic variable interpolation (using concatenation until {variable} syntax is implemented)
		string greeting = "Hello, " + name + "!"
		print(greeting)  // Should output: Hello, World!
		
		// Integer interpolation
		string countMessage = "Count is " + count.toString()
		print(countMessage)  // Should output: Count is 42
		
		// Number interpolation
		string priceMessage = "Price: $" + price.toString()
		print(priceMessage)  // Should output: Price: $19.99
		
		// Boolean interpolation
		string statusMessage = "Status: " + isActive.toString()
		print(statusMessage)  // Should output: Status: true
	
	testExpressionInterpolation()
		print("=== Expression Interpolation ===")
		integer a = 10
		integer b = 5
		number radius = 3.0
		
		// Mathematical expressions (using concatenation until {expression} syntax is implemented)
		integer sum = a + b
		string mathResult = "Sum: " + sum.toString()
		print(mathResult)  // Should output: Sum: 15
		
		integer product = a * b
		string calculation = a.toString() + " * " + b.toString() + " = " + product.toString()
		print(calculation)  // Should output: 10 * 5 = 50
		
		// Complex expressions
		number area = 3.14159 * radius * radius
		string areaCalculation = "Circle area: " + area.toString()
		print(areaCalculation)  // Should output: Circle area: 28.27431
		
		// Expression with function call
		number maximum = math.max(a.toNumber(), b.toNumber())
		string comparison = "Max of " + a.toString() + " and " + b.toString() + " is " + maximum.toString()
		print(comparison)  // Should output: Max of 10 and 5 is 10
	
	testObjectInterpolation()
		print("=== Object Property Interpolation ===")
		// Note: This requires class support for property access
		
		// For now, demonstrate the expected syntax
		string userName = "Alice"
		integer userAge = 25
		
		// Simple property-style access (using concatenation until {variable} syntax is implemented)
		string userInfo = "User " + userName + " is " + userAge.toString() + " years old"
		print(userInfo)  // Should output: User Alice is 25 years old
		
		// Multiple properties in complex string
		string fullMessage = "Hello " + userName + "! You are " + userAge.toString() + " years old. Welcome!"
		print(fullMessage)
	
	testNestedInterpolation()
		print("=== Complex Interpolation Patterns ===")
		string prefix = "Mr."
		string firstName = "John"
		string lastName = "Doe"
		integer items = 3
		number unitPrice = 12.50
		
		// Multiple variables in one string (using concatenation until {variable} syntax is implemented)
		string fullName = prefix + " " + firstName + " " + lastName
		print(fullName)  // Should output: Mr. John Doe
		
		// Calculations with multiple variables
		number totalCost = items.toNumber() * unitPrice
		string invoice = "Invoice for " + fullName + ": " + items.toString() + " items at $" + unitPrice.toString() + " each = $" + totalCost.toString()
		print(invoice)
		
		// Conditional-style interpolation (using concatenation)
		boolean isPremium = true
		string membershipStatus = "Member: " + firstName + " " + lastName + " (Premium: " + isPremium.toString() + ")"
		print(membershipStatus)
	
	testInterpolationEdgeCases()
		print("=== Edge Cases and Special Scenarios ===")
		
		// Empty variable (using concatenation until {variable} syntax is implemented)
		string emptyString = ""
		string withEmpty = "Value: '" + emptyString + "'"
		print(withEmpty)  // Should output: Value: ''
		
		// Numeric edge cases
		integer zero = 0
		integer negative = -42
		string numbers = "Zero: " + zero.toString() + ", Negative: " + negative.toString()
		print(numbers)  // Should output: Zero: 0, Negative: -42
		
		// String with special characters
		string special = "Hello\nWorld"
		string withSpecial = "Text: " + special
		print(withSpecial)
		
		// Multiple same variable (declare local variable)
		string firstName = "John"
		string repeated = firstName + " " + firstName + " " + firstName
		print(repeated)  // Should output: John John John
	
	// Helper function for demonstration
	integer multiply(integer x, integer y)
		return x * y

start()
	print("String Interpolation Comprehensive Test")
	print("=======================================")
	testBasicInterpolation()
	print("")
	testExpressionInterpolation()
	print("")
	testObjectInterpolation()
	print("")
	testNestedInterpolation()
	print("")
	testInterpolationEdgeCases()
	print("")
	print("String interpolation test completed successfully")