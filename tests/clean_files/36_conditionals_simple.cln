// Simple test of conditional functions

functions:
	void testConditionals()
		print("Testing conditional functions")
		integer a = 10
		integer b = 5
		
		boolean greater = compare.integer.greaterThan(a, b)
		print("10 > 5: " + greater.toString())
		
		integer max = conditional.integer(greater, a, b)
		print("Max of 10 and 5: " + max.toString())

start()
	print("Conditional Simple Test")
	testConditionals()
	print("Test completed")