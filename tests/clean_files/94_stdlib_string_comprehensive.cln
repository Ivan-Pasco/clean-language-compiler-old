// Standard Library String Module Comprehensive Test
// Tests all string manipulation functions as specified

functions:
	void testBasicStringOperations()
		print "=== Basic String Operations ===" ln
		
		string text = "Hello World"
		
		// Length and basic operations
		integer textLength = string.length(text)
		string concatenated = string.concat("Hello", " Clean")
		string substring = string.substring(text, 0, 5)
		
		print "Length of 'Hello World': " + textLength.toString() ln
		print "Concat 'Hello' + ' Clean': " + concatenated ln
		print "Substring (0,5) of 'Hello World': " + substring ln
		
	void testCaseOperations()
		print "=== Case Operations ===" ln
		
		string mixedCase = "Hello World"
		
		string upperCase = string.toUpperCase(mixedCase)
		string lowerCase = string.toLowerCase(mixedCase)
		
		print "Original: " + mixedCase ln
		print "Upper case: " + upperCase ln
		print "Lower case: " + lowerCase ln
		
	void testSearchOperations()
		print "=== Search and Validation Operations ===" ln
		
		string text = "Hello World Hello"
		
		boolean containsWorld = string.contains(text, "World")
		boolean containsClean = string.contains(text, "Clean")
		integer firstHelloIndex = string.indexOf(text, "Hello")
		integer lastHelloIndex = string.lastIndexOf(text, "Hello")
		boolean startsWithHello = string.startsWith(text, "Hello")
		boolean endsWithHello = string.endsWith(text, "Hello")
		boolean startsWithWorld = string.startsWith(text, "World")
		boolean endsWithWorld = string.endsWith(text, "World")
		
		print "Text: '" + text + "'" ln
		print "Contains 'World': " + containsWorld.toString() ln
		print "Contains 'Clean': " + containsClean.toString() ln
		print "First 'Hello' at index: " + firstHelloIndex.toString() ln
		print "Last 'Hello' at index: " + lastHelloIndex.toString() ln
		print "Starts with 'Hello': " + startsWithHello.toString() ln
		print "Ends with 'Hello': " + endsWithHello.toString() ln
		print "Starts with 'World': " + startsWithWorld.toString() ln
		print "Ends with 'World': " + endsWithWorld.toString() ln
		
	void testTrimOperations()
		print "=== Text Cleaning and Formatting ===" ln
		
		string messyText = "   Hello World   "
		string leadingSpaces = "   Clean Language"
		string trailingSpaces = "Programming   "
		
		string trimmed = string.trim(messyText)
		string trimmedStart = string.trimStart(leadingSpaces)
		string trimmedEnd = string.trimEnd(trailingSpaces)
		
		print "Original messy: '" + messyText + "'" ln
		print "Trimmed: '" + trimmed + "'" ln
		print "Leading spaces: '" + leadingSpaces + "'" ln
		print "Trim start: '" + trimmedStart + "'" ln
		print "Trailing spaces: '" + trailingSpaces + "'" ln
		print "Trim end: '" + trimmedEnd + "'" ln
		
	void testAdvancedManipulation()
		print "=== Advanced Text Manipulation ===" ln
		
		string original = "Hello Hello World"
		
		// Replace operations
		string replaceFirst = string.replace(original, "Hello", "Hi")
		string replaceAll = string.replaceAll(original, "Hello", "Hi")
		
		print "Original: " + original ln
		print "Replace first 'Hello': " + replaceFirst ln
		print "Replace all 'Hello': " + replaceAll ln
		
		// Split and join operations
		string csvData = "apple,banana,orange"
		list<string> fruits = string.split(csvData, ",")
		string rejoined = string.join(fruits, " | ")
		
		print "CSV data: " + csvData ln
		print "Split result count: " + fruits.length().toString() ln
		print "Rejoined with |: " + rejoined ln
		
	void testCharacterOperations()
		print "=== Character Operations ===" ln
		
		string word = "Hello"
		
		string firstChar = string.charAt(word, 0)
		string secondChar = string.charAt(word, 1)
		integer charCode = string.charCodeAt(word, 0)  // 'H' = 72
		integer charCode2 = string.charCodeAt(word, 1) // 'e' = 101
		
		print "Word: " + word ln
		print "Character at index 0: " + firstChar ln
		print "Character at index 1: " + secondChar ln
		print "Char code at index 0 (H): " + charCode.toString() ln
		print "Char code at index 1 (e): " + charCode2.toString() ln
		
	void testValidationHelpers()
		print "=== Validation Helpers ===" ln
		
		string emptyStr = ""
		string spaceStr = "   "
		string normalStr = "Hello"
		
		boolean empty1 = string.isEmpty(emptyStr)
		boolean empty2 = string.isEmpty(normalStr)
		boolean blank1 = string.isBlank(emptyStr)
		boolean blank2 = string.isBlank(spaceStr)
		boolean blank3 = string.isBlank(normalStr)
		
		print "isEmpty(''): " + empty1.toString() ln
		print "isEmpty('Hello'): " + empty2.toString() ln
		print "isBlank(''): " + blank1.toString() ln
		print "isBlank('   '): " + blank2.toString() ln
		print "isBlank('Hello'): " + blank3.toString() ln
		
	void testPaddingOperations()
		print "=== Padding Operations ===" ln
		
		string number = "42"
		string name = "Alice"
		
		string paddedStart = string.padStart(number, 5, "0")
		string paddedEnd = string.padEnd(name, 10, " ")
		
		print "Original number: '" + number + "'" ln
		print "Padded start (5, '0'): '" + paddedStart + "'" ln
		print "Original name: '" + name + "'" ln
		print "Padded end (10, ' '): '" + paddedEnd + "'" ln
		
	void testRealWorldScenarios()
		print "=== Real-World String Processing ===" ln
		
		// Email validation scenario
		string email1 = "USER@EXAMPLE.COM"
		string email2 = "user@example.com"
		string normalizedEmail1 = string.toLowerCase(email1)
		boolean emailsMatch = normalizedEmail1 == string.toLowerCase(email2)
		
		print "Email 1: " + email1 ln
		print "Email 2: " + email2 ln
		print "Normalized match: " + emailsMatch.toString() ln
		
		// File processing scenario
		string filename = "document.pdf"
		boolean isPdf = string.endsWith(filename, ".pdf")
		integer dotPosition = string.lastIndexOf(filename, ".")
		string extension = string.substring(filename, dotPosition + 1, string.length(filename))
		
		print "Filename: " + filename ln
		print "Is PDF: " + isPdf.toString() ln
		print "Extension: " + extension ln
		
		// URL processing
		string url = "https://api.example.com/users"
		boolean isHttps = string.startsWith(url, "https://")
		boolean hasApi = string.contains(url, "api")
		
		print "URL: " + url ln
		print "Is HTTPS: " + isHttps.toString() ln
		print "Contains 'api': " + hasApi.toString() ln
		
		// Text cleaning
		string userInput = "  Hello    World  "
		string cleaned = string.trim(userInput)
		string normalized = string.replaceAll(cleaned, "    ", " ")
		
		print "User input: '" + userInput + "'" ln
		print "Cleaned: '" + normalized + "'" ln

start()
	print "Standard Library String Module Test" ln
	print "===================================" ln
	testBasicStringOperations()
	print "" ln
	testCaseOperations()
	print "" ln
	testSearchOperations()
	print "" ln
	testTrimOperations()
	print "" ln
	testAdvancedManipulation()
	print "" ln
	testCharacterOperations()
	print "" ln
	testValidationHelpers()
	print "" ln
	testPaddingOperations()
	print "" ln
	testRealWorldScenarios()
	print "" ln
	print "String module comprehensive test completed" ln