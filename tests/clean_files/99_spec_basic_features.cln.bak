// Clean Language Basic Specification Features Test

functions:
	// Simple function with direct return
	string getMessage()
		return "Hello World"
	
	// Function with parameter
	string addPrefix(string text)
		return "PREFIX: " + text
	
	// Void function
	void showMessage(string msg)
		print "[MSG] " + msg ln

start()
	print "=== Clean Language Basic Specification Test ===" ln
	
	// 1. Basic types
	print "1. Basic Types:" ln
	integer num = 42
	string text = "Clean Language"
	boolean flag = true
	number decimal = 3.14
	
	print "Integer: " + num.toString( ln)
	print "String: " + text ln
	print "Boolean: " + flag.toString( ln)
	print "Number: " + decimal.toString( ln)
	
	// 2. Function calls
	print "2. Function Calls:" ln
	string greeting = getMessage()
	print "Message: " + greeting ln
	
	string prefixed = addPrefix("Test")
	print "Prefixed: " + prefixed ln
	
	showMessage("Void function call")
	
	// 3. Built-in method calls
	print "3. Built-in Methods:" ln
	string upper = text.toUpperCase()
	string lower = text.toLowerCase()
	integer len = text.length()
	
	print "Upper: " + upper ln
	print "Lower: " + lower ln
	print "Length: " + len.toString( ln)
	
	// 4. Math operations
	print "4. Math Operations:" ln
	integer a = 10
	integer b = 5
	integer sum = a + b
	integer diff = a - b
	integer prod = a * b
	
	print "10 + 5 = " + sum.toString( ln)
	print "10 - 5 = " + diff.toString( ln)
	print "10 * 5 = " + prod.toString( ln)
	
	// 5. String concatenation
	print "5. String Operations:" ln
	string part1 = "Clean"
	string part2 = "Language"
	string combined = part1 + " " + part2
	print "Combined: " + combined ln
	
	// 6. Namespace function calls
	print "6. Namespace Functions:" ln
	number absolute = math.abs(-15)
	print "math.abs(-15 ln = " + absolute.toString())
	
	print "=== Basic Specification Test Completed ===" ln