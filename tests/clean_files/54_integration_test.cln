// Comprehensive Integration Test
// Tests combinations of all new syntax patterns

import:
    math
    string
    list
    http

private:
    internalValidation
    secretKey

functions:
    // Public function using method-style and static calls
    processUserInput()
        // Get user data with input methods
        string name = input("Enter your name: ")
        integer age = input.integer("Enter your age: ")
        boolean confirmed = input.yesNo("Confirm registration? ")
        
        // Validate using basic conditions
        if string.isEmpty(name)
            return false
        if age <= 0
            return false
        if age >= 150
            return false
        
        // Process using static methods
        string cleanName = string.trim(name)
        integer validAge = age
        if validAge < 18
            validAge = 18
        if validAge > 120
            validAge = 120
        
        // Use HTTP methods for data submission
        string userData = "{\"name\": \"" + cleanName + "\", \"age\": " + validAge.toString() + "}"
        later response = start http.post("https://api.example.com/users", userData)
        
        // Background logging
        background logUserAction("User registration attempted")
        
        return confirmed and string.length(response) > 0
    
    // Function using async keywords with method chaining
    fetchAndProcessData()
        // Start multiple async operations
        later data1 = start http.get("https://api.example.com/data1")
        later data2 = start http.get("https://api.example.com/data2")
        later data3 = start http.get("https://api.example.com/data3")
        
        // Process results with method-style calls
        list<string> results = []
        
        // Wait for and validate results
        if string.isEmpty(data1)
            return []
        if string.isEmpty(data2)
            return []
        if string.isEmpty(data3)
            return []
        
        // Use static methods for processing
        string processed1 = string.toUpperCase(data1)
        string processed2 = string.toLowerCase(data2)
        string processed3 = string.trim(data3)
        
        // Build result list
        results = list.push(results, processed1)
        results = list.push(results, processed2)
        results = list.push(results, processed3)
        
        // Background cleanup
        background clearCache()
        
        return results
    
    // Private helper functions
    boolean internalValidation(string data)
        return string.length(data) > 0
    
    secretKey()
        return "secret-api-key-123"
    
    void logUserAction(string action)
        integer timestamp = 123456
        print("LOG [" + timestamp.toString() + "]: " + action)
    
    void clearCache()
        print("Cache cleared in background")

start()
    // Test complex integration scenario
    print("Starting integration test...")
    
    // Combine static methods with method-style calls
    number value = math.sqrt(144.0)
    string valueText = string.toUpperCase(value.toString())
    print("Computed value: " + valueText)
    
    // Test async with HTTP and validation
    later apiStatus = start http.get("https://api.example.com/status")
    
    // Use input methods with validation chains
    string testInput = input("Enter test data: ")
    string cleanInput = string.trim(testInput)
    if string.isEmpty(cleanInput)
        return
    
    // Test method chaining with async results
    string status = apiStatus
    boolean validStatus = string.length(status) > 0
    print("API status valid: " + validStatus.toString())
    
    // Test static method combinations
    list<integer> numbers = [5, 2, 8, 1, 9]
    integer listLength = list.length(numbers)
    integer maxValue = math.max(8.0, 9.0).toInteger()
    
    print("list length: " + listLength.toString())
    print("Max value: " + maxValue.toString())
    
    // Test background operations with method calls
    background http.post("https://api.example.com/analytics", "{\"event\": \"test_completed\"}")
    
    // Test comprehensive user processing
    boolean userProcessed = processUserInput()
    print("User processing result: " + userProcessed.toString())
    
    // Test data fetching and processing
    list<string> processedData = fetchAndProcessData()
    integer dataCount = processedData.length()
    print("Processed data items: " + dataCount.toString())
    
    // Final validation with all patterns
    string finalMessage = "Integration test completed successfully!"
    boolean messageEmpty = string.isEmpty(finalMessage)
    boolean messageValid = string.length(finalMessage) > 0
    
    print("Final message valid: " + messageValid.toString())
    print(finalMessage)