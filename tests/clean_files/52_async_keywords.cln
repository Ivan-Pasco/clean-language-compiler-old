// Simple QA Test for Async Keywords
// Tests basic async keyword syntax

functions:

	string fetchData(string url)
		// Simulated async data fetching
		return "Data from " + url
	
	void logMessage(string message)
		// Simulated logging operation
		print("LOG: ")
		print(message)

start()

	// Test start keyword for async execution
	string result1 = start fetchData("https://api.example.com/data1")
	print("Started async fetch for data1")
	
	// Test later keyword for deferred execution
	later data2 = start fetchData("https://api.example.com/data2")
	print("Scheduled async fetch for data2")
	
	// Test background keyword for fire-and-forget operations
	background logMessage("System started")
	
	print("Background tasks initiated")
	
	// Access deferred results (this would block until ready)
	print("Data2 result: ")
	print(data2)
	
	print("Async keywords test completed successfully!")