functions:

	testStaticMethods()

		// Test math class static methods (lowercase)
		number result = math.max(5.0, 3.0)
		print "math.max(5.0, 3.0 ln: ")
		print result.toString( ln)
		
		number absolute = math.abs(-42.5)
		print "math.abs(-42.5 ln: ")
		print absolute.toString( ln)
		
		print "Static method calls test completed successfully!" ln

