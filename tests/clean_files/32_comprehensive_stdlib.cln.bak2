functions:
	void testMathOperations()
		print "=== Math Operations - Specification Compliant ===" ln
		// Basic arithmetic - use operators per Clean Language "one way to do things"
		number a = 15.5
		number b = 4.2
		print "Basic math: " + a.toString( ln + " + " + b.toString() + " = " + (a + b).toString())
		print "Basic math: " + a.toString( ln + " - " + b.toString() + " = " + (a - b).toString())
		print "Basic math: " + a.toString( ln + " * " + b.toString() + " = " + (a * b).toString())
		print "Basic math: " + a.toString( ln + " / " + b.toString() + " = " + (a / b).toString())
		// Advanced math functions - use lowercase namespace functions
		number x = 16.0
		print "math.sqrt(" + x.toString( ln + ") = " + math.sqrt(x).toString())
		print "math.abs(-" + x.toString( ln + ") = " + math.abs(-x).toString())
		print "math.max(" + a.toString( ln + ", " + b.toString() + ") = " + math.max(a, b).toString())
		print "math.min(" + a.toString( ln + ", " + b.toString() + ") = " + math.min(a, b).toString())
		// Rounding functions
		number decimal = 3.7456
		print "math.floor(" + decimal.toString( ln + ") = " + math.floor(decimal).toString())
		print "math.ceil(" + decimal.toString( ln + ") = " + math.ceil(decimal).toString())
		print "math.round(" + decimal.toString( ln + ") = " + math.round(decimal).toString())
		print "math.trunc(" + decimal.toString( ln + ") = " + math.trunc(decimal).toString())
		// Trigonometric functions
		number angle = math.pi() / 4.0
		print "math.sin(pi/4 ln = " + math.sin(angle).toString())
		print "math.cos(pi/4 ln = " + math.cos(angle).toString())
		print "math.tan(pi/4 ln = " + math.tan(angle).toString())
		// Logarithmic functions
		number value = 10.0
		print "math.ln(" + value.toString( ln + ") = " + math.ln(value).toString())
		print "math.log10(" + value.toString( ln + ") = " + math.log10(value).toString())
		print "math.exp(1.0 ln = " + math.exp(1.0).toString())
		// Constants
		print "math.pi( ln = " + math.pi().toString())
		print "math.e( ln = " + math.e().toString())
		print "math.tau( ln = " + math.tau().toString())
	
	void testStringOperations()
		print "=== String Operations - Specification Compliant ===" ln
		string text = "Hello, Clean Language World!"
		string search = "Clean"
		// Method-style string operations (preferred pattern)
		print "text.length( ln = " + text.length().toString())
		print "text.toUpperCase( ln = " + text.toUpperCase())
		print "text.toLowerCase( ln = " + text.toLowerCase())
		// String utility functions (lowercase namespace)
		boolean containsResult = string.contains(text, search)
		print "string.contains result = " + containsResult.toString() ln
		integer indexResult = string.indexOf(text, search)
		print "string.indexOf result = " + indexResult.toString() ln
		integer lastIndexResult = string.lastIndexOf(text, "l")
		print "string.lastIndexOf result = " + lastIndexResult.toString() ln
		boolean startsWithResult = string.startsWith(text, "Hello")
		print "string.startsWith result = " + startsWithResult.toString() ln
		boolean endsWithResult = string.endsWith(text, "World!")
		print "string.endsWith result = " + endsWithResult.toString() ln
		// String manipulation with utility functions
		string padded = "  trim test  "
		print "Original string: " + padded ln
		print "string.trim result: " + string.trim(padded) ln
		print "string.trimStart result: " + string.trimStart(padded) ln
		print "string.trimEnd result: " + string.trimEnd(padded) ln
		// String replacement
		string original = "The quick brown fox"
		print "string.replace result = " + string.replace(original, "quick", "slow") ln
		print "string.substring result = " + string.substring(original, 4, 9) ln
	
	void testListOperations()
		print "=== List Operations - Specification Compliant ===" ln
		list<integer> numbers = [1, 2, 3, 4, 5]
		list<string> words = ["apple", "banana", "cherry"]
		// Method-style list operations (preferred pattern)
		print "numbers.length( ln = " + numbers.length().toString())
		print "words.length( ln = " + words.length().toString())
		// List access and modification
		integer numberElement = numbers[2]
		print "numbers[2] = " + numberElement.toString() ln
		print "words[1] = " + words[1] ln
		// List utility functions (lowercase namespace)
		list.add(numbers, 6)
		print "After list.add(6 ln: length = " + numbers.length().toString())
		integer removed = list.remove(numbers, numbers.length() - 1)
		print "Removed element: " + removed.toString() ln
		print "After list.remove: length = " + numbers.length( ln.toString())
		// List searching with utility functions
		print "list.contains(numbers, 3 ln = " + list.contains(numbers, 3).toString())
		print "list.contains(words, \"grape\" ln = " + list.contains(words, "grape").toString())
		// List iteration
		print "Numbers iteration:" ln
		iterate num in numbers
			print "  " + num.toString() ln
	
	void testFileOperations() 
		print "=== File Operations ===" ln
		string filename = "test_file.txt"
		string content = "Hello from Clean Language!"
		// File operations (simplified for testing)
		print "Testing file operations with: " + filename ln
		print "Content to write: " + content ln
		// Note: Actual file I/O would be tested in integration tests
		// Here we just demonstrate the syntax
		boolean writeResult = file.write(filename, content)
		print "file.write( ln result: " + writeResult.toString())
		boolean exists = file.exists(filename)
		print "file.exists( ln result: " + exists.toString())
		if exists
			string readContent = file.read(filename)
			print "file.read( ln result: " + readContent)
			boolean appendResult = file.append(filename, " Appended text!")
			print "file.append( ln result: " + appendResult.toString())
			boolean deleteResult = file.delete(filename)
			print "file.delete( ln result: " + deleteResult.toString())
start()
	print "Comprehensive Standard Library Test" ln
	print "====================================" ln
	testMathOperations()
	print "" ln
	testStringOperations()
	print "" ln
	testListOperations()
	print "" ln
	testFileOperations()
	print "" ln
	print "Standard library test completed!" ln