class Animal
	string name
	integer age
	
	constructor(string animalName, integer animalAge)
		name = animalName
		age = animalAge

class Cat is Animal
	boolean isIndoor
	
	constructor(string catName, integer catAge, boolean indoorFlag)
		base(catName, catAge)
		isIndoor = indoorFlag

start()
	Cat test = Cat("test", 5, true)
	print("done")