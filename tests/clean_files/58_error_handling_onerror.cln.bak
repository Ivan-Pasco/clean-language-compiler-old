// Error handling with onError syntax comprehensive test
// According to Clean Language Specification, onError provides error recovery

functions:
	integer safeDivide(integer a, integer b)
		if b == 0
			error("Division by zero")
		return a / b
	
	string readFileContents(string filename)
		if filename == ""
			error("Filename cannot be empty")
		return "file contents"
	
	void testErrorHandling()
		// Test onError with fallback value
		integer result1 = safeDivide(10, 2) onError 0
		print "Safe division result: " + result1.toString( ln)
		
		// Test onError with division by zero
		integer result2 = safeDivide(10, 0) onError -1
		print "Division by zero handled: " + result2.toString( ln)
		
		// Test onError with file reading
		string contents1 = readFileContents("valid.txt") onError "default content"
		print "File contents: " + contents1 ln
		
		// Test onError with empty filename
		string contents2 = readFileContents("") onError "error occurred"
		print "Error handled: " + contents2 ln
		
		// Test onError with expression
		integer calculation = (safeDivide(100, 0) + 5) onError 999
		print "Calculation with error: " + calculation.toString( ln)

start()
	testErrorHandling()
	print "Error handling test completed successfully" ln