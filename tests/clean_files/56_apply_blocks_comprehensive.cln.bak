// Apply-blocks comprehensive test - demonstrates the : syntax for all scenarios
// According to Clean Language Specification, apply-blocks apply identifier: to each indented item

functions:
	testApplyBlocks()
		// Test apply-block for function calls
		println:
			"Apply-block function call test"
			"Multiple lines with apply syntax"
			"Third line of output"
		
		// Test apply-block for variable declarations  
		integer:
			count = 0
			maxSize = 100
			currentIndex = -1
		
		string:
			name = "Alice"
			version = "1.0.0"
			status = "active"
		
		// Test apply-block for constants
		constant:
			integer MAX_SIZE = 100
			number PI = 3.14159
			string VERSION = "1.0.0"
		
		// Use the declared variables
		print "Count: " + count.toString( ln)
		print "Name: " + name ln
		print "PI: " + PI.toString( ln)

start()
	testApplyBlocks()
	print "Apply-blocks test completed successfully" ln