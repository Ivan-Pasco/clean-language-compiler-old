// Type precision comprehensive test - demonstrates precision modifiers

functions:
	void testIntegerPrecisionModifiers()
		print("=== Integer Precision Modifiers ===")
		
		// Standard integer (32-bit)
		integer standard = 2147483647
		print("Standard integer (32-bit): " + standard.toString())
		
		// 8-bit integers
		integer:8 small = 127
		integer:8 smallNegative = -128
		print("8-bit integer max: " + small.toString())
		print("8-bit integer min: " + smallNegative.toString())
		
		// 16-bit integers
		integer:16 medium = 32767
		integer:16 mediumNegative = -32768
		print("16-bit integer max: " + medium.toString())
		print("16-bit integer min: " + mediumNegative.toString())
		
		// 64-bit integers for large numbers
		integer:64 huge = 9223372036854775807
		print("64-bit integer max: " + huge.toString())
		
		// Unsigned integers (positive only)
		integer:8u smallUnsigned = 255
		integer:16u mediumUnsigned = 65535
		integer:32u largeUnsigned = 2147483647
		print("8-bit unsigned max: " + smallUnsigned.toString())
		print("16-bit unsigned max: " + mediumUnsigned.toString())
		print("32-bit unsigned max: " + largeUnsigned.toString())
	
	void testNumberPrecisionModifiers()
		print("=== Number Precision Modifiers ===")
		
		// Standard number (64-bit double precision)
		number standard = 3.141592653589793
		print("Standard number (64-bit): " + standard.toString())
		
		// 32-bit single precision (faster, less precision)
		number:32 singlePrecision = 3.14
		print("32-bit single precision: " + singlePrecision.toString())
		
		// 64-bit double precision (explicit)
		number:64 doublePrecision = 3.141592653589793
		print("64-bit double precision: " + doublePrecision.toString())
		
		// Demonstrate precision differences
		number:32 pi32 = 3.141592653589793
		number:64 pi64 = 3.141592653589793
		print("PI in 32-bit: " + pi32.toString())
		print("PI in 64-bit: " + pi64.toString())
	
	void testPrecisionUseScenarios()
		print("=== Precision Use Case Scenarios ===")
		
		// Large calculations requiring 64-bit integers
		integer:64 population = 8000000000
		integer:64 timestamp = 1640995200000
		print("World population: " + population.toString())
		print("Timestamp: " + timestamp.toString())
		
		// High-precision scientific calculations
		number:64 pi = 3.141592653589793
		number:64 e = 2.718281828459045
		number:64 scientificResult = pi * e
		print("High precision calculation: π * e = " + scientificResult.toString())
		
		// Memory-efficient small numbers
		integer:8 counter = 0
		integer:16 portNumber = 8080
		integer:8u flags = 255
		print("Small counter: " + counter.toString())
		print("Port number: " + portNumber.toString())
		print("Flags: " + flags.toString())
		
		// Graphics/gaming calculations (speed over precision)
		number:32 screenX = 1920.0
		number:32 screenY = 1080.0
		number:32 aspectRatio = screenX / screenY
		print("Screen resolution: " + screenX.toString() + "x" + screenY.toString())
		print("Aspect ratio: " + aspectRatio.toString())
	
	void testPrecisionCalculations()
		print("=== Precision-Specific Calculations ===")
		
		// Financial calculations requiring high precision
		number:64 price = 19.99
		number:64 taxRate = 0.08375
		number:64 tax = price * taxRate
		number:64 total = price + tax
		print("Price: $" + price.toString())
		print("Tax: $" + tax.toString())
		print("Total: $" + total.toString())
		
		// Large integer calculations
		integer:64 bigNumber1 = 1000000000000
		integer:64 bigNumber2 = 2000000000000
		integer:64 bigSum = bigNumber1 + bigNumber2
		print("Large calculation: " + bigNumber1.toString() + " + " + bigNumber2.toString() + " = " + bigSum.toString())
		
		// Memory-efficient array indexing
		integer:16 arraySize = 10000
		integer:16 index = 5432
		print("Array size: " + arraySize.toString())
		print("Array index: " + index.toString())
	
	void testPrecisionConversions()
		print("=== Precision Conversions ===")
		
		// Converting between precisions
		integer:64 largePrecision = 1234567890
		integer:32 standardPrecision = largePrecision  // Should convert safely
		print("64-bit to 32-bit conversion: " + standardPrecision.toString())
		
		// Number precision conversions
		number:64 highPrecision = 3.141592653589793
		number:32 lowPrecision = highPrecision  // Should convert with precision loss
		print("64-bit to 32-bit number: " + lowPrecision.toString())
		
		// Type conversions with precision
		integer:64 bigInt = 9876543210
		number:64 bigFloat = bigInt.toNumber()
		print("Integer to number conversion: " + bigFloat.toString())

	void start()
	print("Type Precision Comprehensive Test")
	print("=================================")
	void testIntegerPrecisionModifiers()
	print("")
	void testNumberPrecisionModifiers()
	print("")
	void testPrecisionUseScenarios()
	print("")
	void testPrecisionCalculations()
	print("")
	void testPrecisionConversions()
	print("")
	print("Type precision test completed successfully")