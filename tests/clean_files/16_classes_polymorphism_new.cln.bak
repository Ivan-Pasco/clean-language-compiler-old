class Vehicle
	string make
	string model
	integer year
	
	constructor(string vehicleMake, string vehicleModel, integer vehicleYear)
		make = vehicleMake
		model = vehicleModel
		year = vehicleYear
	
	functions:
		string getInfo()
			return year.toString() + " " + make + " " + model
		
		string start()
			return "Vehicle starting..."
		
		string stop()
			return "Vehicle stopping..."
		
		integer getMaxSpeed()
			return 60

class Car is Vehicle
	integer doors
	boolean isElectric
	
	constructor(string carMake, string carModel, integer carYear, integer carDoors, boolean electric)
		base(carMake, carModel, carYear)
		doors = carDoors
		isElectric = electric
	
	functions:
		string start()
			if isElectric
				return make + " " + model + " starting silently"
			else
				return make + " " + model + " engine starting"
		
		string stop()
			return make + " " + model + " parking"
		
		integer getMaxSpeed()
			if isElectric
				return 120
			else
				return 100

class Motorcycle is Vehicle
	boolean hasSidecar
	
	constructor(string bikeMake, string bikeModel, integer bikeYear, boolean sidecar)
		base(bikeMake, bikeModel, bikeYear)
		hasSidecar = sidecar
	
	functions:
		string start()
			return make + " " + model + " motorcycle starting"
		
		string stop()
			return make + " " + model + " motorcycle stopping"
		
		integer getMaxSpeed()
			if hasSidecar
				return 80
			else
				return 140

start()
	print "Polymorphism Test - Vehicle System" ln
	
	Car tesla = Car("Tesla", "Model 3", 2023, 4, true)
	Car honda = Car("Honda", "Civic", 2022, 4, false)
	Motorcycle harley = Motorcycle("Harley-Davidson", "Street 750", 2021, false)
	
	print "Tesla: " + tesla.start( ln)
	print "Honda: " + honda.start( ln)
	print "Harley: " + harley.start( ln)
	
	print "Tesla max speed: " + tesla.getMaxSpeed( ln.toString())
	print "Honda max speed: " + honda.getMaxSpeed( ln.toString())
	print "Harley max speed: " + harley.getMaxSpeed( ln.toString())