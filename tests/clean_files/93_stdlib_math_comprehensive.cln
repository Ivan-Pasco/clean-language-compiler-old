// Standard Library Math Module Comprehensive Test
// Tests all mathematical functions and constants as specified

functions:
	void testCoreMathOperations()
		print "=== Core Math Operations ===" ln
		
		// Basic mathematical functions
		number sqrtResult = math.sqrt(16.0)
		number absNumber = math.abs(-5.7)
		integer absInteger = math.abs(-42)
		number maxResult = math.max(10.5, 7.2)
		number minResult = math.min(10.5, 7.2)
		
		print "sqrt(16.0) = " + sqrtResult.toString() ln
		print "abs(-5.7) = " + absNumber.toString() ln
		print "abs(-42) = " + absInteger.toString() ln
		print "max(10.5, 7.2) = " + maxResult.toString() ln
		print "min(10.5, 7.2) = " + minResult.toString() ln
		
	void testRoundingFunctions()
		print "=== Rounding and Precision Functions ===" ln
		
		number testValue = 3.7
		number negativeValue = -2.3
		
		number floorResult = math.floor(testValue)
		number ceilResult = math.ceil(testValue)
		number roundResult = math.round(testValue)
		
		number floorNeg = math.floor(negativeValue)
		number ceilNeg = math.ceil(negativeValue)
		number roundNeg = math.round(negativeValue)
		
		print "floor(3.7) = " + floorResult.toString() ln
		print "ceil(3.7) = " + ceilResult.toString() ln
		print "round(3.7) = " + roundResult.toString() ln
		print "floor(-2.3) = " + floorNeg.toString() ln
		print "ceil(-2.3) = " + ceilNeg.toString() ln
		print "round(-2.3) = " + roundNeg.toString() ln
		
	void testTrigonometricFunctions()
		print "=== Trigonometric Functions ===" ln
		
		number pi = math.pi()
		number angle = pi / 4.0  // 45 degrees in radians
		
		number sinResult = math.sin(angle)
		number cosResult = math.cos(angle)
		number tanResult = math.tan(angle)
		
		// Inverse trigonometric functions
		number asinResult = math.asin(0.7071)  // approximately sin(π/4)
		number acosResult = math.acos(0.7071)  // approximately cos(π/4)
		number atanResult = math.atan(1.0)     // atan(1) = π/4
		number atan2Result = math.atan2(1.0, 1.0)  // atan2(1,1) = π/4
		
		print "sin(π/4) = " + sinResult.toString() ln
		print "cos(π/4) = " + cosResult.toString() ln
		print "tan(π/4) = " + tanResult.toString() ln
		print "asin(0.7071) = " + asinResult.toString() ln
		print "acos(0.7071) = " + acosResult.toString() ln
		print "atan(1.0) = " + atanResult.toString() ln
		print "atan2(1.0, 1.0) = " + atan2Result.toString() ln
		
	void testLogarithmicFunctions()
		print "=== Logarithmic and Exponential Functions ===" ln
		
		number e = math.e()
		number value = 10.0
		
		// Logarithmic functions
		number lnResult = math.ln(e)        // ln(e) = 1
		number log10Result = math.log10(100.0)  // log10(100) = 2
		number log2Result = math.log2(8.0)      // log2(8) = 3
		
		// Exponential functions
		number expResult = math.exp(1.0)    // e^1 = e
		number exp2Result = math.exp2(3.0)  // 2^3 = 8
		
		print "ln(e) = " + lnResult.toString() ln
		print "log10(100) = " + log10Result.toString() ln
		print "log2(8) = " + log2Result.toString() ln
		print "exp(1) = " + expResult.toString() ln
		print "exp2(3) = " + exp2Result.toString() ln
		
	void testHyperbolicFunctions()
		print "=== Hyperbolic Functions ===" ln
		
		number x = 1.0
		
		number sinhResult = math.sinh(x)
		number coshResult = math.cosh(x)
		number tanhResult = math.tanh(x)
		
		print "sinh(1.0) = " + sinhResult.toString() ln
		print "cosh(1.0) = " + coshResult.toString() ln
		print "tanh(1.0) = " + tanhResult.toString() ln
		
	void testMathematicalConstants()
		print "=== Mathematical Constants ===" ln
		
		number piValue = math.pi()
		number eValue = math.e()
		number tauValue = math.tau()
		
		print "π (pi) = " + piValue.toString() ln
		print "e (Euler's number) = " + eValue.toString() ln
		print "τ (tau) = " + tauValue.toString() ln
		
		// Verify tau = 2π
		number calculatedTau = 2.0 * piValue
		number difference = tauValue - calculatedTau
		number absResult = math.abs(difference)
		boolean tauCorrect = absResult < 0.0001
		print "τ = 2π verification: " + tauCorrect.toString() ln
		
	void testPracticalCalculations()
		print "=== Practical Math Applications ===" ln
		
		// Circle area calculation
		number radius = 5.0
		number pi3 = math.pi()
		number area = pi3 * (radius ^ 2.0)
		print "Circle area (radius=5): " + area.toString() ln
		
		// Distance calculation (Pythagorean theorem)
		number dx = 3.0
		number dy = 4.0
		number distance = math.sqrt((dx ^ 2.0) + (dy ^ 2.0))
		print "Distance (3,4 to origin): " + distance.toString() ln
		
		// Trigonometry - find triangle sides
		number pi2 = math.pi()
		number angleRad = pi2 / 6.0  // 30 degrees
		number hypotenuse = 10.0
		number opposite = hypotenuse * math.sin(angleRad)
		number adjacent = hypotenuse * math.cos(angleRad)
		print "Triangle opposite side: " + opposite.toString() ln
		print "Triangle adjacent side: " + adjacent.toString() ln
		
		// Exponential growth
		number principal = 1000.0
		number rate = 0.05  // 5% growth
		number time = 2.0
		number growth = principal * math.exp(rate * time)
		print "Exponential growth: " + growth.toString() ln

start()
	print "Standard Library Math Module Test" ln
	print "=================================" ln
	testCoreMathOperations()
	print "" ln
	testRoundingFunctions()
	print "" ln
	testTrigonometricFunctions()
	print "" ln
	testLogarithmicFunctions()
	print "" ln
	testHyperbolicFunctions()
	print "" ln
	testMathematicalConstants()
	print "" ln
	testPracticalCalculations()
	print "" ln
	print "Math module comprehensive test completed" ln