// Test list behavior modifiers - FIFO, LIFO, and unique elements

functions:
	void testQueueBehavior()
		print("=== Testing Queue (FIFO) Behavior ===")
		list<string> taskQueue = []
		taskQueue.type = "line"
		
		taskQueue.add("Task 1")
		taskQueue.add("Task 2")
		taskQueue.add("Task 3")
		
		print("Queue size: " + taskQueue.size().toString())
		
		string first = taskQueue.remove()
		print("Removed: " + first)
		
		string second = taskQueue.remove()
		print("Removed: " + second)
		
		string next = taskQueue.peek()
		print("Next (peek): " + next)
		print("Queue size after peek: " + taskQueue.size().toString())
	
	void testStackBehavior()
		print("=== Testing Stack (LIFO) Behavior ===")
		list<string> undoStack = []
		undoStack.type = "pile"
		
		undoStack.add("Operation 1")
		undoStack.add("Operation 2")
		undoStack.add("Operation 3")
		
		print("Stack size: " + undoStack.size().toString())
		
		string last = undoStack.remove()
		print("Undone: " + last)
		
		string secondLast = undoStack.remove()
		print("Undone: " + secondLast)
		
		string top = undoStack.peek()
		print("Top (peek): " + top)
	
	void testUniqueBehavior()
		print("=== Testing Unique (Set) Behavior ===")
		list<integer> uniqueNumbers = []
		uniqueNumbers.type = "unique"
		
		uniqueNumbers.add(5)
		uniqueNumbers.add(10)
		uniqueNumbers.add(5)
		uniqueNumbers.add(15)
		uniqueNumbers.add(10)
		
		print("Unique numbers count: " + uniqueNumbers.size().toString())
		
		boolean hasFive = uniqueNumbers.contains(5)
		boolean hasTen = uniqueNumbers.contains(10)
		boolean hasTwenty = uniqueNumbers.contains(20)
		
		print("Contains 5: " + hasFive.toString())
		print("Contains 10: " + hasTen.toString())
		print("Contains 20: " + hasTwenty.toString())
	
	void testCombinedBehaviors()
		print("=== Testing Combined Behaviors ===")
		
		list<string> uniqueQueue = []
		uniqueQueue.type = "line-unique"
		
		uniqueQueue.add("First")
		uniqueQueue.add("Second")
		uniqueQueue.add("First")
		uniqueQueue.add("Third")
		
		print("Unique queue size: " + uniqueQueue.size().toString())
		string removed = uniqueQueue.remove()
		print("Removed from unique queue: " + removed)
	
	void testUtilityMethods()
		print("=== Testing Utility Methods ===")
		list<integer> numbers = []
		
		boolean empty = numbers.isEmpty()
		print("Empty list isEmpty: " + empty.toString())
		
		numbers.add(42)
		boolean notEmpty = numbers.isNotEmpty()
		print("Non-empty list isNotEmpty: " + notEmpty.toString())
		
		numbers.type = "pile"
		string behavior = numbers.type
		print("Current behavior: " + behavior)

start()
	print("Clean Language List Behavior Test")
	print("==================================")
	testQueueBehavior()
	print("")
	testStackBehavior()
	print("")
	testUniqueBehavior()
	print("")
	testCombinedBehaviors()
	print("")
	testUtilityMethods()
	print("")
	print("All list behavior tests completed!")