// Simple onError expression test
functions:
	integer safeDivide(integer a, integer b)
		if b == 0
			error("Division by zero")
		return a / b
	
	void testOnError()
		// Basic onError expression
		integer result1 = safeDivide(10, 2) onError 0
		print "Safe division: " + result1.toString() ln
		
		// onError with error - should use fallback
		integer result2 = safeDivide(10, 0) onError -1
		print "Division by zero handled: " + result2.toString() ln

start()
	testOnError()
	print "Test completed" ln