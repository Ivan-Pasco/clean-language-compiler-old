functions:
	integer add(integer a, integer b)
		return a + b
	
	integer multiply(integer x, integer y)
		return x * y
	
	string formatName(string firstName, string lastName)
		return firstName + " " + lastName
	
	boolean isEven(integer num)
		return num % 2 == 0
	
	boolean isEmpty(string text)
		return text.length() == 0
	
	integer factorial(integer n)
		if n <= 1
			return 1
		else
			return n * factorial(n - 1)
	
	number divide(number a, number b)
		if b == 0.0
			return 0.0
		else
			return a / b

// Built-in testing framework using tests: block
tests:
	// Named tests with descriptions
	"adds two positive numbers": add(5, 3) = 8
	"adds positive and negative": add(10, -3) = 7
	"adds two negative numbers": add(-5, -3) = -8
	"adds zero": add(5, 0) = 5
	
	"multiplies positive numbers": multiply(4, 3) = 12
	"multiplies by zero": multiply(5, 0) = 0  
	"multiplies negative numbers": multiply(-3, -4) = 12
	
	"formats full name": formatName("John", "Doe") = "John Doe"
	"formats with empty last name": formatName("Alice", "") = "Alice "
	
	"detects even numbers": isEven(4) = true
	"detects odd numbers": isEven(7) = false
	"zero is even": isEven(0) = true
	
	"detects empty string": isEmpty("") = true
	"detects non-empty string": isEmpty("hello") = false
	
	"factorial of 0": factorial(0) = 1
	"factorial of 1": factorial(1) = 1
	"factorial of 5": factorial(5) = 120
	
	"division normal case": divide(10.0, 2.0) = 5.0
	"division by zero": divide(5.0, 0.0) = 0.0
	
	// Anonymous tests (no description) 
	String.length("hello") = 5
	String.toUpperCase("world") = "WORLD"
	String.toLowerCase("TEST") = "test"
	String.contains("hello world", "world") = true
	String.startsWith("prefix_test", "prefix") = true
	String.endsWith("test_suffix", "suffix") = true
	
	Math.abs(-42) = 42
	Math.max(10, 20) = 20
	Math.min(5, 3) = 3
	Math.sqrt(16.0) = 4.0
	
	// List operations tests
	[1, 2, 3].length() = 3
	[1, 2, 3, 4, 5][2] = 3
	["a", "b", "c"].contains("b") = true

start()
	print("Testing framework demonstration")
	print("Run with --test flag to execute all tests")
	
	// Regular program execution
	integer result = add(10, 15)
	print("Regular execution: 10 + 15 = " + result.toString())
	
	string fullName = formatName("Clean", "Language")
	print("Formatted name: " + fullName)
	
	boolean evenCheck = isEven(result)
	print("Is " + result.toString() + " even? " + evenCheck.toString())