// Type precision comprehensive test - demonstrates precision modifiers

functions:
	testIntegerPrecisionModifiers()
		print "=== Integer Precision Modifiers ===" ln
		
		// Standard integer (32-bit)
		integer standard = 2147483647
		print "Standard integer (32-bit ln: " + standard.toString())
		
		// 8-bit integers
		integer:8 small = 127
		integer:8 smallNegative = -128
		print "8-bit integer max: " + small.toString( ln)
		print "8-bit integer min: " + smallNegative.toString( ln)
		
		// 16-bit integers
		integer:16 medium = 32767
		integer:16 mediumNegative = -32768
		print "16-bit integer max: " + medium.toString( ln)
		print "16-bit integer min: " + mediumNegative.toString( ln)
		
		// 64-bit integers for large numbers
		integer:64 huge = 9223372036854775807
		print "64-bit integer max: " + huge.toString( ln)
		
		// Unsigned integers (positive only)
		integer:8u smallUnsigned = 255
		integer:16u mediumUnsigned = 65535
		integer:32u largeUnsigned = 2147483647
		print "8-bit unsigned max: " + smallUnsigned.toString( ln)
		print "16-bit unsigned max: " + mediumUnsigned.toString( ln)
		print "32-bit unsigned max: " + largeUnsigned.toString( ln)
	
	testNumberPrecisionModifiers()
		print "=== Number Precision Modifiers ===" ln
		
		// Standard number (64-bit double precision)
		number standard = 3.141592653589793
		print "Standard number (64-bit ln: " + standard.toString())
		
		// 32-bit single precision (faster, less precision)
		number:32 singlePrecision = 3.14
		print "32-bit single precision: " + singlePrecision.toString( ln)
		
		// 64-bit double precision (explicit)
		number:64 doublePrecision = 3.141592653589793
		print "64-bit double precision: " + doublePrecision.toString( ln)
		
		// Demonstrate precision differences
		number:32 pi32 = 3.141592653589793
		number:64 pi64 = 3.141592653589793
		print "PI in 32-bit: " + pi32.toString( ln)
		print "PI in 64-bit: " + pi64.toString( ln)
	
	testPrecisionUseScenarios()
		print "=== Precision Use Case Scenarios ===" ln
		
		// Large calculations requiring 64-bit integers
		integer:64 population = 8000000000
		integer:64 timestamp = 1640995200000
		print "World population: " + population.toString( ln)
		print "Timestamp: " + timestamp.toString( ln)
		
		// High-precision scientific calculations
		number:64 pi = 3.141592653589793
		number:64 e = 2.718281828459045
		number:64 scientificResult = pi * e
		print "High precision calculation: π * e = " + scientificResult.toString( ln)
		
		// Memory-efficient small numbers
		integer:8 counter = 0
		integer:16 portNumber = 8080
		integer:8u flags = 255
		print "Small counter: " + counter.toString( ln)
		print "Port number: " + portNumber.toString( ln)
		print "Flags: " + flags.toString( ln)
		
		// Graphics/gaming calculations (speed over precision)
		number:32 screenX = 1920.0
		number:32 screenY = 1080.0
		number:32 aspectRatio = screenX / screenY
		print "Screen resolution: " + screenX.toString( ln + "x" + screenY.toString())
		print "Aspect ratio: " + aspectRatio.toString( ln)
	
	testPrecisionCalculations()
		print "=== Precision-Specific Calculations ===" ln
		
		// Financial calculations requiring high precision
		number:64 price = 19.99
		number:64 taxRate = 0.08375
		number:64 tax = price * taxRate
		number:64 total = price + tax
		print "Price: $" + price.toString( ln)
		print "Tax: $" + tax.toString( ln)
		print "Total: $" + total.toString( ln)
		
		// Large integer calculations
		integer:64 bigNumber1 = 1000000000000
		integer:64 bigNumber2 = 2000000000000
		integer:64 bigSum = bigNumber1 + bigNumber2
		print "Large calculation: " + bigNumber1.toString( ln + " + " + bigNumber2.toString() + " = " + bigSum.toString())
		
		// Memory-efficient array indexing
		integer:16 arraySize = 10000
		integer:16 index = 5432
		print "Array size: " + arraySize.toString( ln)
		print "Array index: " + index.toString( ln)
	
	testPrecisionConversions()
		print "=== Precision Conversions ===" ln
		
		// Converting between precisions
		integer:64 largePrecision = 1234567890
		integer:32 standardPrecision = largePrecision  // Should convert safely
		print "64-bit to 32-bit conversion: " + standardPrecision.toString( ln)
		
		// Number precision conversions
		number:64 highPrecision = 3.141592653589793
		number:32 lowPrecision = highPrecision  // Should convert with precision loss
		print "64-bit to 32-bit number: " + lowPrecision.toString( ln)
		
		// Type conversions with precision
		integer:64 bigInt = 9876543210
		number:64 bigFloat = bigInt.toNumber()
		print "Integer to number conversion: " + bigFloat.toString( ln)

start()
	print "Type Precision Comprehensive Test" ln
	print "=================================" ln
	testIntegerPrecisionModifiers()
	print "" ln
	testNumberPrecisionModifiers()
	print "" ln
	testPrecisionUseScenarios()
	print "" ln
	testPrecisionCalculations()
	print "" ln
	testPrecisionConversions()
	print "" ln
	print "Type precision test completed successfully" ln