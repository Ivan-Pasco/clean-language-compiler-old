functions:
	void processItem(string item)
		print "Processing: " + item ln
	
	void displayNumber(integer num)
		print "Number: " + num.toString( ln)

start()
	// Function apply-blocks - TODO: Fix semantic analysis bug
	// Currently disabled due to compiler bug where function apply-blocks
	// are treated as multi-argument calls instead of multiple single calls
	print "Function apply-blocks temporarily disabled due to compiler bug" ln
	
	// Type apply-blocks for variable declarations
	integer:
		count = 0
		maxSize = 100
		currentIndex = -1
	
	string:
		name = "Alice"
		version = "1.0.0"
		greeting = "Hello"
	
	boolean:
		isActive = true
		hasPermission = false
		isComplete = true
	
	// Test the declared variables
	print "Variables declared via apply-blocks:" ln
	print "Count: " + count.toString( ln)
	print "Max size: " + maxSize.toString( ln)
	print "Name: " + name ln
	print "Version: " + version ln
	print "Active: " + isActive.toString( ln)
	
	// Constant apply-blocks
	constant:
		integer MAX_USERS = 1000
		string API_VERSION = "v2.1"
		number PI_CONSTANT = 3.14159
	
	print "Constants:" ln
	print "Max users: " + MAX_USERS.toString( ln)
	print "API version: " + API_VERSION ln
	print "PI: " + PI_CONSTANT.toString( ln)