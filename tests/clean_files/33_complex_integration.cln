// Complex integration test combining multiple Clean Language features
// This test exercises: classes, inheritance, generics, apply-blocks, precision modifiers, 
// error handling, standard library usage, and testing framework

class Shape
	string name
	number:64 area
	
	constructor(string shapeName)
		name = shapeName
		area = 0.0
	
	functions:
		string getName()
			return name
		
		number:64 getArea()
			return area
		
		void setArea(number:64 newArea)
			area = newArea
		
		string toString()
			return name + " with area " + area.toString()

class Rectangle is Shape
	number:32 width
	number:32 height
	
	constructor(number:32 w, number:32 h)
		base("Rectangle")
		width = w
		height = h
		area = width * height
	
	functions:
		number:32 getWidth()
			return width
		
		number:32 getHeight()
			return height
		
		void resize(number:32 newWidth, number:32 newHeight)
			width = newWidth
			height = newHeight
			area = width * height
		
		number:64 getPerimeter()
			return 2.0 * (width + height)

class Circle is Shape
	number:64 radius
	
	constructor(number:64 r)
		base("Circle")
		radius = r
		area = Math.pi() * radius * radius
	
	functions:
		number:64 getRadius()
			return radius
		
		void setRadius(number:64 newRadius)
			radius = newRadius
			area = Math.pi() * radius * radius
		
		number:64 getCircumference()
			return 2.0 * Math.pi() * radius

// Generic utility functions
functions:
	list<any> filterLargeShapes(list<Shape> shapes, number:64 minArea)
		list<any> result = []
		iterate shape in shapes
			if shape.getArea() >= minArea
				result.push(shape)
		return result
	
	any findShapeByName(list<Shape> shapes, string targetName)
		iterate shape in shapes
			if String.contains(shape.getName(), targetName)
				return shape
		return ""
	
	number:64 calculateTotalArea(list<Shape> shapes)
		number:64 total = 0.0
		iterate shape in shapes
			total = total + shape.getArea()
		return total
	
	string formatShapeReport(Shape shape)
		string report = "Shape Report:"
		report = String.concat(report, " Name: " + shape.getName())
		report = String.concat(report, ", Area: " + shape.getArea().toString())
		return report
	
	void processShapes(list<Shape> shapes) onError:
		print("Error processing shapes - using default handling")
		print("Continuing with available shapes...")

// Built-in testing for the complex functionality
tests:
	"rectangle area calculation": Rectangle(5.0, 4.0).getArea() = 20.0
	"circle area calculation": Circle(2.0).getArea() = Math.pi() * 4.0
	"rectangle perimeter": Rectangle(3.0, 4.0).getPerimeter() = 14.0
	"circle circumference": Circle(1.0).getCircumference() = 2.0 * Math.pi()
	"string operations": String.toUpperCase("test") = "TEST"
	"math operations": Math.max(10.0, 5.0) = 10.0

start()
	print("Complex Integration Test - Clean Language Features")
	print("================================================")
	
	// Apply-blocks for creating multiple shapes
	print("Creating shapes using various language features...")
	
	// Precision modifiers in action
	number:32 smallWidth = 3.5
	number:32 smallHeight = 2.8
	number:64 largeRadius = 5.75
	
	// Object creation and inheritance
	Rectangle rect1 = Rectangle(smallWidth, smallHeight)
	Rectangle rect2 = Rectangle(6.0, 4.5)
	Circle circle1 = Circle(largeRadius)
	Circle circle2 = Circle(3.2)
	
	// Using apply-blocks for operations
	print:
		"Initial shapes created:"
		rect1.toString()
		rect2.toString()
		circle1.toString()
		circle2.toString()
	
	// List operations with shapes
	list<Shape> allShapes = [rect1, rect2, circle1, circle2]
	
	// Generic function usage
	number:64 totalArea = calculateTotalArea(allShapes)
	print("Total area of all shapes: " + totalArea.toString())
	
	// String operations for reporting
	string:
		report1 = formatShapeReport(rect1)
		report2 = formatShapeReport(circle1)
		separator = String.repeat("-", 30)
	
	print(separator)
	print(report1)
	print(report2)
	print(separator)
	
	// Error handling demonstration
	list<Shape> largeShapes = filterLargeShapes(allShapes, 25.0) onError []
	print("Shapes with area >= 25.0:")
	iterate shape in largeShapes
		print("  " + shape.toString())
	
	// Advanced operations with precision modifiers
	integer:16 iterations = 100
	number:64 precision = 0.001
	
	integer:
		count = 0
		processed = 0
		errors = 0
	
	// Complex iteration with error handling
	iterate i in 0 to iterations
		Rectangle testRect = Rectangle(i.toString().toNumber(), i.toString().toNumber()) onError Rectangle(1.0, 1.0)
		if testRect.getArea() > precision
			processed = processed + 1
		count = count + 1
	
	// Final reporting using standard library
	print("Processing complete:")
	print("  Total iterations: " + count.toString())
	print("  Successfully processed: " + processed.toString())
	print("  Error rate: " + ((errors * 100) / count).toString() + "%")
	
	// Mathematical analysis of results
	number:64 averageArea = totalArea / allShapes.length()
	number:64 maxArea = Math.max(rect1.getArea(), Math.max(rect2.getArea(), Math.max(circle1.getArea(), circle2.getArea())))
	number:64 minArea = Math.min(rect1.getArea(), Math.min(rect2.getArea(), Math.min(circle1.getArea(), circle2.getArea())))
	
	print("Statistical analysis:")
	print("  Average area: " + averageArea.toString())
	print("  Maximum area: " + maxArea.toString())
	print("  Minimum area: " + minArea.toString())
	print("  Area variance: " + (maxArea - minArea).toString())
	
	// Final demonstration of method chaining and complex expressions
	string finalReport = String.concat(
		String.concat("Integration test completed with ", processed.toString()),
		String.concat(" shapes processed out of ", count.toString())
	)
	print(finalReport)
	
	print("All Clean Language features tested successfully!")