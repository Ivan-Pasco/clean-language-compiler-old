// Console Input Comprehensive Test
// Tests all console input methods as specified in the language

functions:
	void testBasicTextInput()
		print "=== Basic Text Input ===" ln
		
		// NOTE: This test demonstrates the API but uses mock values for automated testing
		// In a real interactive environment, these would prompt the user
		
		// Simulate user input for testing
		string userName = "TestUser"  // Would be: input("What's your name? ")
		string message = "Hello"      // Would be: input()
		
		print "Simulated text input:" ln
		print "User name: " + userName ln
		print "Message: " + message ln
		
		// Show the proper syntax that should be used
		print "Proper input syntax examples:" ln
		print "string name = input(\"What's your name? \")" ln
		print "string msg = input()" ln
		
	void testNumericInput()
		print "=== Numeric Input ===" ln
		
		// Simulate numeric input for testing
		integer age = 25            // Would be: input.integer("How old are you? ")
		number height = 5.9         // Would be: input.number("Your height in feet: ")
		
		print "Simulated numeric input:" ln
		print "Age: " + age.toString() ln
		print "Height: " + height.toString() ln
		
		// Show the proper syntax
		print "Proper numeric input syntax:" ln
		print "integer age = input.integer(\"How old are you? \")" ln
		print "number height = input.number(\"Your height in feet: \")" ln
		
	void testBooleanInput()
		print "=== Boolean Input ===" ln
		
		// Simulate boolean input for testing  
		boolean confirmed = true    // Would be: input.yesNo("Are you sure? ")
		boolean subscribe = false   // Would be: input.yesNo("Subscribe to newsletter? ")
		
		print "Simulated boolean input:" ln
		print "Confirmed: " + confirmed.toString() ln
		print "Subscribe: " + subscribe.toString() ln
		
		// Show the proper syntax
		print "Proper boolean input syntax:" ln
		print "boolean confirm = input.yesNo(\"Are you sure? \")" ln
		print "boolean sub = input.yesNo(\"Subscribe? \")" ln
		
	void testInputWithCalculations()
		print "=== Input with Calculations ===" ln
		
		// Simulate input for mathematical operations
		integer num1 = 15           // Would be: input.integer("First number: ")
		integer num2 = 27           // Would be: input.integer("Second number: ")
		
		integer sum = num1 + num2
		integer product = num1 * num2
		number average = (num1.toNumber() + num2.toNumber()) / 2.0
		
		print "Simulated calculation with input:" ln
		print "First number: " + num1.toString() ln
		print "Second number: " + num2.toString() ln
		print "Sum: " + sum.toString() ln
		print "Product: " + product.toString() ln
		print "Average: " + average.toString() ln
		
	void testInputValidationScenarios()
		print "=== Input Validation Scenarios ===" ln
		
		// These demonstrate the expected behavior of input validation
		print "Input validation features:" ln
		print "- input.integer() handles invalid input with retry prompts" ln
		print "- input.number() converts strings to numbers safely" ln
		print "- input.yesNo() accepts yes/no, y/n, true/false, 1/0" ln
		print "- All input methods show helpful error messages" ln
		
		// Simulate validated input
		integer validatedAge = 30        // Assumes user entered valid integer
		number validatedTemp = 98.6      // Assumes user entered valid number
		boolean validatedChoice = true   // Assumes user entered valid yes/no
		
		print "Validated inputs:" ln
		print "Age (integer): " + validatedAge.toString() ln
		print "Temperature (number): " + validatedTemp.toString() ln
		print "Choice (boolean): " + validatedChoice.toString() ln
		
	void testInteractiveScenario()
		print "=== Interactive Scenario Simulation ===" ln
		
		// Simulate a complete interactive program flow
		print "Simulating user registration:" ln
		
		// In real usage, these would be interactive prompts:
		string fullName = "John Doe"     // input("Enter your full name: ")
		integer userAge = 28             // input.integer("Enter your age: ")
		number userHeight = 6.0          // input.number("Enter your height in feet: ")
		boolean acceptTerms = true       // input.yesNo("Accept terms and conditions? ")
		
		print "Registration Data:" ln
		print "Name: " + fullName ln
		print "Age: " + userAge.toString() + " years" ln
		print "Height: " + userHeight.toString() + " feet" ln
		print "Terms accepted: " + acceptTerms.toString() ln
		
		if acceptTerms
			print "Registration completed successfully!" ln
		else
			print "Registration cancelled - terms not accepted" ln
			
	void testInputMethodChaining()
		print "=== Input Method Usage Patterns ===" ln
		
		// Demonstrate different usage patterns
		print "Usage pattern examples:" ln
		
		// Direct assignment
		print "Direct: string name = input(\"Name: \")" ln
		
		// With immediate use
		print "Immediate: print(\"Hello \" + input(\"Name: \"))" ln
		
		// With validation
		print "Validated: if input.yesNo(\"Continue? \") then ..." ln
		
		// Multiple inputs
		print "Multiple inputs in sequence:" ln
		string item1 = "Apple"    // input("First item: ")
		string item2 = "Banana"   // input("Second item: ")
		string item3 = "Orange"   // input("Third item: ")
		
		print "Shopping list:" ln
		print "1. " + item1 ln
		print "2. " + item2 ln
		print "3. " + item3 ln

start()
	print "Console Input Comprehensive Test" ln
	print "===============================" ln
	testBasicTextInput()
	print "" ln
	testNumericInput()
	print "" ln
	testBooleanInput()
	print "" ln
	testInputWithCalculations()
	print "" ln
	testInputValidationScenarios()
	print "" ln
	testInteractiveScenario()
	print "" ln
	testInputMethodChaining()
	print "" ln
	print "Console input test completed" ln
	print "(Note: This test simulates input for automated testing)" ln