// Fixed: was an endpoints: block with no plugins: declaration, spec requires the owning plugin declared in the program file (foundation/docs/specification 1.0/22-plugin-system.md, "Example: HTTP Endpoints Plugin")
plugins:
	frame.server

start:
	Router router = Router()
	print("API server ready")
	// Note: __frame_register_routes() would be generated by WebPlugin
	// When used with a framework compiler that provides plugins
	listUsers()
// Test Clean Frame endpoints: DSL block - simple version without path params
// This should be expanded by the WebPlugin into router registration code

class Router
	constructor()

	functions:
		void get(string path, any handler)
			print("Registered GET " + path)

		void post(string path, any handler)
			print("Registered POST " + path)

functions:
	void listUsers()
		print("Listing all users")

	void createUser()
		print("Creating new user")

// Fixed: was `GET "/users" -> listUsers` (arrow form), spec requires
// `GET "/path":` with an indented handler body and `:name` path segments
// (foundation/spec/framework/grammar/frame-server.ebnf route_declaration, route_path)
endpoints:
	GET "/users":
		listUsers()
		return "ok"

	POST "/users":
		createUser()
		return "created"

