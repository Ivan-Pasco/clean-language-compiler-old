// Parser Compliance Test - Type System
// This test verifies all type declarations and complex type constructs

start:
	// Core types
	boolean bool_val = true
	integer int_val = 42
	number num_val = 3.14
	string str_val = "test"
	any generic_val = 100

	// Sized types with precision modifiers
	integer:8 small_int = 127
	integer:16 medium_int = 32767
	integer:32 large_int = 2000000000
	number:32 float_32 = 3.14
	number:64 double_64 = 2.718281828

	// Container types
	list<integer> int_list = [1, 2, 3, 4, 5]
	list<string> str_list = ["a", "b", "c"]
	list<boolean> bool_list = [true, false, true]

	// Matrix types temporarily disabled due to parsing issue
	// matrix<integer> int_matrix = [[1, 2], [3, 4]]
	// matrix<number> float_matrix = [[1.1, 2.2], [3.3, 4.4]]

	// Pairs types
	pairs<string, integer> str_int_pairs = {"key1": 1, "key2": 2}
	pairs<integer, boolean> int_bool_pairs = {1: true, 2: false}

	// Nested generic types
	// list<list<integer> > nested_list = [[1, 2], [3, 4]]  // Matrix parsing issue
	// matrix<list<string> > matrix_of_lists = [["a", "b"], ["c", "d"]]  // Matrix parsing issue
	pairs<string, list<integer>> pairs_with_list = {"nums": [1, 2, 3]}

	// Complex nested types
	// list<pairs<string, integer>> list_of_pairs = [{"a": 1}, {"b": 2}]  // TODO: Fix pairs literal type inference in arrays
	// pairs<string, matrix<number> > pairs_with_matrix = {"data": [[1.0, 2.0]]}  // Matrix parsing issue

	print("Core types working")
	print("Sized types working")
	print("Container types working")
	print("Nested types working")

functions:
	// Function with various parameter and return types
	integer simpleFunction(integer a, string b)
		return a

	// Function with generic types
	any genericFunction(any input)
		return input

	// Function with complex types (matrix disabled due to parsing issue)
	// list<integer> complexFunction(matrix<number> data, pairs<string, boolean> config)
	//	return [1, 2, 3]

	// Function with sized types
	integer:16 precisionFunction(integer:8 small, number:32 precise)
		return small

class TypedClass
	// Class fields with various types
	integer id
	string name
	list<number> values
	pairs<string, any> metadata

	constructor(integer initial_id, string initial_name)
		id = initial_id
		name = initial_name
		values = []
		metadata = {}

	functions:
		// Method returning complex type
		pairs<string, list<integer>> getComplexData()
			return {"data": [1, 2, 3]}

		// Method with generic return
		any getGeneric()
			return name