// Test: control/loops/iterate_list_number
// Grammar: iterate_statement (foundation/spec/grammar.ebnf)
// Regression for RUNTIME_ITERATE_LIST_NUMBER_WRONG_LOAD (dashboard fingerprint b5a38d8411e8):
// GetElementPtr codegen hardcoded a 4-byte per-element stride, so iterating a list<number>
// (f64 elements stored at 8-byte stride) decoded every element after the first as garbage.
// The MIR builder now types the GEP destination as Ptr<element_type> and the codegen
// reads the inner T to pick 4-byte vs 8-byte stride. Direct array access (list[i]) shares
// the same path and was equally broken — the second test block covers it.
//
// Expected output:
//   1.5
//   2.5
//   3.5
//   --
//   1.5
//   2.5
//   3.5

start:
	list<number> values = [1.5, 2.5, 3.5]
	iterate v in values
		print(v)
	print("--")
	print(values[0])
	print(values[1])
	print(values[2])
