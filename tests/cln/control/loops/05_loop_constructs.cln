// Test Description: While and iterate loop constructs
// Category: control
// Dependencies: none
// Expected: PASS

start()
	// While loop
	integer counter = 0
	while counter < 3
		print("Counter: " + counter.toString())
		counter = counter + 1

	// Iterate loop with range
	iterate i in 1 to 5
		print("Iteration: " + i.toString())

	print("Loop constructs test successful!")