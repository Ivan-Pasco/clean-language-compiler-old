// Test Description: Iterate loop constructs
// Category: control
// Dependencies: none
// Expected: PASS

start:
	// Iterate loop with range (0-2)
	iterate counter in 0 to 2
		print("Counter: " + counter.toString())

	// Iterate loop with range (1-5)
	iterate i in 1 to 5
		print("Iteration: " + i.toString())

	print("Loop constructs test successful!")