// Fixed: was using `print(x) +` for one value per line; grammar.ebnf print_parenthesized_statement
// prints a newline, while `print(x) +` (print_newline_statement) continues the line.
// Fixed: was using `x is not y`; grammar.ebnf comparison_op has only `is`, so the
// negated comparison is written `not (x is y)` (unary_op "not" on a parenthesised
// comparison). The expected output is unchanged.
// Test: control/conditionals/is_not_operator
// Grammar: comparison_expression → expr 'is' expr; unary_expression → 'not' primary
// Semantic: SEM001 (tracking: SEM-COMPARE-01 — `is` operator typing)
// Expected output:
//   a is b: true
//   c is not d: true
//   not of true: false
//   x is not y: ok

start:
	// Test `is` for equality (same integer value)
	integer a = 42
	integer b = 42
	if a is b
		print("a is b: true")
	else
		print("a is b: false")

	// Test negated `is` for inequality (different integer values)
	integer c = 42
	integer d = 99
	if not (c is d)
		print("c is not d: true")
	else
		print("c is not d: false")

	// Test unary `not` on a boolean variable
	boolean flag = true
	boolean negated = not flag
	if negated
		print("not of true: true")
	else
		print("not of true: false")

	// Test negated `is` once more
	integer x = 5
	integer y = 10
	if not (x is y)
		print("x is not y: ok")
	else
		print("x is not y: fail")
