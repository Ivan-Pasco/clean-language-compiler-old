// Test more complex onError scenarios
functions:
	integer divide(integer a, integer b)
		if b == 0
			error("Division by zero")
		return a / b

	string getFile(string name)
		if name == "bad"
			error("File not found")
		return "content of " + name

	void testComplexOnError()
		// Test nested onError with expressions
		integer divResult = divide(10, 2)
		integer result1 = (divResult + 5) onError 42
		print("Complex expr: " + result1.toString())
		// Test onError in function arguments
		integer divResult2 = divide(5, 1)
		integer result2 = divide(20, divResult2)
		print("OnError in args: " + result2.toString())
		// Test string onError
		string content = getFile("bad") onError "default content"
		print("String onError: " + content)
start()
	testComplexOnError()