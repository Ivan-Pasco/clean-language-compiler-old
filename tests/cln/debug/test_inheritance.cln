// Test inheritance with method override
// Tests class Child is Parent and method resolution

class Animal
	string name

	constructor(string nameParam)
		name = nameParam

	functions:
		string speak()
			return "Generic animal sound"

class Dog is Animal
	string breed

	constructor(string nameParam, string breedParam)
		base(nameParam)
		breed = breedParam

	functions:
		string speak()
			return "Woof! I am " + name

start()
	// Test inheritance and method override
	Animal generic = Animal("Unknown")
	Dog buddy = Dog("Buddy", "Golden Retriever")

	string sound1 = generic.speak()
	string sound2 = buddy.speak()

	print("Inheritance test complete")