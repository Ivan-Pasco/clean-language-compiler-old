// Test apply blocks - all variants
// Tests constant, type, method, and function apply blocks

class DataProcessor
	functions:
		void process(string data)
			print(data)

start()
	// Test constant apply block
	constant:
		integer MAX_SIZE = 100
		string APP_NAME = "TestApp"

	// Test type apply block
	integer:
		count = 0
		maxValue = MAX_SIZE

	// Test method apply block
