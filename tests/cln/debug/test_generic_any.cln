// Test generic 'any' type support
// Tests any type parsing and constraint solving

class Container
	any value

	constructor(any valueParam)
		value = valueParam

	functions:
		any getValue()
			return value

// Generic function with any parameters
functions:
	any identity(any input)
		return input

start()
	// Test any type with different values
	Container stringContainer = Container("Hello")
	Container numberContainer = Container(42)
	Container boolContainer = Container(true)

	// Test generic function
	string result1 = identity("test")
	integer result2 = identity(100)

	print("Generic any type test complete")