// Test that return works both with and without parentheses

functions:
	// Return without parentheses (preferred)
	integer getNumber()
		return 42

	// Return with expression
	string getMessage()
		return "Hello, World!"

	// Return with computation
	integer add(integer a, integer b)
		return a + b

	// Empty return (void function)
	void doSomething()
		integer x = 5
		return

start()
	print(getNumber())
	print(getMessage())
	print(add(10, 20))
	doSomething()
