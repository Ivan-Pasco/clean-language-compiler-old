// Test onError syntax
// Tests on_error_expr and on_error_block rules

functions:
	integer divide(integer a, integer b)
		return a / b

start()
	// Test onError expression
	integer result1 = divide(10, 2) onError 0
	integer result2 = divide(10, 0) onError -1

	// Test onError block
	divide(5, 0) onError:
		print("Division by zero handled")
		integer fallback = 0

	print("Error handling test complete")