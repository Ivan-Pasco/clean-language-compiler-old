// Test more complex onError scenarios
functions:
	integer divide(integer a, integer b)
		if b == 0
			error("Division by zero")
		return a / b
		
	string getFile(string name)
		if name == "bad"
			error("File not found")
		return "content of " + name

	void testComplexOnError()
		// Test nested onError with expressions
		integer result1 = (divide(10, 0) + 5) onError 42
		print "Complex expr: " + result1.toString() ln
		
		// Test onError in function arguments
		integer result2 = divide(20, (divide(5, 0) onError 2))
		print "OnError in args: " + result2.toString() ln
		
		// Test string onError  
		string content = getFile("bad") onError "default content"
		print "String onError: " + content ln

start()
	testComplexOnError()