class Base
	string name

	constructor(string baseName)
		name = baseName

class Child is Base
	boolean flag

	constructor(string childName, boolean childFlag)
		base(childName)
		flag = childFlag

	functions:
		string first()
			if flag
				return name + " first true"
			else
				return name + " first false"

		string second()
			return name + " second"