// Test pairs type as method return type

class TestClass
	integer id

	constructor(integer initial_id)
		id = initial_id

	functions:
		// Method returning pairs type
		pairs<string, integer> getSimplePairs()
			return {"key": 42}

		// Method returning nested pairs type
		pairs<string, list<integer>> getComplexPairs()
			return {"data": [1, 2, 3]}

start()
	TestClass obj = TestClass(100)
	pairs<string, integer> simple = obj.getSimplePairs()
	pairs<string, list<integer>> complex = obj.getComplexPairs()
	print("Method return types work")
