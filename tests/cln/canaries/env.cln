// Test: canaries/env
// Namespace: env (Layer 2, server + node-server)
// Registry entries covered: _env_get
// Grammar: 5.3 function calls
// Semantic: FUNC-001 bridge function resolution
// Notes: env.get returns the value of an OS environment variable. The canary
//   reads a variable that is intentionally not set so the returned string is
//   deterministic across hosts (empty). Layer 2 hosts implement _env_get;
//   the local wasmtime_runner stubs it to return empty.
// Expected output:
//   len:0
//   ok

start:
	string v = env.get("CLEAN_CANARY_UNSET_9f8e7d")
	printl("len:" + v.length().toString())
	printl("ok")
