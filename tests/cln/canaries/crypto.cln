// Test: canaries/crypto
// Namespace: crypto (Layer 2, all hosts)
// Registry entries covered: _crypto_hash_sha256, _crypto_hash_sha512,
//   _crypto_hmac, _crypto_hash_password, _crypto_verify_password,
//   _crypto_random_hex, _crypto_random_bytes
// Grammar: 5.3 function calls (via frame.auth crypto namespace)
// Semantic: FUNC-001 bridge function resolution
// Expected output:
//   sha256:2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824
//   sha512:9b71d224bd62f3785d96d46ad3ea3d73319bfbc2890caadae2dff72519673ca72323c3d99ba5c11d7c7acc6e14b8c5da0c4663475c2e5c3adef46f73bcdec043
//   hmac:ok
//   hash:ok
//   verify:true
//   random:ok

plugins:
	frame.auth

start:
	string h256 = crypto.sha256("hello")
	printl("sha256:" + h256)
	string h512 = crypto.sha512("hello")
	printl("sha512:" + h512)
	string mac = crypto.hmac("data", "key", "sha256")
	if mac.length() > 0
		printl("hmac:ok")
	string hashed = crypto.hashPassword("s3cret")
	if hashed.length() > 0
		printl("hash:ok")
	boolean ok = crypto.verifyPassword("s3cret", hashed)
	printl("verify:" + ok.toString())
	string hex = crypto.randomHex(8)
	if hex.length() == 16
		printl("random:ok")
