// Test: canaries/crypto_password
// Namespace: crypto password (Layer 2, server)
// Registry entries covered: _crypto_hash_password, _crypto_verify_password
// Grammar: 5.3 function calls (via frame.auth crypto namespace)
// Semantic: FUNC-001 bridge function resolution
// Notes: Password hashing is bcrypt and server-only (function-registry.toml
//   hosts = ["server"]); a browser build that calls it fails at compile time
//   with BRIDGE-HOST-MISMATCH.
// Expected output:
//   hash:ok
//   verify:true
//   wrong:false

plugins:
	frame.auth

start:
	string hashed = crypto.hashPassword("s3cret")
	if hashed.length() > 0
		printl("hash:ok")
	boolean ok = crypto.verifyPassword("s3cret", hashed)
	printl("verify:" + ok.toString())
	boolean wrong = crypto.verifyPassword("other", hashed)
	printl("wrong:" + wrong.toString())
