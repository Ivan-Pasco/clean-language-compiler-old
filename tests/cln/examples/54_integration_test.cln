// Comprehensive Integration Test
// Tests combinations of all new syntax patterns.
// Visibility model (2026-06-25): module functions are PRIVATE by default;
// a `public:` sub-section inside `functions:` exposes the listed functions
// to importing modules (SEM005). Helpers stay outside `public:`.

import:
	math
	string
	list
	http

start:
	// Test complex integration scenario
	print("Starting integration test...")

	// Combine static methods with method-style calls (simplified)
	number value = math.sqrt(144.0)
	string valueText = value.toString() + "_computed"
	print("Computed value: " + valueText)

	// Test HTTP and validation (simplified without async)
	string apiStatus = http.get("https://api.example.com/status")

	// Use input methods with validation chains (simplified)
	string testInput = input("Enter test data: ")
	string cleanInput = testInput  // Direct assignment until trim is fixed
	if string.isEmpty(cleanInput)
		return

	// Test method chaining with HTTP results
	boolean validStatus = string.size(apiStatus) > 0
	print("API status valid: " + validStatus.toString())

	// Test static method combinations
	list<integer> numbers = [5, 2, 8, 1, 9]
	integer listLength = list.size(numbers)
	number maxValueFloat = math.max(8.0, 9.0)
	integer maxValue = maxValueFloat.toInteger()

	print("list length: " + listLength.toString())
	print("Max value: " + maxValue.toString())

	// Test HTTP operations with method calls
	string analytics = http.post("https://api.example.com/analytics", "event=test_completed")

	// Test comprehensive user processing
	boolean userProcessed = processUserInput()
	print("User processing result: " + userProcessed.toString())

	// Test data fetching and processing
	list<string> processedData = fetchAndProcessData()
	integer dataCount = list.size(processedData)
	print("Processed data items: " + dataCount.toString())

	// Final validation with all patterns
	string finalMessage = "Integration test completed successfully!"
	boolean messageEmpty = string.isEmpty(finalMessage)
	boolean messageValid = string.size(finalMessage) > 0

	print("Final message valid: " + messageValid.toString())
	print(finalMessage)

functions:
	// Private helpers (default — no annotation needed). Callable inside
	// this file. NOT callable from importing modules.
	boolean internalValidation(string data)
		return string.size(data) > 0

	string secretKey()
		return "secret-api-key-123"

	void logUserAction(string action)
		integer timestamp = 123456
		print("LOG [" + timestamp.toString() + "]: " + action)

	void clearCache()
		print("Cache cleared in background")

	public:
		// Public API exported to other modules.
		boolean processUserInput()
			// Get user data with input methods
			string name = input("Enter your name: ")
			integer age = input.integer("Enter your age: ")
			boolean confirmed = input.yesNo("Confirm registration? ")

			// Validate using basic conditions
			if string.isEmpty(name)
				return false
			if age <= 0
				return false
			if age >= 150
				return false

			// Process using basic operations for now
			string cleanName = name
			integer validAge = age
			if validAge < 18
				validAge = 18
			if validAge > 120
				validAge = 120

			// Use HTTP methods for data submission
			string userData = "name=" + cleanName + "&age=" + validAge.toString()
			string response = http.post("https://api.example.com/users", userData)

			// Logging — calls private helper in this file (allowed)
			logUserAction("User registration attempted")

			// Return simple boolean result
			if confirmed
				if string.size(response) > 0
					return true
				else
					return false
			else
				return false

		list<string> fetchAndProcessData()
			string data1 = http.get("https://api.example.com/data1")
			string data2 = http.get("https://api.example.com/data2")
			string data3 = http.get("https://api.example.com/data3")

			list<string> results = []

			if string.isEmpty(data1)
				return []
			if string.isEmpty(data2)
				return []
			if string.isEmpty(data3)
				return []

			string processed1 = data1 + "_processed"
			string processed2 = data2 + "_processed"
			string processed3 = data3 + "_processed"

			list.add(results, processed1)
			list.add(results, processed2)
			list.add(results, processed3)

			return results
