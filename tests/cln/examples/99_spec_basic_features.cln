start:
	print("=== Clean Language Basic Specification Test ===")

	// 1. Basic types
	print("1. Basic Types:")
	integer num = 42
	string text = "Clean Language"
	boolean flag = true
	number decimal = 3.14

	print("Integer: " + num.toString())
	print("String: " + text)
	print("Boolean: " + flag.toString())
	print("Number: " + decimal.toString())

	// 2. Function calls
	print("2. Function Calls:")
	string greeting = getMessage()
	print("Message: " + greeting)

	string prefixed = addPrefix("Test")
	print("Prefixed: " + prefixed)

	showMessage("Void function call")

	// 3. Built-in method calls
	print("3. Built-in Methods:")
	string upper = text.toUpperCase()
	string lower = text.toLowerCase()
	integer len = text.length()

	print("Upper: " + upper)
	print("Lower: " + lower)
	print("Length: " + len.toString())

	// 4. Math operations
	print("4. Math Operations:")
	integer a = 10
	integer b = 5
	integer sum = a + b
	integer diff = a - b
	integer prod = a * b

	print("10 + 5 = " + sum.toString())
	print("10 - 5 = " + diff.toString())
	print("10 * 5 = " + prod.toString())

	// 5. String concatenation
	print("5. String Operations:")
	string part1 = "Clean"
	string part2 = "Language"
	string combined = part1 + " " + part2
	print("Combined: " + combined)

	// 6. Namespace function calls
	print("6. Namespace Functions:")
	number absolute = math.abs(-15)
	print("math.abs(-15) = " + absolute.toString())

	print("=== Basic Specification Test Completed ===")// Clean Language Basic Specification Features Test

functions:
	// Simple function with direct return
	string getMessage()
		return "Hello World"

	// Function with parameter
	string addPrefix(string text)
		return "PREFIX: " + text

	// Void function
	void showMessage(string msg)
		print("[MSG] " + msg)

