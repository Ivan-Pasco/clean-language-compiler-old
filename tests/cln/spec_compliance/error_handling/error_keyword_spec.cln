// Spec Section: 10.1 - Raising Errors
// Tests: error() keyword for raising errors

functions:
	integer safeDivide(integer a, integer b)
		if b == 0
			error("Cannot divide by zero")
		return a / b

	string validateInput(integer value)
		if value < 0
			error("Value must be non-negative")
		return "Valid: " + value.toString()

	integer checkRange(integer value, integer min, integer max)
		if value < min
			error("Value below minimum")
		if value > max
			error("Value above maximum")
		return value

start:
	// Test 1: Safe division (no error case)
	integer result1 = safeDivide(10, 2)
	print("10 / 2 = " + result1.toString())

	// Test 2: Validate positive input
	string valid = validateInput(42)
	print(valid)

	// Test 3: Check range (valid case)
	integer rangeResult = checkRange(50, 0, 100)
	print("Range check: " + rangeResult.toString())

	print("Error keyword test completed")
