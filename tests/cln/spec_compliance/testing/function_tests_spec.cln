start:
	// Test at runtime
	integer sum = add(10, 20)
	print("add(10, 20) = " + sum.toString())

	integer product = multiply(6, 7)
	print("multiply(6, 7) = " + product.toString())

	boolean positive = isPositive(5)
	print("isPositive(5) = " + positive.toString())

	print("Function tests specification completed")
// Spec Section: 7 - Testing Framework
// Tests: Testing functions within tests block
// Requirement: Test block can verify function behavior

functions:
	integer add(integer a, integer b)
		return a + b

	integer multiply(integer x, integer y)
		return x * y

	boolean isPositive(integer n)
		return n > 0

tests:
	"add returns sum": add(2, 3) = 5
	"add zero": add(0, 5) = 5
	"multiply returns product": multiply(4, 5) = 20
	"multiply by zero": multiply(10, 0) = 0
	"multiply by one": multiply(7, 1) = 7

