start:
	// Test Counter at runtime
	Counter c = Counter()
	print("Initial value: " + c.getValue().toString())

	c.increment()
	print("After increment: " + c.getValue().toString())

	c.increment()
	c.increment()
	print("After 2 more increments: " + c.getValue().toString())

	// Test Calculator at runtime
	Calculator calc = Calculator()
	integer sum = calc.add(15, 25)
	print("calc.add(15, 25) = " + sum.toString())

	integer diff = calc.subtract(100, 30)
	print("calc.subtract(100, 30) = " + diff.toString())

	print("Method tests specification completed")
// Spec Section: 7 - Testing Framework
// Tests: Testing class methods
// Requirement: Test block can verify class method behavior

class Counter
	integer value

	constructor()
		value = 0

	functions:
		public:
			void increment()
				value = value + 1

			integer getValue()
				return value

class Calculator
	functions:
		public:
			integer add(integer a, integer b)
				return a + b

			integer subtract(integer a, integer b)
				return a - b

	tests:
		"basic arithmetic": 2 + 2 = 4
		"subtraction": 10 - 3 = 7
		"calculator pattern": 5 * 4 = 20

