// Spec Section: 6.2 - File I/O Module
// Tests: file.lines() function to read file as list of lines
// STATUS: This requires file.lines() implementation
// Currently using file.read() as workaround

start:
	// Test case 1: Read file content
	string content = file.read("test_data.txt")
	print("File content: " + content)

	// Test case 2: Check if file exists before reading
	boolean exists = file.exists("test_data.txt")
	if exists
		string data = file.read("test_data.txt")
		print("Read data: " + data)
	else
		print("File does not exist")

	print("File lines tests completed")
