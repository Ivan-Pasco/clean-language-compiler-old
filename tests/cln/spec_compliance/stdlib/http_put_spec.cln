// Spec Section: 6.3 - HTTP Module
// Tests: http.put() function for HTTP PUT requests
// Requirement: Perform HTTP PUT request with data and return response

start()
	// Test case 1: Basic PUT request
	string url = "https://httpbin.org/put"
	string data = "id=1&name=updated"
	string response = http.put(url, data)
	print("PUT response received")

	// Test case 2: PUT with resource update
	string resourceUrl = "https://httpbin.org/put"
	string updateData = "status=active&modified=true"
	string updateResponse = http.put(resourceUrl, updateData)
	print("Resource update response received")

	print("HTTP PUT tests completed")
