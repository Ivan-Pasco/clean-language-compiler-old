// Spec Section: 14.3 - List Advanced Search Operations
// Tests: list.indexOf with various scenarios
//
// Changed in 0.33.184: `list.<method>(items, ...)` namespace calls are now the
// method form `items.<method>(...)`; the `list.` namespace has only concat,
// range, fill and join (developer decision)

start:
	// Test 1: indexOf - find first occurrence
	list<integer> numbers = [10, 20, 30, 20, 40]
	integer index1 = numbers.indexOf(20)
	print("First index of 20: " + index1.toString())

	// Test 2: indexOf - element not found returns -1
	integer notFound = numbers.indexOf(99)
	print("Index of 99: " + notFound.toString())

	// Test 3: indexOf with strings
	list<string> names = ["Alice", "Bob", "Charlie", "Bob"]
	integer bobIndex = names.indexOf("Bob")
	print("First Bob index: " + bobIndex.toString())

	// Test 4: indexOf at beginning
	list<integer> data = [5, 10, 15, 20]
	integer firstPos = data.indexOf(5)
	print("Index of first element: " + firstPos.toString())

	// Test 5: indexOf at end
	integer lastPos = data.indexOf(20)
	print("Index of last element: " + lastPos.toString())

	// Test 6: contains - check existence
	list<string> fruits = ["apple", "banana", "orange"]
	boolean hasApple = fruits.contains("apple")
	boolean hasGrape = fruits.contains("grape")
	print("Has apple: " + hasApple.toString())
	print("Has grape: " + hasGrape.toString())

	// Test 7: contains with integers
	list<integer> scores = [85, 92, 78, 96]
	boolean has92 = scores.contains(92)
	boolean has100 = scores.contains(100)
	print("Has 92: " + has92.toString())
	print("Has 100: " + has100.toString())

	print("List advanced search test completed")
