// Test: spec_compliance/types/list_behaviors_spec
// Grammar: list_behavior, list_type
// Semantic: SEM001 — list behavior modifier (.line/.pile/.unique) must be assigned to list variable
// Expected output: (see inline comments per test)

start:
	// Test 1: Line behavior (FIFO queue)
	// Fixed: was list<integer> queue = [] + queue.type = "line", spec requires list<integer>.line queue = []
	list<integer>.line queue = []
	queue.add(1)
	queue.add(2)
	queue.add(3)
	integer first = queue.remove()
	print("FIFO queue first element: " + first.toString())

	// Test 2: Pile behavior (LIFO stack)
	// Fixed: was list<integer> stack = [] + stack.type = "pile", spec requires list<integer>.pile stack = []
	list<integer>.pile stack = []
	stack.add(10)
	stack.add(20)
	stack.add(30)
	integer top = stack.remove()
	print("LIFO stack top element: " + top.toString())

	// Test 3: Unique behavior (set)
	// Fixed: was list<integer> uniqueSet = [] + uniqueSet.type = "unique", spec requires list<integer>.unique uniqueSet = []
	list<integer>.unique uniqueSet = []
	uniqueSet.add(5)
	uniqueSet.add(10)
	uniqueSet.add(5)
	integer size = uniqueSet.length()
	print("Unique set size (should be 2): " + size.toString())

	print("List behaviors test completed")
