// Spec Section: 3.1 - Core Types (void)
// Tests: void type - functions with no return value

functions:
	void printMessage(string msg)
		print("Message: " + msg)

	void printNumber(integer n)
		print("Number: " + n.toString())

	void doNothing()
		// Function body can be empty or have no return
		integer x = 1

	void printTwice(string text)
		print(text)
		print(text)

	void conditionalPrint(boolean shouldPrint, string msg)
		if shouldPrint
			print(msg)

	void processAndPrint(integer a, integer b)
		integer sum = a + b
		print("Sum: " + sum.toString())

start:
	// Test 1: Call void function with string
	printMessage("Hello from void function")

	// Test 2: Call void function with integer
	printNumber(42)

	// Test 3: Call void function with no visible effect
	doNothing()
	print("doNothing completed")

	// Test 4: Void function that prints multiple times
	printTwice("Repeated message")

	// Test 5: Void function with conditional logic
	conditionalPrint(true, "This should print")
	conditionalPrint(false, "This should NOT print")

	// Test 6: Void function with computation
	processAndPrint(10, 20)

	// Test 7: Multiple void function calls
	printMessage("First")
	printMessage("Second")
	printMessage("Third")

	print("Void type test completed")
