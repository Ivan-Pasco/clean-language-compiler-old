// Test: spec_compliance/types/list_behavior_enforcement
// Grammar: list_type = "list" , "<" , type , ">" , [ list_behavior ] ;
//          list_behavior = "." , ( "line" | "pile" | "unique" | combinations ) ;
// Semantic: Behavior flags are stored at offset 12 of the list header and are
//           read at runtime by list.add (unique enforcement) and list.remove
//           (FIFO vs LIFO selection).
// Expected output:
//   pile ok
//   unique ok
//   line ok
//   pile LIFO: 3
//   unique size: 2
//   line FIFO: 10

start:
	// Test 1: .pile modifier — declaration compiles and add/print works
	list<integer>.pile myStack = []
	myStack.add(1)
	myStack.add(2)
	print("pile ok")

	// Test 2: .unique modifier — declaration compiles and add/print works
	list<string>.unique myNames = []
	myNames.add("alice")
	myNames.add("alice")
	print("unique ok")

	// Test 3: .line modifier — declaration compiles and add/print works
	list<integer>.line myQueue = []
	myQueue.add(10)
	myQueue.add(20)
	print("line ok")

	// Test 4: .pile runtime behavior — LIFO (last-in first-out)
	list<integer>.pile stack = []
	stack.add(1)
	stack.add(2)
	stack.add(3)
	integer top = stack.remove()
	print("pile LIFO: " + top.toString())

	// Test 5: .unique runtime behavior — no duplicates
	list<integer>.unique ulist = []
	ulist.add(5)
	ulist.add(10)
	ulist.add(5)
	integer sz = ulist.length()
	print("unique size: " + sz.toString())

	// Test 6: .line runtime behavior — FIFO (first-in first-out)
	list<integer>.line queue = []
	queue.add(10)
	queue.add(20)
	queue.add(30)
	integer front = queue.remove()
	print("line FIFO: " + front.toString())
