// Test: spec_compliance/types/list_behavior_enforcement
// Grammar: list_type = "list" , "<" , type , ">" , [ list_behavior ] ;
//          list_behavior = "." , ( "line" | "pile" | "unique" | combinations ) ;
// Semantic: Behavior modifiers are parsed as part of the list_type production.
//           The grammar production list_behavior is nested inside list_type,
//           so these modifiers are syntactically impossible on non-list types.
//           No separate typechecker check is needed — grammar prevents invalid use
//           at parse time (RESOLVED per TASKS.md).
// Expected output:
//   pile ok
//   unique ok
//   line ok

start:
	// Valid: .pile modifier on list<integer> declaration
	list<integer>.pile myStack = []
	myStack.add(1)
	myStack.add(2)
	print("pile ok")

	// Valid: .unique modifier on list<string> declaration
	list<string>.unique myNames = []
	myNames.add("alice")
	myNames.add("alice")
	print("unique ok")

	// Valid: .line modifier on list<integer> declaration
	list<integer>.line myQueue = []
	myQueue.add(10)
	myQueue.add(20)
	print("line ok")

	// Note: applying .pile/.unique/.line to a non-list type is impossible in
	// the grammar — list_behavior only appears inside list_type, which requires
	// "list" "<" type ">" before any behavior suffix. Any attempt to use these
	// keywords as modifiers on integer/string/boolean/etc. types either:
	//   (a) is rejected as a syntax error at parse time, or
	//   (b) is parsed as a method call (e.g. myInt.pile) and fails semantic
	//       analysis with "method pile not found on integer".
	// In either case the compiler catches invalid use before code generation.
