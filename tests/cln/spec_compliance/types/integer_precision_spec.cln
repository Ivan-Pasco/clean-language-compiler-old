// Test: spec_compliance/types/integer_precision_spec
// Grammar: sized_type, size_specifier, core_type
// Semantic: SEM001 — sized integer literals must fit declared precision
// Expected output: (see inline comments per test)

start:
	// Test 1: Standard 32-bit integer
	integer standard = 2147483647
	print("Standard integer: " + standard.toString())

	// Test 2: 8-bit integer
	integer:8 small = 127
	print("8-bit integer: " + small.toString())

	// Test 3: 8-bit negative
	integer:8 smallNeg = -128
	print("8-bit negative: " + smallNeg.toString())

	// Test 4: 16-bit integer
	integer:16 medium = 32767
	print("16-bit integer: " + medium.toString())

	// Test 5: 16-bit negative
	integer:16 mediumNeg = -32768
	print("16-bit negative: " + mediumNeg.toString())

	// Test 6: 32-bit integer (explicit)
	integer:32 large = 2147483647
	print("32-bit integer: " + large.toString())

	// Test 7: 64-bit integer
	integer:64 huge = 9223372036854775807
	print("64-bit integer: " + huge.toString())

	// Test 8: 8-bit unsigned
	integer:8u smallUnsigned = 255
	print("8-bit unsigned: " + smallUnsigned.toString())

	// Test 9: 16-bit unsigned
	integer:16u mediumUnsigned = 65535
	print("16-bit unsigned: " + mediumUnsigned.toString())

	// Test 10: 32-bit unsigned
	integer:32u largeUnsigned = 4294967295
	print("32-bit unsigned: " + largeUnsigned.toString())

	// Test 11: Arithmetic with different sizes
	integer:8 a = 10
	integer:8 b = 20
	integer:8 sum8 = a + b
	print("8-bit sum: " + sum8.toString())

	// Test 12: Type mixing (should promote to larger type)
	integer:16 c = 100
	integer:16 d = 200
	integer:16 sum16 = c + d
	print("16-bit sum: " + sum16.toString())

	print("Integer precision test completed")
