// Spec Section: grammar §6.8a - public_state_section inside state:
// Feature: public: sub-section inside state: block
// Grammar: public_state_section = "public" ":" NEWLINE INDENT state_declaration+
// Tests: state block with a public: section; private state is internal-only,
//        public state can be imported by other modules.
// Visibility model (2026-06-25): state declarations are PRIVATE by default;
// a `public:` sub-section inside `state:` exposes the declarations to
// importing modules (SEM005).

start:
	print("Score: " + score.toString())
	addPoints(10)
	print("After +10: " + score.toString())
	addPoints(5)
	print("After +5: " + score.toString())
	print("State public section test passed")

state:
	// Private state (default — no annotation needed). Accessible only
	// from within this file.
	integer bonus = 0

	public:
		// Exposed to importing modules.
		integer score = 0

functions:
	public:
		void addPoints(integer points)
			score = score + points
