start:
	// Test 1: Parent class method
	Vehicle vehicle = Vehicle("Generic", 60)
	string vehicleDesc = vehicle.describe()
	print("Vehicle: " + vehicleDesc)
	print("Vehicle max speed: " + vehicle.getMaxSpeed().toString())

	// Test 2: Car with overridden method
	Car car = Car("Toyota", 70, 4)
	string carDesc = car.describe()
	print("Car: " + carDesc)
	print("Car max speed: " + car.getMaxSpeed().toString())

	// Test 3: SportsCar with turbo
	SportsCar turboSports = SportsCar("Ferrari", 90, true)
	string turboDesc = turboSports.describe()
	print("Turbo sports: " + turboDesc)
	print("Turbo max speed: " + turboSports.getMaxSpeed().toString())

	// Test 4: SportsCar without turbo
	SportsCar normalSports = SportsCar("Porsche", 85, false)
	string normalDesc = normalSports.describe()
	print("Normal sports: " + normalDesc)
	print("Normal max speed: " + normalSports.getMaxSpeed().toString())

	// Test 5: Access inherited field through child
	print("Car brand (inherited): " + car.brand)
	print("SportsCar brand (inherited): " + turboSports.brand)

	print("Method override tests completed")
// Spec Section: 9.3 - Inheritance Features
// Tests: Method overriding in child classes

class Vehicle
	string brand
	integer speed

	constructor(string vehicleBrand, integer vehicleSpeed)
		brand = vehicleBrand
		speed = vehicleSpeed

	functions:
		string describe()
			return brand + " vehicle at " + speed.toString() + " mph"

		integer getMaxSpeed()
			return 100

class Car is Vehicle
	integer numDoors

	constructor(string carBrand, integer carSpeed, integer doors)
		base(carBrand, carSpeed)
		numDoors = doors

	functions:
		// Override parent method
		string describe()
			return brand + " car with " + numDoors.toString() + " doors at " + speed.toString() + " mph"

		// Override max speed
		integer getMaxSpeed()
			return 150

class SportsCar is Vehicle
	boolean hasTurbo

	constructor(string sportsBrand, integer sportsSpeed, boolean turbo)
		base(sportsBrand, sportsSpeed)
		hasTurbo = turbo

	functions:
		// Override with different implementation
		string describe()
			if hasTurbo
				return brand + " sports car with TURBO at " + speed.toString() + " mph"
			else
				return brand + " sports car at " + speed.toString() + " mph"

		// Override max speed - higher for sports car
		integer getMaxSpeed()
			if hasTurbo
				return 200
			else
				return 180

