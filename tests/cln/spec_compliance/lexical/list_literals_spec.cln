// Spec Section: 2.2 - Literals (List Literals)
// Tests: List literal syntax for various types

start()
	// Test 1: Integer list literals
	list<integer> numbers = [1, 2, 3, 4, 5]
	print("Integer list created")
	iterate num in numbers
		print(num)

	// Test 2: String list literals
	list<string> fruits = ["apple", "banana", "cherry"]
	print("String list created")
	iterate fruit in fruits
		print(fruit)

	// Test 3: Boolean list literals
	list<boolean> flags = [true, false, true, false]
	print("Boolean list created")
	iterate flag in flags
		print(flag)

	// Test 4: Empty list
	list<integer> empty = []
	print("Empty list created")

	// Test 5: Single element list
	list<string> single = ["only one"]
	print("Single element list:")
	iterate item in single
		print(item)

	// Test 6: List operations
	list<integer> data = [100, 200, 300]
	integer size = data.size()
	print("List size: " + size.toString())

	print("List literals test completed")
