// Spec Section: 4.3 - Constant Apply-Blocks
// Tests: constant: apply-block for declaring constants

start:
	// Test 1: Constant declarations
	constant:
		integer MAX_SIZE = 1000
		integer MIN_SIZE = 0
		number PI = 3.14159
		string VERSION = "1.0.0"
		boolean DEBUG = true

	print("Constant values:")
	print("MAX_SIZE: " + MAX_SIZE.toString())
	print("MIN_SIZE: " + MIN_SIZE.toString())
	print("PI: " + PI.toString())
	print("VERSION: " + VERSION)
	print("DEBUG: " + DEBUG.toString())

	// Test 2: Using constants in expressions
	integer doubled = MAX_SIZE * 2
	number circleArea = PI * 5.0 * 5.0
	string versionMsg = "Version: " + VERSION

	print("Computed from constants:")
	print("doubled: " + doubled.toString())
	print("circleArea: " + circleArea.toString())
	print("versionMsg: " + versionMsg)

	// Test 3: Constants in conditions
	if DEBUG
		print("Debug mode is enabled")

	integer value = 500
	if value < MAX_SIZE
		print("Value is within limits")

	if value >= MIN_SIZE
		print("Value is non-negative")

	print("Constant apply-blocks test completed")
