// Spec Section: 4.3 - Control Flow
// Tests: Range expressions in iterate statements
// Requirement: Support various range patterns

start()
	// Test case 1: Basic range (inclusive)
	print("Range 1 to 5:")
	iterate i in 1 to 5
		print(i.toString())

	// Test case 2: Range with zero start
	print("Range 0 to 4:")
	iterate i in 0 to 4
		print(i.toString())

	// Test case 3: Using range in calculation
	integer sum = 0
	iterate i in 1 to 10
		sum = sum + i
	print("Sum 1-10: " + sum.toString())

	// Test case 4: Nested ranges
	print("Multiplication table 1-3:")
	iterate i in 1 to 3
		iterate j in 1 to 3
			integer product = i * j
			print(i.toString() + " x " + j.toString() + " = " + product.toString())

	// Test case 5: Range with condition
	print("Even numbers 1-10:")
	iterate i in 1 to 10
		if i % 2 == 0
			print(i.toString())

	print("Range expressions tests completed")
