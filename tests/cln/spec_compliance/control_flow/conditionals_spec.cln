// Spec Section: 8.1 - Conditionals
// Tests if, if-else, and if-else if-else chains

start:
	integer x = 10

	// Test 1: Basic if statement
	if x > 5
		print("x is greater than 5")

	// Test 2: if-else
	if x > 20
		print("x is greater than 20")
	else
		print("x is not greater than 20")

	// Test 3: if-else if chain
	integer score = 85

	if score >= 90
		print("Grade: A")
	else if score >= 80
		print("Grade: B")
	else if score >= 70
		print("Grade: C")
	else
		print("Grade: F")

	// Test 4: Nested conditionals
	boolean isActive = true
	integer level = 5

	if isActive
		if level > 3
			print("Active and high level")
		else
			print("Active but low level")

	print("Conditionals test complete")
