// Spec Section: 9.2 - Loops (iterate)
// Spec Section: 9.2.1 - Range-based Loops
// Tests: iterate with ranges using 'to' keyword

start:
	// Test 1: Basic range iteration (ascending)
	print("Range 1 to 5:")
	iterate i in 1 to 5
		print(i)

	// Test 2: Range with zero start
	print("Range 0 to 3:")
	iterate j in 0 to 3
		print(j)

	// Test 3: Range for accumulation
	print("Accumulating values:")
	integer accumulated = 0
	iterate k in 1 to 5
		accumulated = accumulated + k
		print(accumulated)

	// Test 4: Range with condition inside
	print("Even numbers in range 1 to 10:")
	iterate m in 1 to 10
		integer mod = m % 2
		if mod == 0
			print(m)

	// Test 5: Using range value in calculation
	integer sum = 0
	iterate n in 1 to 5
		sum = sum + n
	print("Sum of 1 to 5: " + sum.toString())

	// Test 6: Nested range iteration
	print("Multiplication table (1-3):")
	iterate row in 1 to 3
		iterate col in 1 to 3
			integer product = row * col
			print(row.toString() + " x " + col.toString() + " = " + product.toString())

	print("Range iteration tests completed")
