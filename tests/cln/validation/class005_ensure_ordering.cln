// Test: validation/class005_ensure_ordering
// Grammar: ensure_statement
// Semantic: CLASS005
// Rejected: ensure must appear before other statements
// Fixed in: compiler 0.33.184
// Expected output:
// Expected error:
//   CLASS005
//   `ensure` must appear before other statements

start:
	print(divide(10, 2).toString())

functions:
	integer divide(integer a, integer b)
		require b != 0
		integer result = a / b
		ensure result * b == a
		return result
