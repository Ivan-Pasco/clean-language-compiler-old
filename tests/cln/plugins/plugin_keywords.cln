// Test: Plugin keywords without colons should be accepted
// Requires frame.data plugin to be loaded
// NOTE: Field constraints (: pk, auto) require plugin update - using simple fields for now

plugins:
	frame.data

// Plugin keyword "data" followed by identifier (no colon)
data User
	integer id
	string email
	string name

data Post
	integer id
	string title
	string content

// Regular functions block (should still work)
functions:
	void printUsers()
		print("Users loaded")

start:
	printUsers()
