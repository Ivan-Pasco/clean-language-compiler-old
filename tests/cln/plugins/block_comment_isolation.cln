// Test: plugins/block_comment_isolation
// Grammar: foundation/spec/grammar.ebnf — framework_block content extraction
// Semantic: SYN001 regression — extract_block_content_raw must not capture
//           lower-indented comments that follow the last content line of a
//           block. The previous implementation sliced source bytes from the
//           first content token to the next non-whitespace token, but
//           skip_whitespace silently consumed Comment tokens between them,
//           so adjacent comments leaked into the block body the plugin
//           received.
//
// The comment line below the count: block follows its last content line at
// a lower indent and ends with `= 1`; with the fix it is not part of the
// block body the plugin receives, and compilation succeeds.
//
// Changed in 0.33.184: rewritten to frame.data v2 syntax (was a
// `Session.insert:` block on a bare-field `data Session`; v2 removed
// block-form mutations, so the block is now a `Session.count:` query whose
// where: clause is the last content line). The v1 insert: block read a
// leaked `x = 1` as a column assignment and failed; frame.data v2 skips
// comment lines in a query body, so a leak no longer fails this compile.
// Expected output:
// Expected compile: success
// (runtime needs a server to actually query)

plugins:
	frame.data

data Session:
	fields:
		integer id primary generated
		string token

functions:
	void count_sessions()
		integer total = Session.count:
			where:
				token == "sample"

	// Adjacent comment with embedded equals: x = 1
	void other_function()
		print("hi")
