// Test: State rules (invariants) checking at operation boundaries
// Rules are checked after start: completes
// NOTE: This test requires state block to be properly registered (pending fix)

state:
	integer count = 0
	integer maxCount = 10

	rules:
		count >= 0
		count <= maxCount

