// Test: bugfixes/override_with_other_signature_rejected
// Grammar: class_declaration ("is" parent), function_declaration
// Semantic: SEM006 — a method that redefines a parent's public method takes
//   the same parameter types and returns the same type
// Fixed in: compiler 0.33.184
// Expected output:
// Expected error:
//   error[SEM006]: Method 'area' of class 'Square' overrides 'Shape.area' with a different signature
//   error[SEM006]: Method 'label' of class 'Square' overrides 'Shape.label' with a different signature

start:
	Shape s = Square()
	print(s.area(2))

class Shape
	functions:
		public:
			integer area(integer side)
				return side

			string label()
				return "shape"

class Square is Shape
	functions:
		public:
			integer area(number side)
				return 4

			integer label()
				return 1
