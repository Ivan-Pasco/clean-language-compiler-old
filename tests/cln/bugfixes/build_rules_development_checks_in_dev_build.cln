// Test: bugfixes/build_rules_development_checks_in_dev_build
// Grammar: build_block · build_field · state_block · rules_block
// Semantic: 09-build-configuration.md "Rules options": `rules = "development"` checks
//   the state rules in a development build (`cln compile` without `--release`).
//   The release build is covered by tests/test_build_rules_setting.rs.
// Fixed in: compiler 0.33.195
// Expected output:
//   end of start
//   Rule violation: rule failed in state block
//     Rule: count >= 0
//     Actual: count = -5

build:
	rules = "development"

start:
	count = -5
	print("end of start")

state:
	integer count = 0

	rules:
		count >= 0
