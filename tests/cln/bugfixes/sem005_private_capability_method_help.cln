// Test: bugfixes/sem005_private_capability_method_help
// Grammar: capability_decl, class_decl.can_clause, public_functions_section
// Semantic: SEM011 — a capability method implemented outside `public:` is
//   private, which a capability method may not be; the error says
//   capability methods belong under `functions: public:` (spec
//   15-classes-and-objects.md, SEM011 fix text)
// Fixed in: compiler 0.33.184
// Expected output:
// Expected error:
//   SEM011
//   Method 'draw' on class 'Circle' fulfils capability 'Draw' but is private
//   capability methods belong under `functions: public:`
//
// Changed in 0.33.184: a private capability method is SEM011 at the class,
// not SEM005 at the call (developer decision)

start:
	Circle c = Circle()
	print(c.draw())

can Draw:
	string draw()

class Circle can Draw
	functions:
		string draw()
			return "circle"
