// Test: bugfixes/sem005_private_capability_method_help
// Grammar: capability_decl, class_decl.can_clause, public_functions_section
// Semantic: SEM005 — a capability method implemented outside `public:` is
//   private; the error says capability methods belong under
//   `functions: public:` (spec 15-classes-and-objects.md, SEM011 fix text)
// Fixed in: compiler 0.33.184
// Expected output:
// Expected error:
//   SEM005
//   'draw' is private and cannot be accessed from outside 'Circle'
//   `draw` implements capability `Draw`; capability methods belong under `functions: public:`

start:
	Circle c = Circle()
	print(c.draw())

can Draw:
	string draw()

class Circle can Draw
	functions:
		string draw()
			return "circle"
