// Test: if statement without else clause should not generate spurious unreachable
// Bug: Previously generated: if { then } else { unreachable } end
// Fix: Now generates: if { then } end (no else clause)

start:
	integer score1 = 85
	if score1 <= 0
		print("Score 1 is invalid")

	// Should reach here without hitting unreachable
	print("After first if")

	integer score2 = -5
	if score2 <= 0
		print("Score 2 is invalid")

	print("Done")
