// Test: bugfixes/two_screens_both_declare_render
// Grammar: screen_block (grammar.ebnf §6.10)
// Semantic: SCOPE005 — each screen's functions live in the screen's namespace
// Regression: screen functions were promoted to the global function list
//   under their bare names, so when two screens both declared render() the
//   module merge kept only one and the other screen silently rendered the
//   first screen's markup. Screen functions are now scoped as Screen.fn.
// Fixed in: compiler 0.33.166
// Expected output:
//   Counter: 5
//   Hello from Greeter
//   Counter: 6

screen Counter:
	state:
		integer count = 5

	functions:
		string render()
			return "Counter: " + count.toString()

		void increment()
			count = count + 1

screen Greeter:
	functions:
		string render()
			return "Hello from Greeter"

start:
	printl(Counter.render())
	printl(Greeter.render())
	Counter.increment()
	printl(Counter.render())
