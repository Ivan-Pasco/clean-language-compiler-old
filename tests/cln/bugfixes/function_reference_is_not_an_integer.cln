// Test: bugfixes/function_reference_is_not_an_integer
// Grammar: parameter_type, handler_type
// Semantic: SEM001 — a function reference is a `handler`, not an `integer`:
//   passing a function where an integer is expected is a type error
// Fixed in: compiler 0.33.184
// Expected output:
// Expected error:
//   SEM001
//
// Regression: the type checker unified a function type with `integer`, so
// `take(handlerA)` compiled and passed the function's table index as a
// number (developer decision 0.33.184: only a `handler` holds one).

start:
	print(take(handlerA))

functions:
	integer take(integer value)
		return value + 1
	handlerA()
		print("a")
