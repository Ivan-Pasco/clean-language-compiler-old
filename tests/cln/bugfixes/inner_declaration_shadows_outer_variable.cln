// Test: bugfixes/inner_declaration_shadows_outer_variable
// Grammar: variable_declaration, if_statement, while_statement, iterate_statement
// Regression: a variable declared inside an `if`, a `while` or an `iterate`
//   body with the name of an outer variable replaced the outer variable, so
//   the outer one held the inner value after the block.
// Fixed in: compiler 0.33.183
// Expected output:
//   2
//   outer
//   true
//   outer
//   7
//   outer
//   1
//   outer
start:
	string x = "outer"
	if true
		integer x = 2
		print(x)
	print(x)
	integer n = 0
	while n < 1
		n = n + 1
		boolean x = true
		print(x)
	print(x)
	list<integer> xs = [7]
	iterate x in xs
		print(x)
	print(x)
	iterate x in 1 to 1
		print(x)
	print(x)
