// Test: bugfixes/vld004_html_as_response_helper
// Grammar: function_call, namespace
// Semantic: FUNC001
// Bug: VLD004 "'html' is a namespace, not a function — use 'html.function_name()' syntax"
//      When frame.server is loaded and `html` is registered as a namespace (e.g. from
//      frame.ui html: blocks or any plugin dot-notation), the resolver rejected
//      html(content) used as a response helper inside an endpoint handler.
//
// Fix: resolver_impl.rs — added html as a special case alongside input and json.
//      html(content) rewrites to htmlResponse(content), the helper generated by
//      frame.server's endpoints block expansion.
//
// Compile-check: must succeed without VLD004 error
// Note: full integration requires frame.server; this test verifies the json
//       code path (same resolver branch) still works correctly.
//
// Expected output:
//   "hello"

start:
	string encoded = json("hello")
	print(encoded)
