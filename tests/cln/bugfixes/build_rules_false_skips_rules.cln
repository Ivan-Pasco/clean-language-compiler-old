// Test: bugfixes/build_rules_false_skips_rules
// Grammar: build_block · build_field · state_block · rules_block
// Semantic: 09-build-configuration.md "Rules options": `rules = false` means the
//   state rules are never checked, so a program that breaks one still ends normally.
// Fixed in: compiler 0.33.195
// Expected output:
//   end of start

build:
	rules = false

start:
	count = -5
	print("end of start")

state:
	integer count = 0

	rules:
		count >= 0
