// Test: bugfixes/syn001_class_body_colon_patterns
// Grammar: grammar.ebnf class_field, indented_class_body
// Semantic: SYN001 regression — colon in class body must not trigger precision-modifier path.
//           Two plugin-generated patterns must parse correctly:
//
//   1. name-colon-type field:   `id: integer`  (reversed field declaration)
//      Generated by plugin expanders that produce name-first field syntax.
//
//   2. sub-section header:      `inputs:` followed by an indented block of type-name fields
//      Generated by frame.ui when expanding component DSL blocks.
//
// Before the fix, both patterns produced:
//   SYN001: Expected identifier, found Colon
//
// Expected output:
//   ok

start:
	print("ok")

class User
	id: integer
	email: string

class DocListItem
	string _tag = "doc-list-item"
	inputs:
		string href
		string title
