// Test: bugfixes/require_failure_is_not_caught_by_onerror
// Grammar: require_statement, on_error_block
// Semantic: 11-contracts.md: "onError does not catch it: a broken contract is a
//   bug in the program, not an expected failure." The violation is printed and
//   the program stops; the onError handler does not run.
// Fixed in: compiler 0.33.190
// Expected output:
//   Contract violation: require failed at checkAge:19
//     Expression: age <= 150

start:
	checkAge(200) onError:
		print("caught: " + error)
	print("not reached")

functions:
	void checkAge(integer age)
		require age >= 0
		require age <= 150
		print("age ok")
