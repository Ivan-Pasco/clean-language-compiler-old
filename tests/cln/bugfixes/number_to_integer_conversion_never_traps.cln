// Test: bugfixes/number_to_integer_conversion_never_traps
// Grammar: method_call (toInteger), variable_declaration
// Semantic: type-system.md "Values Must Fit" — a number outside the integer
//   range, and NaN, raise the catchable error "<value> does not fit in
//   integer"; they never trap the program
// Fixed in: compiler 0.33.190
// Expected output:
//   caught: 3000000000 does not fit in integer
//   caught: -3000000000 does not fit in integer
//   -1
//   3
//
// Regression: `number` to `integer` conversions used the trapping WASM
// truncation (0.33.183), so 3000000000.0.toInteger() and NaN.toInteger()
// halted. Until 0.33.189 this test asserted that they clamp to the nearest
// integer and that NaN becomes 0; the spec and the developer decision of
// Nov 2026 require a catchable error instead (see
// number_to_integer_raises_when_value_does_not_fit).

start:
	number big = nid(3000000000.0)
	integer a = big.toInteger() onError:
		print("caught: " + error)
	number low = nid(-3000000000.0)
	integer b = low.toInteger() onError:
		print("caught: " + error)
	number nan = nid(0.0) / nid(0.0)
	integer c = nan.toInteger() onError -1
	print(c.toString())
	integer d = nid(3.7).toInteger()
	print(d.toString())

functions:
	number nid(number v)
		return v
