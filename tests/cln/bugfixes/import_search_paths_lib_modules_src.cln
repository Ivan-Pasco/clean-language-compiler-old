// Test: bugfixes/import_search_paths_lib_modules_src
// Semantic: spec 18 Module Resolution searches ./lib/, ./modules/ and ./src/ next to the importing file
// Fixed in: compiler 0.33.190
// Fixed: spec 18 (2026-11-27) requires module.fn for import: modules
// Expected output:
//   lib
//   modules
//   src

import:
	search_path_lib_helper
	search_path_modules_helper
	search_path_src_helper

start:
	print(search_path_lib_helper.from_lib())
	print(search_path_modules_helper.from_modules())
	print(search_path_src_helper.from_src())
