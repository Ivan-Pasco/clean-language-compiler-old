// Test: bugfixes/statement_after_inner_if_stays_in_its_arm
// Grammar: if_statement
// Regression: a statement that followed an inner if/else inside the then-arm
//   of an outer if/else was emitted after the outer if/else instead of inside
//   its arm, so it also ran when the else-arm was taken. The same happened
//   when the else-arm held two consecutive single-arm ifs. frame.ui's styles
//   block parser hit this: the section-indent update after the section-name
//   check ran for every variable line too.
// Fixed in: compiler 0.33.166
// Expected output:
//   21
//   105
//   11
//   7
//   section=0 vars=2 globals=1
//   5
//   55
//   21

start:
	printl(arms(true).toString())
	printl(arms(false).toString())
	printl(chain(0, -1).toString())
	printl(chain(1, 0).toString())
	printl(sections())
	printl(trailing_ifs(2).toString())
	printl(trailing_ifs(1).toString())
	printl(trailing_ifs(0).toString())

functions:
	integer arms(boolean outer)
		integer m = 5
		if outer
			if m == 1
				m = 10
			else
				m = 20
			m = m + 1
		else
			m = m + 100
		return m

	integer chain(integer indent, integer limit)
		integer m = 5
		if limit == -1 or indent <= limit
			if indent == 0
				m = 10
			else if indent == 9
				m = 20
			else
				return 0
			m = m + 1
		else if indent == 1
			m = m + 2
		else
			m = 0
		return m

	string sections()
		integer section_indent = -1
		integer vars = 0
		integer globals = 0
		string section = ""
		list<integer> indents = [0, 1, 1, 0, 1]
		list<string> names = ["variables:", "a", "b", "global:", "c"]
		integer i = 0
		while i < 5
			integer indent = indents.get(i)
			string line = names.get(i)
			if section_indent == -1 or indent <= section_indent
				if line == "variables:"
					section = "variables"
				else if line == "global:"
					section = "global"
				else
					return "bad section " + line
				section_indent = indent
			else if section == "variables"
				vars = vars + 1
			else
				globals = globals + 1
			i = i + 1
		return "section=" + section_indent.toString() + " vars=" + vars.toString() + " globals=" + globals.toString()

	integer trailing_ifs(integer k)
		integer m = 5
		integer g = -1
		integer c = -1
		if k == 0
			if m == 1
				m = 10
			else
				m = 20
			m = m + 1
		else if k == 1
			m = m + 50
		else
			if g == -1
				g = 3
			if c == -1
				c = 4
		return m
