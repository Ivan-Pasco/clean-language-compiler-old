// Test: bugfixes/this_method_call_rejected
// Grammar: grammar.ebnf §keywords — `this` is reserved and unused; a method
//   of the same object is called by its bare name
// Semantic: SYN002 (developer decision: `this.` is not part of Clean)
// Fixed in: compiler 0.33.186
// Expected output:
// Expected error:
//   SYN002
//   `this` is not used in Clean: refer to the field or method by its name (`count`, `clear()`)
//   :27:
//
// Regression: `this.clear()` compiled as a call of the sibling method.

start:
	Counter c = Counter()
	c.restart()

class Counter
	integer count

	functions:
		public:
			clear()
				count = 0

			restart()
				this.clear()
