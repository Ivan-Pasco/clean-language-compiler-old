// Test: bugfixes/events_block_bare_name_export
// Changed in 0.33.187: events: only exists in frame.ui component: blocks (developer decision)
// Grammar: grammar.ebnf class_body_item (no events section);
//          frame-ui.ebnf events_section belongs to component_block only
// Semantic: SYN002 — `events:` as the first section of a plain class is
//           rejected. Earlier compilers parsed it and emitted a bare-named
//           top-level function per handler; frame.ui now emits the handler
//           exports for its components itself.
// Fixed in: compiler 0.33.187
// Expected output:
// Expected error:
//   error[SYN002]: `events:` is not a class section: event handlers belong in a frame.ui `component:` block
//   events_block_bare_name_export.cln:23:2
//   help: Declare the handlers in a `component:` block's `events:` section, or make them methods in the class's `functions:` section

start:
	instance.fmt_bold()

state:
	FormatToolbar instance = FormatToolbar()

class FormatToolbar
	events:
		fmt_bold():
			printl("bold ran")
