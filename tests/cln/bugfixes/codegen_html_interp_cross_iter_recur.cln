// Test: bugfixes/codegen_html_interp_cross_iter_recur
// Regression: CODEGEN-HTML-INTERP-CROSS-ITER-RECUR (fingerprint
//   1e1058fadfed6b415c5802bf44a57365f44e3b36efda5a39473158729684d759),
//   reported against compiler 0.33.35.
// Fixed in: compiler 0.33.40 — verified on HEAD by this test. The fix
//   was already in place via the accumulator-loop rewrite's Step 3.5
//   (`rewrite_call_arg_concats_in_expression` in
//   `src/hir/hir_builder.rs`), which routes concat-chain arguments to
//   Call / MethodCall through the transient arena. Adding this test
//   pins the behaviour so a future regression in that path is caught
//   before it re-ships.
//
// The bug shape: an SSR-style while loop builds an HTML row string by
// repeatedly reading a body-local via
//   `string field_i = json.get(data, "prefix." + i.toString() + ".name")`
// and concatenating those helpers into a growing accumulator. The path
// literal argument (`"prefix." + i.toString() + ".name"`) has a leading
// AND trailing string literal, and `i.toString()` in the middle. Pre-fix,
// the compiler's string-heap allocated that path string in the same
// bump region as the growing accumulator; later iterations would then
// overwrite bytes captured by the accumulator's earlier iterations, and
// the final printed accumulator contained garbage-literal fragments
// (`"data.rows.2.id"`, etc.) interleaved with valid row content.
//
// The fix routes the `+`-chain arguments to `json.get` through
// `__string_concat_transient` → `__transient_alloc`, so their
// lifetime ends at the call return and cannot alias with the outer
// accumulator. This test verifies the whole path end-to-end: 8
// iterations × 6 fields each = 48 json.get calls with per-iter
// per-field concatenated paths, all appended into `rows` under the
// accumulator pattern. If aliasing recurs, the printed output will
// contain literal `data.rows.N.<field>` fragments spliced into rows.
//
// Expected output:
//   R0[a=a0,b=b0,c=c0,d=d0,e=e0,f=f0]|R1[a=a1,b=b1,c=c1,d=d1,e=e1,f=f1]|R2[a=a2,b=b2,c=c2,d=d2,e=e2,f=f2]|R3[a=a3,b=b3,c=c3,d=d3,e=e3,f=f3]|R4[a=a4,b=b4,c=c4,d=d4,e=e4,f=f4]|R5[a=a5,b=b5,c=c5,d=d5,e=e5,f=f5]|R6[a=a6,b=b6,c=c6,d=d6,e=e6,f=f6]|R7[a=a7,b=b7,c=c7,d=d7,e=e7,f=f7]

start:
	string j = "{\"data\":{\"rows\":[{\"a\":\"a0\",\"b\":\"b0\",\"c\":\"c0\",\"d\":\"d0\",\"e\":\"e0\",\"f\":\"f0\"},{\"a\":\"a1\",\"b\":\"b1\",\"c\":\"c1\",\"d\":\"d1\",\"e\":\"e1\",\"f\":\"f1\"},{\"a\":\"a2\",\"b\":\"b2\",\"c\":\"c2\",\"d\":\"d2\",\"e\":\"e2\",\"f\":\"f2\"},{\"a\":\"a3\",\"b\":\"b3\",\"c\":\"c3\",\"d\":\"d3\",\"e\":\"e3\",\"f\":\"f3\"},{\"a\":\"a4\",\"b\":\"b4\",\"c\":\"c4\",\"d\":\"d4\",\"e\":\"e4\",\"f\":\"f4\"},{\"a\":\"a5\",\"b\":\"b5\",\"c\":\"c5\",\"d\":\"d5\",\"e\":\"e5\",\"f\":\"f5\"},{\"a\":\"a6\",\"b\":\"b6\",\"c\":\"c6\",\"d\":\"d6\",\"e\":\"e6\",\"f\":\"f6\"},{\"a\":\"a7\",\"b\":\"b7\",\"c\":\"c7\",\"d\":\"d7\",\"e\":\"e7\",\"f\":\"f7\"}]}}"
	string rows = ""
	integer i = 0
	while i < 8
		string idx = i.toString()
		string a = json.get(j, "data.rows." + idx + ".a")
		string b = json.get(j, "data.rows." + idx + ".b")
		string c = json.get(j, "data.rows." + idx + ".c")
		string d = json.get(j, "data.rows." + idx + ".d")
		string e = json.get(j, "data.rows." + idx + ".e")
		string f = json.get(j, "data.rows." + idx + ".f")
		if i > 0
			rows = rows + "|"
		rows = rows + "R" + idx + "[a=" + a + ",b=" + b + ",c=" + c + ",d=" + d + ",e=" + e + ",f=" + f + "]"
		i = i + 1
	printl(rows)
