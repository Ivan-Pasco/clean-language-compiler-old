// Bugfix test: multiple break — simplest possible reproduction
// No string methods, no imports — pure integer logic

start:
	integer count = 0
	integer pos = 0
	while pos < 20
		integer a = pos * 2
		if a > 10
			break
		integer b = pos * 3
		if b > 12
			break
		pos = pos + 1
		count = count + 1
	print(count.toString())
