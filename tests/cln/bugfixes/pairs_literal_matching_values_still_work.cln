// Test: bugfixes/pairs_literal_matching_values_still_work
// Grammar: pairs_literal, variable_declaration
// Semantic: SEM001 — pairs literals whose values match the declared value type
//   (including an integer literal for a `number` value and a subclass for a
//   parent-typed value) keep compiling
// Fixed in: compiler 0.33.195
// Expected output:
//   1
//   2.5
//   3
//   x
//   ...
//   9
//   7
//
// Guards the literal value check added for #86: the check must not reject
// valid literals.

start:
	pairs<string, integer> a = {"a": 1}
	print(a["a"])
	pairs<string, number> b = {"b": 2.5, "c": 3}
	print(b["b"])
	print(b["c"])
	pairs<string, string> c = {"k": "x"}
	print(c["k"])
	pairs<string, Animal> d = {"dog": Dog()}
	print(d["dog"].speak())
	pairs<string, integer> empty = {}
	empty["z"] = 9
	print(empty["z"])
	pairs<string, integer> e = {"n": 3 + 4}
	print(e["n"])

class Animal
	functions:
		public:
			string speak()
				return "..."

class Dog is Animal
