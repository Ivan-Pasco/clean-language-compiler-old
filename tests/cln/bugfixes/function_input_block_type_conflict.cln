// Test: bugfixes/function_input_block_type_conflict
// Grammar: input_declaration (§6.2b)
// Semantic: SEM001 — an input declaration may not change a parameter's type
// Fixed in: compiler 0.33.190
// Expected output:
// Expected error:
//   Input declaration 'a' has type string but the parameter was declared integer
//
// Regression (#65): redeclaring a header parameter inside `input` with a
// different type must be an error.

start:
	print(f(1))

functions:
	integer f(integer a)
		input
			string a
		return 1
