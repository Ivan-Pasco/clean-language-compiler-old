// Test: bugfixes/module_call_helpers
// Semantic: module imported by the module-call pins
//   (module_qualified_call_*.cln, import_module_alias.cln); an imported
//   module's start: block runs before the importing program's
// Fixed in: compiler 0.33.176
// Expected output:
//   helpers loaded

start:
	print("helpers loaded")

functions:
	// Changed in 0.33.184: twice and label were private, SEM005 per developer decision
	public:
		integer twice(integer n)
			return n * 2

		string label(string s)
			return "<" + s + ">"
