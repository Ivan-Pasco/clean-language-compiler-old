// Test: bugfixes/string_accumulator_singleshot_rhs_reads_acc
// Grammar: grammar.ebnf `assignment_statement`, `string_concat_expr`
// Semantic: ast.md faithful lowering (HIR string-builder rewrite must not change meaning)
// Fixed in: compiler 0.33.189
//
// A chained self-append whose right-hand side reads the accumulator itself
// must not be turned into a builder: between the builder declaration and the
// finalize there is no binding named like the accumulator.
//
// Expected output:
//   ab-2
//   ab-ab
//   xxy

start:
	string s = "ab"
	s = s + "-" + s.length().toString()
	print(s)
	print(twice())
	print(selfdouble())

functions:
	string twice()
		string s = "ab"
		s = s + "-" + s
		return s

	string selfdouble()
		string s = ""
		s = s + "x"
		s = s + s
		s = s + "y"
		return s
