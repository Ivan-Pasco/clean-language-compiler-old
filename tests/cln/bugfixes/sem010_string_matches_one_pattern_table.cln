// Test: bugfixes/sem010_string_matches_one_pattern_table
// Grammar: method_call
// Semantic: SEM010 — the pattern name of string.matches() is checked at
//   compile time against one table shared by the type checker and the MIR
//   builder. `slug` is a spec pattern no runtime host implements yet.
// Fixed in: compiler 0.33.174
// Expected output:
// Expected error:
//   error[SEM010]: Pattern 'slug' is not implemented by the runtime yet
//   sem010_string_matches_one_pattern_table.cln:18:

start:
	string s = "my-page"
	boolean ok = s.matches("email")
	printl(ok.toString())
	boolean phone = "+15551234567".matches("phone")
	printl(phone.toString())
	boolean slug = s.matches("slug")
	printl(slug.toString())
