// Test: bugfixes/syn001_orm_query_in_function
// Grammar: frame-data.ebnf query_expression
// Semantic: SYN001 regression — parser must not emit "Unsupported statement type: Colon"
//           when an ORM query block (Model.verb: with sub-clauses) appears inside a
//           functions: block.
//
// Expected behaviour: compiles successfully — ORM query block inside functions: must
// not trigger SYN001 "Unsupported statement type: Colon" (original regression).
// Fixed: added integer id : pk, auto to User and Role models (spec §2.1 requires
// explicit pk declaration; id is not auto-generated by the plugin).

plugins:
	frame.data
	frame.server

data User:
	integer id : pk, auto
	string name
	string email

data Role:
	integer id : pk, auto
	string label
	integer user_id

start:
	print("ok")

functions:
	list<User> get_users_with_role(string role_label)
		list<User> rows = User.find:
			join:
				inner Role on User.id == Role.user_id
			where:
				Role.label == role_label
		return rows

endpoints server:
	GET "/users" :
		list<User> result = get_users_with_role("admin")
		return http.respond(200, "application/json", "[]")
