// Test: bugfixes/sem001_constraint_solver_50_data_models
// Grammar: plugin-DSL — frame.data data: block, multiple instances.
// Regression: SEM001 (dashboard fp 7cc56e80f714).
//   Originally reported against compiler 0.30.268: 9 data: models in a
//   project triggered the typechecker constraint solver to exit with
//   "Type inference timeout: too many constraint solving iterations".
//   By 0.30.305 the threshold had shifted to ~42 models (constraint
//   solver had been incidentally improved by other type-inference work),
//   but the 10_000-iteration cap still rejected realistic projects.
//
//   Fix: raised the cap to 100_000. The cap is a safety net against
//   pathological infinite loops in solve_constraint; genuine non-progress
//   is already detected by the try_alternative_strategies / break.
//   Each frame.data `data:` block expands into ~250 constraints, so 50
//   models submit ~12_500 — which the new cap accepts.
//
// Expected output:
//   ok

plugins:
	frame.data

data M1:
	id: integer pk auto
	name: string
	count: integer
	created_at: datetime auto

data M2:
	id: integer pk auto
	name: string
	count: integer
	created_at: datetime auto

