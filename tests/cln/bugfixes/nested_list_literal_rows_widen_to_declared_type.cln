// Test: bugfixes/nested_list_literal_rows_widen_to_declared_type
// Grammar: list_literal, expression
// Semantic: type-system.md §5 (integer widens to number; rows are checked one by one)
// Fixed in: compiler 0.33.189
// Expected output:
//   2
//   3
//   2
//   3
//   [[1,"x"],[true]]
//
// Regression: the rows of a nested literal were typed from the first row
// only, so integer rows stored into a matrix<number> kept 4-byte slots, and
// `list<list<number>> l = [[1, 2], [3, 4]]` was rejected.

start:
	matrix<number> m = [[1, 2], [3, 4]]
	print(m[0][1])
	print(m[1][0])
	list<list<number>> l = [[1, 2], [3, 4]]
	print(l[0][1])
	print(l[1][0])
	list<list<any>> la = [[1, "x"], [true]]
	print(la)
