// Test: bugfixes/list_literal_runtime_elements
// Grammar: list_literal (elements are expressions)
// Semantic: a list literal may contain variables, calls and arithmetic
// Fixed in: compiler 0.33.160
// Regression: clean-language-compiler-old #22. `[title]` failed with
//   "Array literals currently only support constant literal values"; both
//   parsers accepted constant elements only.
// Expected output:
//   2
//   Dunex
//   6
//   ABC
//   3
//   2

start:
	string title = "Dune"
	list<string> pair = [title, "x"]
	print(pair.length().toString())
	print(pair[0] + pair[1])

	integer a = 2
	list<integer> nums = [a, a * 3, 7]
	print(nums[1].toString())

	string s = "abc"
	list<string> upper = [s.toUpperCase(), "z"]
	print(upper[0])

	list<integer> constants = [1, 2, 3]
	print(constants[2].toString())

	print(count([title, s]).toString())

functions:
	integer count(list<string> items)
		return items.length()
