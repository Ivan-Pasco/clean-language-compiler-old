// Test: bugfixes/string_literal_in_interpolation
// Grammar: string_interpolation, string_literal
// Fixed in: compiler 0.33.174
// Expected output:
//   v=q!
//   n=ab
//   a {b c}

start:
	print("v={wrap("q")}")
	print("n={"a" + "b"}")
	print("a {b" + " c}")

functions:
	string wrap(string s)
		return s + "!"
