// Test: bugfixes/string_literal_in_interpolation
// Grammar: string_interpolation, string_literal
// Fixed in: compiler 0.33.176
// Expected output:
//   v=q!
//   n=a!b
//   a {b c}
//   {x}

start:
	print("v={wrap("q")}")
	print("n={wrap("a") + "b"}")
	print("a {b" + " c}")
	string body = "x"
	print("{" + body + "}")

functions:
	string wrap(string s)
		return s + "!"
