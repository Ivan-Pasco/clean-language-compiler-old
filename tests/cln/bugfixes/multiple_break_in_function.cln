// Bugfix test: multiple break inside a function (exact bug scenario)
// The bug says it works in start: but fails in functions:

start:
	integer r = countBreaks()
	print(r.toString())

functions:
	integer countBreaks()
		integer count = 0
		integer pos = 0
		while pos < 20
			integer a = pos * 2
			if a > 10
				break
			integer b = pos * 3
			if b > 12
				break
			pos = pos + 1
			count = count + 1
		return count
