// Test: bugfixes/while_condition_blocks_with_break_continue
// Semantic: continue re-evaluates a while condition that builds its own blocks; break leaves the loop
// Fixed in: compiler 0.33.190
// Expected output:
//   1
//   3
//   4
//   done i=5
//   inner 0
//   inner 1
//   inner 0
//   inner 1
//   end

start:
	integer i = 0
	while (if i < 8 then true else false)
		i = i + 1
		if i == 2
			continue
		if i == 5
			break
		print(i)
	print("done i=" + i.toString())
	integer a = 0
	while (if a < 2 then true else false)
		integer b = 0
		while (10 / (2 - b) onError -1) > 0
			print("inner " + b.toString())
			b = b + 1
		a = a + 1
	print("end")
