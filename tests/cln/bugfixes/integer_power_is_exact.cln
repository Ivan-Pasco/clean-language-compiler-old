// Test: bugfixes/integer_power_is_exact
// Grammar: power_expression
// Semantic: the type of `a ^ b` follows its operands; integer powers are exact
// Fixed in: compiler 0.33.177
// Expected output:
//   4052555153018976267
//   4611686018427387904
//   1024
//   -8
//   0
//   -1
//   1
//   2.25
//   1.4142135623730951
//   512
//
// `integer:64 ^ integer` was computed as an i32 through an f64: 3 ^ 39
// trapped with an integer overflow, and powers above 2^53 lost digits.

start:
	integer:64 b = 3
	integer:64 r = b ^ 39
	printl(r.toString())
	integer:64 two = 2
	printl((two ^ 62).toString())
	integer s = 2 ^ 10
	printl(s.toString())
	integer a = -2
	printl((a ^ 3).toString())
	printl((2 ^ -1).toString())
	printl(((0 - 1) ^ -3).toString())
	printl((5 ^ 0).toString())
	number:32 f = 1.5
	printl((f ^ 2).toString())
	printl((2 ^ 0.5).toString())
	printl((2 ^ 3 ^ 2).toString())
