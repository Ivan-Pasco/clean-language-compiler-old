// Test: bugfixes/mir_constant_folding_matches_runtime
// Semantic: type-system.md integer (32-bit; overflow raises "integer overflow")
//   and number (IEEE-754 f64)
// Regression: the MIR constant-folding pass (enabled at the default -O2)
//   computed integer arithmetic in 64 bits and compared floats with an
//   epsilon, so folded results disagreed with the unoptimized WASM
//   (i32 wrapping arithmetic, exact f64.eq). Chained multiplication that
//   overflowed i64 panicked the compiler in debug builds.
// Fixed in: compiler 0.33.165
// Expected output:
//   false
//   true
//   false
//   -1
//   -2
//   -3
//   2

start:
	printl(0.1 + 0.2 == 0.3)
	printl(0.1 + 0.2 != 0.3)
	// Changed in 0.33.184: integer overflow raises "integer overflow" instead of wrapping,
	// and a constant expression that overflows is a compile error (developer decision);
	// the folded and the runtime results still agree.
	integer top = 2147483647
	printl((top + 1 onError -1) > 0)
	integer wrapped = top + 1 onError -1
	printl(wrapped)
	integer m = top * top * top onError -2
	printl(m)
	integer neg = -(0 - top - 1) onError -3
	printl(neg)
	printl(-7 % 3 + 3)
