// Test: bugfixes/runtime_string_to_number_fb5da8d1e4c7
// Regression: string.toNumber() runtime dispatch (fingerprint fb5da8d1e4c7)
// Grammar: method_call receiver.toNumber()
// Semantic: stdlib-reference.md — .toNumber() on non-numeric string returns 0.0
//
// Before the fix, string.toNumber resolved to the generic value-decoding body in
// method_style.rs which read the length prefix as an i32 and converted THAT to f64
// — so "3.14".toNumber() printed 4 (the byte length of the string).
// Fix: alias string.toNumber → string_to_float host bridge in codegen_registration.rs,
// mirroring the string.toInteger → __string_to_int wiring.
//
// Fixed in: compiler 0.33.8
//
// Expected output:
//   3.14
//   42
//   -2.5
//   1000000
//   0

start:
	number a = "3.14".toNumber()
	number b = "42".toNumber()
	number c = "-2.5".toNumber()
	number d = "1e6".toNumber()
	number e = "not-a-number".toNumber()
	print(a)
	print(b)
	print(c)
	print(d)
	print(e)
