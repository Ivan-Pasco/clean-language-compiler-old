// Test: bugfixes/same_public_name_farewells
// Semantic: module imported by same_public_name_two_modules.cln; its public
//   `message()` and `state: count` share names with the other module
// Fixed in: compiler 0.33.194
// Expected output:
//   farewells loaded

start:
	print("farewells loaded")

state:
	public:
		integer count = 20

functions:
	public:
		string message()
			return "bye"

		integer bump()
			count = count + 1
			return count
