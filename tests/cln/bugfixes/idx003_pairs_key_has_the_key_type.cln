// Test: bugfixes/idx003_pairs_key_has_the_key_type
// Grammar: index_expression, assignment_statement
// Semantic: IDX003 — a pairs is indexed (read or assigned) with a key of
//   its declared key type.
// Fixed in: compiler 0.33.174
// Expected output:
// Expected error:
//   error[IDX003]: Pairs key must be string, found integer
//   idx003_pairs_key_has_the_key_type.cln:19:
//   idx003_pairs_key_has_the_key_type.cln:20:
//
// Regression: a pairs read accepted any key when the key type was string,
// and a bracket assignment never checked the key at all.

start:
	pairs<string, integer> ages = {"a": 1}
	integer n = 2
	printl(n.toString())
	ages[n] = 3
	integer v = ages[n]
	printl(v.toString())
