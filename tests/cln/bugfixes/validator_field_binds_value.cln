// Test: bugfixes/validator_field_binds_value
// Grammar: function_call (validator.field, validator.required)
// Semantic: stdlib-reference §15 — `validator.field(v, name, value)` starts a
//   field rule whose rules check `value`; `validator.required(v)` marks the
//   current field required. Both return the handle.
// Fixed in: compiler 0.33.184
// Expected output:
//   false
//   true
//   true
//   true
//
// Regression: the compiler accepted only `validator.field(v, name)` and
// `validator.required(v, flag)`, which are not the §15 signatures, and a
// field had no value of its own: `validator.run` checked every field against
// the run input. The required check of `validator.run` / `validator.runField`
// was also inverted: a required field failed when its value was present,
// and `validator.runField` looped forever once it found the named field.

start:
	integer short = validator.create()
	short = validator.field(short, "name", "ab")
	short = validator.required(short)
	short = validator.minLength(short, 3)
	print(validator.isOk(validator.run(short, 0)))

	integer long = validator.required(validator.field(validator.create(), "name", "abcd"))
	long = validator.minLength(long, 3)
	print(validator.isOk(validator.run(long, 0)))

	integer two = validator.create()
	two = validator.maxLength(validator.field(two, "code", "xyz"), 3)
	two = validator.minLength(validator.field(two, "city", "Lima"), 2)
	print(validator.isOk(validator.run(two, 0)))
	print(validator.isOk(validator.runField(long, "name", "abcd")))
