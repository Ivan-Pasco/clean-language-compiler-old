// Test: bugfixes/void_function_cannot_return_value
// Grammar: return_statement
// Semantic: SEM001 — a top-level `void` function returns no value
// Regression: `return 5` in a top-level `void` function compiled and the
//   value was silently dropped (methods already rejected it).
// Fixed in: compiler 0.33.190
// Expected output:
// Expected error:
//   A void function cannot return a value (got integer)

start:
	v()
	print("done")

functions:
	void v()
		return 5
