// Test: bugfixes/list_literal_widens_to_common_type
// Grammar: list_literal, expression
// Semantic: type-system.md §5-6 (integer widens to number and to integer:64)
// Fixed in: compiler 0.33.189
// Expected output:
//   [1.0,2.5]
//   1
//   2.5
//   [1,9000000000]
//   2.5
//   4
//   [1.5,9000000000.0]
//   [1.5,4000000000.0]
//   [1.5,9000000000.0]
//   [1.5,4000000000.0]
//
// Regression: the element type of an unannotated list literal was the first
// element's type, so a later number or integer:64 element was stored into a
// 4-byte integer slot and read back as 0. Widening into list<number> also
// skipped integer:64, integer:64u and integer:32u, giving garbage values (a
// literal) or invalid WebAssembly (list.add).

start:
	number n = 2.5
	print([1, n])
	iterate v in [1, 2.5]
		print(v)
	integer:64 big = 9000000000
	print([1, big])
	matrix<number> m = [[1, 2.5], [3.5, 4]]
	print(m[0][1])
	print(m[1][1])
	integer:32u u = 4000000000
	list<number> a = [1.5, big]
	print(a)
	list<number> b = [1.5, u]
	print(b)
	list<number> l = [1.5]
	l.add(big)
	print(l)
	list<number> l2 = [1.5]
	l2.add(u)
	print(l2)
