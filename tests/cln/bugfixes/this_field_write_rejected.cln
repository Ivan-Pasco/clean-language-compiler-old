// Test: bugfixes/this_field_write_rejected
// Grammar: grammar.ebnf §keywords — `this` is reserved and unused; a field
//   is assigned by its bare name
// Semantic: SYN002 (developer decision: `this.` is not part of Clean)
// Fixed in: compiler 0.33.186
// Expected output:
// Expected error:
//   SYN002
//   `this` is not used in Clean: refer to the field or method by its name (`count`, `reset()`)
//   :24:
//
// Regression: `this.count = 0` compiled as a write of the field.

start:
	Counter c = Counter()
	c.clear()

class Counter
	integer count

	functions:
		public:
			clear()
				this.count = 0
