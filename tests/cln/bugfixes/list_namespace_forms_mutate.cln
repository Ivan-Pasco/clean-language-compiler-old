// Test: bugfixes/list_namespace_forms_mutate
// Semantic: stdlib-reference.md §5 — `set`, `add`, `insert`, `removeLast`
//   and `remove` mutate the list in place.
// Fixed in: compiler 0.33.165
// Regression: `list.set` stored 0 (it read the value as a pointer), growing
//   `list.add` / `list.push` / `list.insert` left the variable on the old
//   block, `pop` did not shrink the list and `removeLast` failed to compile.
// Expected output:
//   8 9 3
//   5 5
//   6 7 3
//   5 4 5
//   x z 1
//
// Changed in 0.33.184: `list.<method>(items, ...)` namespace calls are now the
// method form `items.<method>(...)`; the `list.` namespace has only concat,
// range, fill and join (developer decision)

start:
	list<integer> a = [1, 2, 3]
	a.set(0, 8)
	a.set(1, 9)
	print(a[0].toString() + " " + a[1].toString() + " " + a[2].toString())
	a.add(4)
	a.add(5)
	print(a.length().toString() + " " + a[4].toString())
	a.insert(0, 7)
	a.insert(0, 6)
	print(a[0].toString() + " " + a[1].toString() + " " + a.indexOf(9).toString())
	integer p = a.removeLast()
	integer r = a.removeLast()
	print(p.toString() + " " + r.toString() + " " + a.length().toString())
	list<string> w = ["x", "y", "z"]
	string last = w.removeLast()
	string gone = w.remove(1)
	print(w.get(0) + " " + last + " " + w.length().toString())
