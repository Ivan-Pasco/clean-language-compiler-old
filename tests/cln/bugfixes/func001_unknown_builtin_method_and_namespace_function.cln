// Test: bugfixes/func001_unknown_builtin_method_and_namespace_function
// Grammar: method_call, static_method_call
// Semantic: FUNC001 — a method or namespace function that does not exist is
//   reported by the type checker, at the call.
// Fixed in: compiler 0.33.174
// Expected output:
// Expected error:
//   error[FUNC001]: Method 'fooBar' not found on a string value
//   func001_unknown_builtin_method_and_namespace_function.cln:29:
//   error[FUNC001]: Method 'nope' not found on class 'Box'
//   func001_unknown_builtin_method_and_namespace_function.cln:32:
//   error[FUNC001]: Function 'json.parse' not found
//   func001_unknown_builtin_method_and_namespace_function.cln:35:
//
// Regression: `s.fooBar()`, `Box.nope(3)` and `json.parse(...)` passed the
// type checker and failed later in code generation with an unrelated error.

start:
	printl("unreachable")

class Box
	functions:
		integer twice(integer v)
			return v * 2

functions:
	string first()
		string s = "abc"
		return s.fooBar()

	integer second()
		return Box.nope(3)

	any third()
		return json.parse("1")
