// Test: bugfixes/handler_is_not_a_return_type
// Grammar: function_return_type (does not include handler_type)
// Semantic: SYN002 — `handler` may be a variable or parameter type but not a
//   function return type (type-system.md §"The `handler` Type")
// Fixed in: compiler 0.33.184
// Expected output:
// Expected error:
//   SYN002
//   `handler` cannot be a function's return type: a handler is a variable or parameter type only
//
// Regression: `handler pick()` compiled as a function returning a handler.

start:
	print("test")

functions:
	handler pick()
		return onSave

	void onSave()
		print("saved")
