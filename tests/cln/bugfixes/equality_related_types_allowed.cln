//   true
//   true
//   true
//   true
//   false
//   true
//
// Spec decision C1 (2026-11-26): integer/number, T vs T?, and none
// compare without error.

start:
	integer n = 1
	number d = 1.0
	string? name = none
	string? other = "Ada"
	print(n == d)
	print(name == none)
	print(other == "Ada")
	print("Ada" == other)
	print(name == other)
	print(name != other)
