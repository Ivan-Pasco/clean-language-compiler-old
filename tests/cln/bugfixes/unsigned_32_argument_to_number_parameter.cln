// Test: bugfixes/unsigned_32_argument_to_number_parameter
// Grammar: function_call, constructor_call
// Semantic: type-system.md §2 (unsigned arithmetic), §5 (integer:N to number widening)
// Fixed in: compiler 0.33.189
// Expected output:
//   4000000000
//   4000000000

start:
	integer:32u u = 4000000000
	print(takeNum(u))
	Box b = Box(u)
	print(b.v)

class Box
	public:
		number v
	constructor(number v)

functions:
	number takeNum(number v)
		return v
