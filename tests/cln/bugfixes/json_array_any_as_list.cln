// Test: bugfixes/json_array_any_as_list
// Grammar: iterate_statement, variable_declaration, method_call
// Semantic: type-system.md §9 (`any` is not type-checked); stdlib-reference.md §8 (a JSON array is a `list<any>`)
// Fixed in: compiler 0.33.176
// Expected output:
//   indexed=b
//   count=3
//   get=a
//   a
//   b
//   c
//   direct=1 2 3
//   param=6
//   anyLength=3
//   objectLength=2
//   added=[{"name":"a"},{"name":"b"},{"name":"c"},"x"]
//   null list
//   notList=-1
//   noLength=-2
//
// Regression: a `list<any>` taken from a JSON array kept the array's
// JSON-tree layout (`[count][element pointers]`), which is not a Clean
// list's (16-byte header): iterating it trapped and `.get(i)` read the
// wrong words. `.length()` on an `any` printed the value and returned 0
// (the unresolved method fell through to the print function), and
// iterating an `any` was rejected. A JSON array is now copied into a
// `list<any>` where an `any` becomes a list, `.length()` of an `any` is the
// array, object or string length, and a value that is neither raises.

start:
	string text = "{\"results\": [{\"name\": \"a\"}, {\"name\": \"b\"}, {\"name\": \"c\"}], \"ids\": [1, 2, 3], \"none\": null, \"n\": 5}"
	any data = json.textToData(text)
	printl("indexed=" + data.results[1].name)
	list<any> items = data.results
	printl("count=" + items.length().toString())
	any first = items.get(0)
	printl("get=" + first.name)
	iterate item in items
		printl(item.name)
	string direct = ""
	iterate id in data.ids
		direct = direct + " " + id.toString()
	printl("direct=" + direct.trim())
	printl("param=" + sumIds(data).toString())
	any ids = data.ids
	printl("anyLength=" + ids.length().toString())
	any small = json.textToData("{\"a\": 1, \"b\": 2}")
	printl("objectLength=" + small.length().toString())
	items.add("x")
	printl("added=" + json.encode(items))
	list<any> empty = data.none
	if empty == null
		printl("null list")
	integer notList = countOf(data.n) onError -1
	printl("notList=" + notList.toString())
	integer noLength = data.n.length() onError -2
	printl("noLength=" + noLength.toString())

functions:
	integer sumIds(any d)
		integer total = 0
		iterate id in d.ids
			integer v = id
			total = total + v
		return total

	integer countOf(any value)
		list<any> values = value
		return values.length()
