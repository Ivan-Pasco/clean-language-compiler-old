// Expected output:
// Expected error:
//   Expected name
//   class_method_parse_error_reported.cln:14:19
//
// A parse error inside a class method was logged and dropped: the class
// silently lost that method and every method after it.

class Counter
	functions:
		void add(integer)
			print(1)

		integer get()
			return 2

start:
	Counter c = Counter()
	print(c.get())
