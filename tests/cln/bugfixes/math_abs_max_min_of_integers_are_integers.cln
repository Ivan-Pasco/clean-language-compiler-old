// Test: bugfixes/math_abs_max_min_of_integers_are_integers
// Grammar: call_expression (math.abs, math.max, math.min), method_call (toString)
// Semantic: stdlib-reference.md §2 — math.abs, math.max and math.min of
//   integers return an integer; integer arithmetic wraps, so the absolute
//   value of the smallest integer is that integer
// Fixed in: compiler 0.33.183
// Expected output:
//   5
//   2.5
//   9
//   -4
//   7
//   -2147483648
//
// Regression: the type checker typed these calls `integer`, but the code
// always called the `number` implementations, so using the result as an
// integer (`math.abs(v).toString()`) produced invalid WebAssembly, and the
// old integer abs trapped on -2147483648.

start:
	integer v = id(-5)
	print(math.abs(v).toString())
	number n = -2.5
	print(math.abs(n).toString())
	print(math.max(v, 9).toString())
	print(math.min(v + 1, 3).toString())
	integer m = math.abs(id(-7))
	print(m.toString())
	integer smallest = id(-2147483647) - 1
	print(math.abs(smallest).toString())

functions:
	integer id(integer v)
		return v
