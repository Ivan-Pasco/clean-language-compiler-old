// Test: bugfixes/integer64_to_integer_conversion
// Grammar: method_call (toInteger) on an integer:64 receiver
// Semantic: type-system.md §7 — explicit conversion from integer:64 to integer
// Fixed in: compiler 0.33.160
// Regression: `.toInteger()` on an integer:64 value produced invalid WASM
//   (an i64 where an i32 was expected); found while fixing #17, where it is
//   the explicit replacement for a forbidden implicit narrowing.
// Expected output:
//   42
//   1234567890

start:
	integer:64 small = 42
	print(small.toInteger().toString())
	integer:64 wide = 1234567890
	integer:32 narrow = wide.toInteger()
	print(narrow.toString())
