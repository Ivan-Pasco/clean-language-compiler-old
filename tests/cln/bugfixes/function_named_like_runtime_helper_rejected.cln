// Test: bugfixes/function_named_like_runtime_helper_rejected
// Grammar: function_declaration
// Semantic: SEM003 symbol redefinition (a function may not redefine a name
//   the runtime defines)
// Fixed in: compiler 0.33.176
// Expected output:
// Expected error:
//   error[SEM003]: function name 'string_to_int' is reserved
//   function_named_like_runtime_helper_rejected.cln:23:
//   help: rename the function
//
// Program functions and the compiler's runtime helpers share one function
// namespace, and runtime code calls its helpers by name. This function
// silently replaced the helper that parses a string held in `any`, so
// `integer n = data.n` returned 99.

start:
	any data = json.decode("{\"n\": \"5\"}")
	integer n = data.n
	print(n)

functions:
	integer string_to_int(string text)
		return 99
