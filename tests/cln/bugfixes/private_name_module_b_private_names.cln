// Test: bugfixes/private_name_module_b_private_names
// Semantic: module imported by private_names_per_file_no_collision.cln; its
//   private `helper` and `state: calls` share names with the other modules
// Fixed in: compiler 0.33.190
// Expected output:
//   module b start

start:
	print("module b start")

state:
	integer calls = 200

functions:
	integer helper()
		calls = calls + 1
		return 2
	public:
		integer fromB()
			return helper() + calls
