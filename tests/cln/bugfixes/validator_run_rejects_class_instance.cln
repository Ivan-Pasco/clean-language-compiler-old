// Test: bugfixes/validator_run_rejects_class_instance
// Grammar: function_call (validator.run)
// Semantic: SEM001 — stdlib-reference §15: `validator.run(v, input)` checks
//   each field against the entry of the pairs (or JSON object) input with the
//   field's name; a class instance has no such entries
// Fixed in: compiler 0.33.184
// Expected output:
// Expected error:
//   error[SEM001]
//   validator.run checks a pairs value, not a Person instance
//
// Regression: a class instance passed to `validator.run` compiled, and every
// field read as absent, so a required field always failed.

start:
	integer v = validator.required(validator.field(validator.create(), "name"))
	Person p = Person("Ada")
	print(validator.isOk(validator.run(v, p)))

class Person
	string name

	constructor(string n)
		name = n
