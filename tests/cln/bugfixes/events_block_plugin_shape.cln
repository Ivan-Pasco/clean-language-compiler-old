// Test: bugfixes/events_block_plugin_shape
// Changed in 0.33.187: events: only exists in frame.ui component: blocks (developer decision)
// Grammar: grammar.ebnf class_body_item (no events section);
//          frame-ui.ebnf events_section belongs to component_block only
// Semantic: SYN002 — `events:` after a plain class's fields is rejected
//           too (the shape frame.ui once emitted as class text; it now
//           emits component classes through typed emission).
// Fixed in: compiler 0.33.187
// Expected output:
// Expected error:
//   error[SYN002]: `events:` is not a class section: event handlers belong in a frame.ui `component:` block
//   events_block_plugin_shape.cln:23:2

start:
	instance_my_toolbar.render()

state:
	MyToolbar instance_my_toolbar = MyToolbar()

class MyToolbar
	string _slot_content = ""

	events:
		do_thing():
			_slot_content = "clicked"

	functions:
		string render()
			return "<button id='b'>Click</button>"
