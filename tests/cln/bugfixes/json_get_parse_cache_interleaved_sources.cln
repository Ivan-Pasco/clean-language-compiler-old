// Test: bugfixes/json_get_parse_cache_interleaved_sources
// Regression: dashboard #19cd8092 (2026-07-21)
// Fixed in: compiler 0.33.123
//
// The 0.30.369 single-entry parse cache (globals 1-3) covered stable-source
// loops but thrashed on the two-source interleaved shape produced by SSR
// pages that render row-lists where each row carries its own inner JSON.
// The errors-dashboard `/tasks?origin=error` page hit this on ~30 rows:
//
//   while row != "":
//       columns... = json.get(row, "field_N")          ← primes cache with row (list_result)
//       inner_json = json.get(row, "components_json")
//       while comp != "":
//           comp = json.get(inner_json, "0")           ← EVICTS list_result
//           ...
//       row = json.get(outer, next_index)              ← miss, full re-parse of outer
//
// Each outer iteration re-parsed the ~O(rows × 250b) outer source; at 30
// rows the cumulative bump-heap use blew the module's declared 128 MB
// memory cap and the wasmtime host trapped in memory.grow.
//
// 0.33.123 widens the cache to a 4-entry round-robin LRU (globals 1-12,
// insert cursor at 13). Two interleaved sources always both fit, so the
// per-iteration re-parse of `outer` never happens. The rewrite is at
// src/stdlib/json_class.rs `json.get` shim; layout constants live in
// src/codegen/native_stdlib/mod.rs.
//
// Grammar: json.get is a compiler builtin, not a user-visible grammar rule.
//   Referenced by foundation/spec/stdlib-reference.md §8.
// Semantic: no semantic rule changes — same call site behavior.
//
// Expected output:
//   30
//   1200
//   OK

start:
	// Build the outer JSON: 30 rows each carrying a JSON-encoded inner array.
	// Padding on each row makes the outer source large enough that repeated
	// re-parsing would visibly consume memory (matches the tasks_list_page
	// row shape).
	string base = "{\"origin\":\"error\",\"components\":\"[\\\"compiler\\\",\\\"server\\\",\\\"framework\\\",\\\"canvas\\\",\\\"ui\\\",\\\"mcp\\\"]\",\"filler\":\"padding-string-that-makes-the-outer-json-source-larger-so-re-parse-cost-shows-up-in-memory-usage\"}"
	string outer = "["
	integer j = 0
	while j < 30
		if j > 0
			outer = outer + ","
		outer = outer + base
		j = j + 1
	outer = outer + "]"

	// Interleaved-source render loop. Each outer iteration reads several
	// fields from `outer` (via row-index paths) AND runs an inner loop over
	// the row's `components_json`. With the single-entry cache, the inner
	// loop's first call evicted `outer`; the next outer iteration re-parsed
	// the whole outer source. With the 4-entry LRU both stay hot.
	string acc = ""
	integer i = 0
	string row = json.get(outer, i.toString())
	while row != ""
		string origin = json.get(row, "origin")
		string components_json = json.get(row, "components")

		integer c = 0
		string comp = json.get(components_json, c.toString())
		while comp != ""
			acc = acc + comp + ";"
			c = c + 1
			comp = json.get(components_json, c.toString())

		i = i + 1
		row = json.get(outer, i.toString())

	printl(i.toString())
	printl(acc.length().toString())

	// Sanity: three distinct sources touched below still work — proves LRU
	// eviction happens correctly (older entries roll off) and doesn't
	// corrupt the tree pointers.
	string s1 = "{\"a\":1}"
	string s2 = "{\"a\":2}"
	string s3 = "{\"a\":3}"
	string s4 = "{\"a\":4}"
	string v1 = json.get(s1, "a")
	string v2 = json.get(s2, "a")
	string v3 = json.get(s3, "a")
	string v4 = json.get(s4, "a")
	// re-touch s1 (evicted by s4 if LRU had 3 slots; still cached with 4)
	string v1b = json.get(s1, "a")
	if v1 == "1" and v2 == "2" and v3 == "3" and v4 == "4" and v1b == "1"
		printl("OK")
	else
		printl("FAIL")
