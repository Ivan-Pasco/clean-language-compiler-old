// Test: bugfixes/same_public_name_greetings
// Semantic: module imported by same_public_name_two_modules.cln; its public
//   `message()` and `state: count` share names with the other module
// Fixed in: compiler 0.33.194
// Expected output:
//   greetings loaded

start:
	print("greetings loaded")

state:
	public:
		integer count = 10

functions:
	public:
		string message()
			return "hello"

		integer bump()
			count = count + 1
			return count
