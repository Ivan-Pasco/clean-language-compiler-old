// Test: bugfixes/matrix_methods_compute
// Grammar: method_call, expression
// Semantic: 06-expressions.md Matrix Operations, stdlib-reference.md Matrix Methods
// Fixed in: compiler 0.33.190
// Expected output:
//   -2
//   [[1.0,3.0],[2.0,4.0]]
//   [[-2.0,1.0],[1.5,-0.5]]
//   2
//   3
//   [[1,4],[2,5],[3,6]]
//   -3
//   24
//   0
//   [[1,0],[0,1]]
//   1
//   [[2.0,0.0],[0.0,4.0]]
//
// Regression: `A.determinant()`, `A.transpose()` and `A.inverse()` compiled
// to a print of the matrix pointer, and `.rows()` / `.cols()` returned 0.

start:
	matrix<number> a = [[1.0, 2.0], [3.0, 4.0]]
	print(a.determinant())
	print(a.transpose())
	print(a.inverse())
	matrix<integer> b = [[1, 2, 3], [4, 5, 6]]
	print(b.rows())
	print(b.cols())
	print(b.transpose())
	matrix<integer> c = [[1, 2, 3], [4, 5, 6], [7, 8, 10]]
	print(c.determinant())
	matrix<number> d = [[2.0, 0.0, 0.0], [0.0, 3.0, 0.0], [0.0, 0.0, 4.0]]
	print(d.determinant())
	matrix<number> singular = [[1.0, 2.0], [2.0, 4.0]]
	print(singular.determinant())
	matrix<integer> id = [[1, 0], [0, 1]]
	print(id)
	print(id.determinant())
	matrix<number> e = [[0.5, 0.0], [0.0, 0.25]]
	print(e.inverse())
