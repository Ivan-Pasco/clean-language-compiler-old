// Test: bugfixes/list_number_slot_access
// Semantic: stdlib-reference.md §5 — `.get`, `.set`, `.pop`, `.removeLast`,
//   `.remove()` and their `list.<method>(items, ...)` namespace forms work on
//   list<number>, whose elements are 8-byte values.
// Fixed in: compiler 0.33.165
// Regression: `get` read 4-byte slots (1073217536 for 2.5), `set` and the
//   namespace forms failed WASM validation, and `pop` / `removeLast` /
//   `.remove()` returned 0 without removing anything.
// Expected output:
//   2.5 3.5
//   9.5 8.5
//   8.5 3.5 3.5
//   true 2 1
//   5 4.5 5.5
//   0.5 0.25
//   pop 5.5 4.5 5
//   last 3.5 9.5 3
//   remove 8.5 2
//   2 -1
//   1.5 1.5
//
// Changed in 0.33.184: `list.<method>(items, ...)` namespace calls are now the
// method form `items.<method>(...)`; the `list.` namespace has only concat,
// range, fill and join (developer decision)

start:
	list<number> a = [1.5, 2.5, 3.5]
	number x = a.get(2)
	print(a.get(1).toString() + " " + x.toString())
	a.set(1, 9.5)
	a.set(0, 8.5)
	print(a[1].toString() + " " + a.get(0).toString())
	number f = a.first()
	number l = a.last()
	number p = a.peek()
	print(f.toString() + " " + l.toString() + " " + p.toString())
	print(a.contains(9.5).toString() + " " + a.indexOf(3.5).toString() + " " + a.lastIndexOf(9.5).toString())
	a.add(4.5)
	a.add(5.5)
	print(a.length().toString() + " " + a[3].toString() + " " + a[4].toString())
	a.insert(0, 0.5)
	a.insert(1, 0.25)
	print(a[0].toString() + " " + a[1].toString())
	number p1 = a.pop()
	number p2 = a.removeLast()
	print("pop " + p1.toString() + " " + p2.toString() + " " + a.length().toString())
	number r1 = a.removeLast()
	number r2 = a.removeLast()
	print("last " + r1.toString() + " " + r2.toString() + " " + a.length().toString())
	number r3 = a.remove()
	print("remove " + r3.toString() + " " + a.length().toString())
	list<number> s = a.sort()
	print(s.length().toString() + " " + a.indexOf(8.5).toString())
	list<number> b = [2.5, 1.5]
	list<number> sorted = b.sort()
	print(sorted.get(0).toString() + " " + b.reverse().get(0).toString())
