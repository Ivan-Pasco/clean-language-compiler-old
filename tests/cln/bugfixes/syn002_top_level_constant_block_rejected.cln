// Test: bugfixes/syn002_top_level_constant_block_rejected
// Grammar: constant_apply_block
// Semantic: SYN002 — an apply block (`constant:`) is a statement; at file top level it is rejected with a message saying where it belongs (semantic-rules.md §SYN002)
// Fixed in: compiler 0.33.184
// Expected output:
// Expected error:
//   SYN002
//   An apply block like `constant:` must be inside `start:` or a function body
//
// Regression: reported as SYN001 "Unexpected token at top level: Constant".

constant:
	integer LIMIT = 4

start:
	print("test")
