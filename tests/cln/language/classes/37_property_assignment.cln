start:
	testPropertyAssignment()// Test property assignment functionality for list behavior modifiers

functions:
	void testPropertyAssignment()
		// Fixed: was items.type = "line" (behavior assigned at runtime), spec requires
		// the behavior in the declared type, list<T>.line / .pile / .unique
		// (foundation/spec/type-system.md "List Behavior Modes", grammar.ebnf list_behavior)
		list<integer>.line queue = [1, 2, 3]
		list<integer>.pile stack = [1, 2, 3]
		list<integer>.unique distinct = [1, 2, 3]
		list<integer>.line.unique uniqueQueue = [1, 2, 3]
		print(queue.length() + stack.length() + distinct.length() + uniqueQueue.length())
