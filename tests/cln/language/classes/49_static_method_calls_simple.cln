// Simple QA Test for Static Method Calls
// Tests basic static method call syntax

functions:

	void testStaticMethods()

		// Test math class static methods (lowercase)
		number result = math.max(5.0, 3.0)
		print("math.max(5.0, 3.0): ")
		print(result.toString())
		number absolute = math.abs(-42.5)
		print("math.abs(-42.5): ")
		print(absolute.toString())
		print("Static method calls test completed successfully!")

start()

	print("Static Method Calls QA Test")
	testStaticMethods()
	print("Test completed")