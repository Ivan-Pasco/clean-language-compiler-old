// Spec Section: 10.4 - Implicit Context
// Changed in 0.33.186: this. is not part of Clean (developer decision)
// Tests: fields and methods of the same object named by their bare names within class methods

start:
	MyComponent comp = MyComponent()
	printl(comp.render())

class MyComponent
	string name
	string tag

	constructor()
		name = "test"
		tag = "my-tag"

	functions:
		string getName()
			return name

		public:
			string render()
				string result = "<" + tag + ">"
				result = result + getName()
				result = result + "</" + tag + ">"
				return result
