start:

	print("Lowercase Namespace Calls QA Test")
	testLowercaseMethods()
	print("Test completed")// Spec Section: 7.1 - Standard Library Organization (Namespaces)
// Spec Section: 7.2 - math Namespace
// Spec Section: 7.3 - string Namespace
// Spec Section: 7.4 - list Namespace
// Spec Section: 7.5 - file Namespace
// Tests: Lowercase namespace static method calls

functions:

	void testLowercaseMethods()

		// Test math namespace methods - using operators for basic math
		number result = 5.0 + 3.0
		print("5.0 + 3.0: ")
		print(result.toString())

		number maximum = math.max(10.5, 7.2)
		print("math.max(10.5, 7.2): ")
		print(maximum.toString())

		number absolute = math.abs(-42.5)
		print("math.abs(-42.5): ")
		print(absolute.toString())

		// Test string namespace methods
		integer textLength = string.size("Hello World")
		print("string.size('Hello World'): ")
		print(textLength.toString())

		string upperText = string.toUpperCase("hello")
		print("string.toUpperCase('hello'): ")
		print(upperText)

		string lowerText = string.toLowerCase("WORLD")
		print("string.toLowerCase('WORLD'): ")
		print(lowerText)

		boolean contains = string.contains("Hello World", "World")
		print("string.contains('Hello World', 'World'): ")
		print(contains.toString())

		string trimmed = string.trim("  spaced  ")
		print("string.trim('  spaced  '): '")
		print(trimmed)
		print("'")

		// Test list namespace methods
		list<integer> numbers = [1, 2, 3, 4, 5]
		integer myListLength = list.size(numbers)
		print("list.size([1,2,3,4,5]): ")
		print(myListLength.toString())

		integer firstItem = list.get(numbers, 0)
		print("list.get(numbers, 0): ")
		print(firstItem.toString())

		boolean hasItem = list.contains(numbers, 3)
		print("list.contains(numbers, 3): ")
		print(hasItem.toString())

		// Test file namespace methods
		boolean myFileExists = file.exists("test.txt")
		print("file.exists('test.txt'): ")
		print(myFileExists.toString())

		print("Lowercase namespace calls test completed successfully!")

