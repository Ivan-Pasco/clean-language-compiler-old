start:
	Animal animal = Animal("Fluffy", 5)

	print("Class definitions test successful!")
	print("Animal: " + animal.getName() + ", Age: " + animal.getAge().toString())// Spec Section: 10.1 - Class Definition
// Spec Section: 10.2 - Constructor
// Spec Section: 10.4 - Implicit Context
// Tests: Basic class definition with fields, constructor, and methods
// Category: oop
// Dependencies: none
// Expected: PASS

// Fixed: the constructor assigned `name = name` from parameters named like
// the fields; CLASS007 forbids that (semantic-rules.md §CLASS007), and a
// constructor without a body stores such parameters itself.
class Animal
	string name
	integer age

	constructor(string name, integer age)

	functions:
		public:
			string getName()
				return name

			integer getAge()
				return age

