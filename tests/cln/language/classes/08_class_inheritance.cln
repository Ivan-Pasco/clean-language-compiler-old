start:
	Animal animal = Animal("Fluffy", 5)
	Dog dog = Dog("Rex", 3, "Labrador")

	print("Class inheritance test successful!")
	print("Animal: " + animal.getName() + ", Age: " + animal.getAge().toString())
	print("Dog: " + dog.getName() + ", Breed: " + dog.getBreed())
	print("Dog says: " + dog.speak())// Spec Section: 10.1 - Class Definition
// Spec Section: 10.3 - Inheritance
// Spec Section: 10.3.2 - base() Constructor Call
// Tests: Class inheritance with base constructor calls
// Category: oop
// Dependencies: none
// Expected: PASS

// Fixed: the constructors assigned `name = name` from parameters named like
// the fields; CLASS007 forbids that (semantic-rules.md §CLASS007), and a
// constructor without a body stores such parameters itself;
// Dog's constructor calls base(), so its parameters are renamed.
class Animal
	string name
	integer age

	constructor(string name, integer age)

	functions:
		public:
			string getName()
				return name

			integer getAge()
				return age

class Dog is Animal
	string breed

	constructor(string dogName, integer dogAge, string dogBreed)
		base(dogName, dogAge)
		breed = dogBreed

	functions:
		public:
			string getBreed()
				return breed

			string speak()
				return "Woof!"

