// Test: language/state_management/reset_statement
// Grammar: grammar.ebnf reset_statement = "reset" , ( "state" | identifier ) ;
// Semantic: N/A — reset is a runtime state operation
// Expected output:
//   10
//   reset works
// Fixed: state declarations require a type per state_declaration grammar rule;
//        start: must appear before state: per SYN007 section ordering rule

start:
	count = 10
	print(count)
	reset count
	print("reset works")

state:
	integer count = 0
