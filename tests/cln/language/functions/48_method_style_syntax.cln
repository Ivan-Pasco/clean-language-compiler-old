// Comprehensive QA Test for Method-Style Syntax
// Tests all enhanced method-style calls supported by the parser

start:
	// Test utility methods on values
	string text = "Hello World"
	integer length = text.length()
	print("Text length: ")
	print(length.toString())

	// Test type conversion methods
	integer age = 25
	number ageFloat = age.toNumber()
	string ageText = age.toString()
	boolean ageValid = age.toBoolean()

	print("Age: ")
	print(ageText)
	print(" as number: ")
	print(ageFloat.toString())
	print(" as boolean: ")
	print(ageValid.toString())

	// Test validation with basic conditions
	integer score = 85
	if score <= 0
		print("Score must be positive")
	if score > 100
		print("Score must be <= 100")

	string email = "user@example.com"
	if string.isEmpty(email)
		print("Email cannot be empty")

	string password = "secret123"
	string confirmPassword = "secret123"
	if password != confirmPassword
		print("Passwords do not match")

	// Test boundary checking with basic logic
	integer volume = 150
	integer safeVolume = volume
	if safeVolume < 0
		safeVolume = 0
	if safeVolume > 100
		safeVolume = 100
	print("Safe volume: ")
	print(safeVolume.toString())

	// Test existence checking with basic logic
	string username = "alice"
	boolean exists = string.size(username) > 0
	boolean missing = string.size(username) == 0
	print("Username exists: ")
	print(exists.toString())

	// Test empty/not empty with basic logic
	list<integer> numbers = [1, 2, 3]
	boolean isEmpty = list.size(numbers) == 0
	boolean notEmpty = list.size(numbers) > 0
	print("Numbers empty: ")
	print(isEmpty.toString())
	print("Numbers not empty: ")
	print(notEmpty.toString())

	// Test method chaining
	string messyInput = "  Hello  "
	string cleanInput = messyInput.toString()
	print("Cleaned input: ")
	print(cleanInput)

	print("Method-style syntax test completed successfully!")