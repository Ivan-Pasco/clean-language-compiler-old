start:
	print("Conditional Simple Test")
	testConditionals()
	print("Test completed")
// Simple test of conditional operators

functions:
	void testConditionals()
		print("Testing conditional operators")
		integer a = 10
		integer b = 5

		boolean greater = a > b
		print("10 > 5: " + greater.toString())

		integer max = 0
		if greater
			max = a
		else
			max = b
		print("Max of 10 and 5: " + max.toString())
