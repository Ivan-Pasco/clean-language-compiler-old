// Spec Section: 5.2 - Iteration (iterate)
// Spec Section: 5.2.1 - Range Iteration
// Spec Section: 5.2.2 - Collection Iteration
// Tests: iterate loops with ranges and list collections

start:
	list<integer> numbers = [1, 2, 3, 4, 5]

	iterate i in 0 to 3
		print(i)

	iterate num in numbers
		print(num)