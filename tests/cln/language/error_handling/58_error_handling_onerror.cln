// Error handling with onError syntax comprehensive test
// According to Clean Language Specification, onError provides error recovery

functions:
	integer safeDivide(integer a, integer b)
		if b == 0
			return 0
		return a / b

	string readFileContents(string filename)
		if filename == ""
			return "default content"
		return "file contents"

	void testErrorHandling()
		// Test onError with fallback value
		integer result1 = safeDivide(10, 2)
		print("Safe division result: " + result1.toString())

		// Test onError with division by zero (handled internally now)
		integer result2 = safeDivide(10, 0)
		print("Division by zero handled: " + result2.toString())

		// Test file reading with valid filename
		string contents1 = readFileContents("valid.txt")
		print("File contents: " + contents1)

		// Test file reading with empty filename (handled internally now)
		string contents2 = readFileContents("")
		print("Error handled: " + contents2)

		// Test calculation
		integer calculation = safeDivide(100, 5) + 5
		print("Calculation result: " + calculation.toString())

start()
	testErrorHandling()
	print("Error handling test completed successfully")