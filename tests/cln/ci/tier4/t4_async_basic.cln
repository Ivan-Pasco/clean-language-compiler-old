// CI Tier 4 | t4_async_basic
// Grammar: later_assignment, start_expression, function_in_block
// Purpose: Verify the spec'd async form (later name = start f()) compiles
// Fixed: was using an `async` function modifier and a `later f()` expression;
//   grammar.ebnf has neither. It requires `later name = start f()` and a
//   plain function in the `functions:` block.

start:
	later result = start fetchGreeting()
	print(result)

functions:
	string fetchGreeting()
		return "hello async"
