// CI Tier 1 | t1_arithmetic
// Grammar: binary arithmetic operators (+, -, *, /), integer expressions
// Purpose: Verify all four basic arithmetic operators on integers

start:
	integer a = 10
	integer b = 3
	printl((a + b).toString())
	printl((a - b).toString())
	printl((a * b).toString())
	printl((a / b).toString())
