// Test file for newly implemented host functions
// Tests math functions, memory management, and property access

start:
	print("Testing newly implemented host functions...")

	// Test math functions
	number x = 16.0
	number sqrtResult = math.sqrt(x)
	string sqrtStr = sqrtResult.toString()
	print("Square root of 16: " + sqrtStr)

	number absResult = math.abs(-42.0)
	string absStr = absResult.toString()
	print("Absolute value of -42: " + absStr)

	number powResult = math.pow(2.0, 3.0)
	string powStr = powResult.toString()
	print("2 to the power of 3: " + powStr)

	// Test property access (using string conversion)
	integer num = 12345
	string numStr = num.toString()
	integer digits = numStr.length()
	string digitsStr = digits.toString()
	print("Number of digits in 12345: " + digitsStr)

	number floatNum = 123.456
	string floatStr = floatNum.toString()
	integer floatDigits = floatStr.length()
	string floatDigitsStr = floatDigits.toString()
	print("Number of digits in 123.456: " + floatDigitsStr)

	print("Host function tests completed!")