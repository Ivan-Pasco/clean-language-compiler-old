	void testMathOperations()
		print("=== Math Operations - Specification Compliant ===")
		// Basic arithmetic - use operators per Clean Language "one way to do things"
		number a = 15.5
		number b = 4.2
		print("Basic math: " + a.toString() + " + " + b.toString() + " = " + (a + b).toString())
		print("Basic math: " + a.toString() + " - " + b.toString() + " = " + (a - b).toString())
		print("Basic math: " + a.toString() + " * " + b.toString() + " = " + (a * b).toString())
		print("Basic math: " + a.toString() + " / " + b.toString() + " = " + (a / b).toString())
		// Advanced math functions - use lowercase namespace functions
		number x = 16.0
		print("math.sqrt(" + x.toString() + ") = " + math.sqrt(x).toString())
		print("math.abs(-" + x.toString() + ") = " + math.abs(-x).toString())
		print("math.max(" + a.toString() + ", " + b.toString() + ") = " + math.max(a, b).toString())
		print("math.min(" + a.toString() + ", " + b.toString() + ") = " + math.min(a, b).toString())
		// Rounding functions
		number decimal = 3.7456
		print("math.floor(" + decimal.toString() + ") = " + math.floor(decimal).toString())
		print("math.ceil(" + decimal.toString() + ") = " + math.ceil(decimal).toString())
		print("math.round(" + decimal.toString() + ") = " + math.round(decimal).toString())
		print("math.trunc(" + decimal.toString() + ") = " + math.trunc(decimal).toString())
		// Trigonometric functions
		number angle = math.pi() / 4.0
		print("math.sin(pi/4) = " + math.sin(angle).toString())
		print("math.cos(pi/4) = " + math.cos(angle).toString())
		print("math.tan(pi/4) = " + math.tan(angle).toString())
		// Logarithmic functions
		number value = 10.0
		print("math.ln(" + value.toString() + ") = " + math.ln(value).toString())
		print("math.log10(" + value.toString() + ") = " + math.log10(value).toString())
		print("math.exp(1.0) = " + math.exp(1.0).toString())
		// Constants
		print("math.pi() = " + math.pi().toString())
		print("math.e() = " + math.e().toString())
		print("math.tau() = " + math.tau().toString())

	void testStringOperations()
		print("=== String Operations - Specification Compliant ===")
		string text = "Hello, Clean Language World!"
		string search = "Clean"
		// Method-style string operations (preferred pattern)
		print("text.length() = " + text.length().toString())
		print("text.toUpperCase() = " + text.toUpperCase())
		print("text.toLowerCase() = " + text.toLowerCase())
		// String utility functions (lowercase namespace)
		boolean containsResult = string.contains(text, search)
		print("string.contains result = " + containsResult.toString())
		integer indexResult = string.indexOf(text, search)
		print("string.indexOf result = " + indexResult.toString())
		integer lastIndexResult = string.lastIndexOf(text, "l")
		print("string.lastIndexOf result = " + lastIndexResult.toString())
		boolean startsWithResult = string.startsWith(text, "Hello")
		print("string.startsWith result = " + startsWithResult.toString())
		boolean endsWithResult = string.endsWith(text, "World!")
		print("string.endsWith result = " + endsWithResult.toString())
		// String manipulation with utility functions
		string padded = "  trim test  "
		print("Original string: " + padded)
		print("string.trim result: " + string.trim(padded))
		print("string.trimStart result: " + string.trimStart(padded))
		print("string.trimEnd result: " + string.trimEnd(padded))
		// String replacement
		string original = "The quick brown fox"
		print("string.replace result = " + string.replace(original, "quick", "slow"))
		print("string.substring result = " + string.substring(original, 4, 9))

	void testListOperations()
		print("=== List Operations - Specification Compliant ===")
		list<integer> numbers = [1, 2, 3, 4, 5]
		list<string> words = ["apple", "banana", "cherry"]
		// Method-style list operations (preferred pattern)
		print("numbers.size() = " + numbers.size().toString())
		print("words.size() = " + words.size().toString())
		// List access and modification
		integer numberElement = numbers[2]
		print("numbers[2] = " + numberElement.toString())
		print("words[1] = " + words[1])
		// List utility functions (lowercase namespace)
		list.add(numbers, 6)
		print("After list.add(6): length = " + numbers.size().toString())
		integer removed = list.remove(numbers, numbers.size() - 1)
		print("Removed element: " + removed.toString())
		print("After list.remove: length = " + numbers.size().toString())
		// List searching with utility functions
		print("list.contains(numbers, 3) = " + list.contains(numbers, 3).toString())
		print("list.contains(words, \"grape\") = " + list.contains(words, "grape").toString())
		// List iteration
		print("Numbers iteration:")
		iterate num in numbers
			print("  " + num.toString())

	void testFileOperations()
		print("=== File Operations ===")
		string filename = "test_file.txt"
		string content = "Hello from Clean Language!"
		// File operations (simplified for testing)
		print("Testing file operations with: " + filename)
		print("Content to write: " + content)
		// Note: Actual file I/O would be tested in integration tests
		// Here we just demonstrate the syntax
		boolean writeResult = file.write(filename, content)
		print("file.write() result: " + writeResult.toString())
		boolean exists = file.exists(filename)
		print("file.exists() result: " + exists.toString())
		if exists
			string readContent = file.read(filename)
			print("file.read() result: " + readContent)
			boolean appendResult = file.append(filename, " Appended text!")
			print("file.append() result: " + appendResult.toString())
			boolean deleteResult = file.delete(filename)
			print("file.delete() result: " + deleteResult.toString())
