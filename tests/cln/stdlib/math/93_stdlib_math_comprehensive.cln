start:
	print("Standard Library Math Module Test")
	print("=================================")
	testCoreMathOperations()
	print("")
	testRoundingFunctions()
	print("")
	testTrigonometricFunctions()
	print("")
	testLogarithmicFunctions()
	print("")
	testHyperbolicFunctions()
	print("")
