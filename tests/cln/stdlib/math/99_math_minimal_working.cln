start:
	print("Math Module Minimal Test")
	print("========================")
	testImplementedMathFunctions()
	print("")
	testBasicArithmeticOperators()
	print("")
	testPracticalExample()
	print("")
	testAbsoluteValues()
	print("")
	print("Minimal math test completed successfully")// Math Module Minimal Working Test
// Tests only the actually implemented mathematical functions

functions:
	void testImplementedMathFunctions()
		print("=== Implemented Math Functions ===")
		// Test functions that are actually implemented
		number sqrtResult = math.sqrt(16.0)
		integer absResult = math.abs(-42)
		number maxResult = math.max(10.5, 7.2)
		number minResult = math.min(10.5, 7.2)

		print("sqrt(16.0) = " + sqrtResult.toString())
		print("abs(-42) = " + absResult.toString())
		print("max(10.5, 7.2) = " + maxResult.toString())
		print("min(10.5, 7.2) = " + minResult.toString())
	void testBasicArithmeticOperators()
		print("=== Basic Arithmetic with Operators ===")
		// Use operators for basic math as specified
		number a = 15.0
		number b = 4.0

		number sum = a + b
		number difference = a - b
		number product = a * b
		number quotient = a / b
		number power = a ^ 2.0

		print("15.0 + 4.0 = " + sum.toString())
		print("15.0 - 4.0 = " + difference.toString())
		print("15.0 * 4.0 = " + product.toString())
		print("15.0 / 4.0 = " + quotient.toString())
		print("15.0 ^ 2.0 = " + power.toString())
	void testPracticalExample()
		print("=== Practical Example ===")
		// Pythagorean theorem calculation
		number side1 = 3.0
		number side2 = 4.0

		number side1Squared = side1 * side1
		number side2Squared = side2 * side2
		number sumOfSquares = side1Squared + side2Squared
		number hypotenuse = math.sqrt(sumOfSquares)

		print("Triangle sides: " + side1.toString() + ", " + side2.toString())
		print("Hypotenuse: " + hypotenuse.toString())
	void testAbsoluteValues()
		print("=== Absolute Values ===")
		integer negative = -15
		integer positive = 25
		integer zero = 0

		integer absNeg = math.abs(negative)
		integer absPos = math.abs(positive)
		integer absZero = math.abs(zero)

		print("abs(-15) = " + absNeg.toString())
		print("abs(25) = " + absPos.toString())
		print("abs(0) = " + absZero.toString())
