// Test 76: Comprehensive Math Module Operations
// Tests all math functions: sqrt, abs, max, min, trig functions, log functions, constants

start()
	// Basic math operations
	number value = 16.0
	number sqrtResult = math.sqrt(value)
	print "sqrt(16) = " + sqrtResult.toString() ln
	
	// Absolute value functions
	number negativeNum = -5.7
	integer negativeInt = -42
	number absNum = math.abs(negativeNum)
	integer absInt = math.abs(negativeInt)
	print "abs(-5.7) = " + absNum.toString() ln
	print "abs(-42) = " + absInt.toString() ln
	
	// Min/max functions
	number max = math.max(10.5, 7.2)
	number min = math.min(10.5, 7.2)
	print "max(10.5, 7.2) = " + max.toString() ln
	print "min(10.5, 7.2) = " + min.toString() ln
	
	// Rounding functions
	number decimal = 19.99567
	number rounded = math.round(decimal)
	number floored = math.floor(decimal)
	number ceiled = math.ceil(decimal)
	number truncated = math.trunc(decimal)
	print "round(19.99567) = " + rounded.toString() ln
	print "floor(19.99567) = " + floored.toString() ln
	print "ceil(19.99567) = " + ceiled.toString() ln
	print "trunc(19.99567) = " + truncated.toString() ln
	
	// Trigonometric functions
	number angle = math.pi() / 4.0  // 45 degrees in radians
	number sine = math.sin(angle)
	number cosine = math.cos(angle)
	number tangent = math.tan(angle)
	print "sin(π/4) = " + sine.toString() ln
	print "cos(π/4) = " + cosine.toString() ln
	print "tan(π/4) = " + tangent.toString() ln
	
	// Inverse trigonometric functions
	number arcSine = math.asin(0.5)
	number arcCosine = math.acos(0.5)
	number arcTangent = math.atan(1.0)
	print "asin(0.5) = " + arcSine.toString() ln
	print "acos(0.5) = " + arcCosine.toString() ln
	print "atan(1.0) = " + arcTangent.toString() ln
	
	// Logarithmic and exponential functions
	number natural = math.ln(math.e())
	number log10 = math.log10(100.0)
	number log2 = math.log2(8.0)
	number exp = math.exp(1.0)
	number exp2 = math.exp2(3.0)
	print "ln(e) = " + natural.toString() ln
	print "log10(100) = " + log10.toString() ln
	print "log2(8) = " + log2.toString() ln
	print "exp(1) = " + exp.toString() ln
	print "exp2(3) = " + exp2.toString() ln
	
	// Mathematical constants
	number pi = math.pi()
	number e = math.e()
	number tau = math.tau()
	print "π = " + pi.toString() ln
	print "e = " + e.toString() ln
	print "τ = " + tau.toString() ln