// Tests all string manipulation functions as specified

functions:
	void testBasicStringOperations()
		print("=== Basic String Operations ===")
		string text = "Hello World"

		// Length and basic operations
		integer textLength = string.size(text)
		string concatenated = string.concat("Hello", " Clean")
		string substring = string.substring(text, 0, 5)

		print("Length of 'Hello World': " + textLength.toString())
		print("Concat 'Hello' + ' Clean': " + concatenated)
		print("Substring (0,5) of 'Hello World': " + substring)
	void testCaseOperations()
		print("=== Case Operations ===")
		string mixedCase = "Hello World"

		string upperCase = string.toUpperCase(mixedCase)
		string lowerCase = string.toLowerCase(mixedCase)

		print("Original: " + mixedCase)
		print("Upper case: " + upperCase)
		print("Lower case: " + lowerCase)
	void testSearchOperations()
		print("=== Search and Validation Operations ===")
		string text = "Hello World Hello"

		boolean containsWorld = string.contains(text, "World")
		boolean containsClean = string.contains(text, "Clean")
		integer firstHelloIndex = string.indexOf(text, "Hello")
		integer lastHelloIndex = string.lastIndexOf(text, "Hello")
		boolean startsWithHello = string.startsWith(text, "Hello")
		boolean endsWithHello = string.endsWith(text, "Hello")
		boolean startsWithWorld = string.startsWith(text, "World")
		boolean endsWithWorld = string.endsWith(text, "World")

		print("Text: '" + text + "'")
		print("Contains 'World': " + containsWorld.toString())
		print("Contains 'Clean': " + containsClean.toString())
		print("First 'Hello' at index: " + firstHelloIndex.toString())
		print("Last 'Hello' at index: " + lastHelloIndex.toString())
		print("Starts with 'Hello': " + startsWithHello.toString())
		print("Ends with 'Hello': " + endsWithHello.toString())
		print("Starts with 'World': " + startsWithWorld.toString())
		print("Ends with 'World': " + endsWithWorld.toString())
	void testTrimOperations()
		print("=== Text Cleaning and Formatting ===")
		string messyText = "   Hello World   "
		string leadingSpaces = "   Clean Language"
		string trailingSpaces = "Programming   "

		string trimmed = string.trim(messyText)
		string trimmedStart = string.trimStart(leadingSpaces)
		string trimmedEnd = string.trimEnd(trailingSpaces)

		print("Original messy: '" + messyText + "'")
		print("Trimmed: '" + trimmed + "'")
		print("Leading spaces: '" + leadingSpaces + "'")
		print("Trim start: '" + trimmedStart + "'")
		print("Trailing spaces: '" + trailingSpaces + "'")
		print("Trim end: '" + trimmedEnd + "'")
	void testAdvancedManipulation()
		print("=== Advanced Text Manipulation ===")
		string original = "Hello Hello World"

		// Replace operations
		string replaceFirst = string.replace(original, "Hello", "Hi")
		string replaceAll = string.replaceAll(original, "Hello", "Hi")

		print("Original: " + original)
		print("Replace first 'Hello': " + replaceFirst)
		print("Replace all 'Hello': " + replaceAll)
		// Split and join operations
		string csvData = "apple,banana,orange"
		list<string> fruits = string.split(csvData, ",")
		string rejoined = string.join(fruits, " | ")

		print("CSV data: " + csvData)
		print("Split result count: " + fruits.size().toString())
		print("Rejoined with |: " + rejoined)
	void testCharacterOperations()
		print("=== Character Operations ===")
		string word = "Hello"

		string firstChar = string.charAt(word, 0)
		string secondChar = string.charAt(word, 1)
		integer charCode = string.charCodeAt(word, 0)  // 'H' = 72
		integer charCode2 = string.charCodeAt(word, 1) // 'e' = 101

		print("Word: " + word)
		print("Character at index 0: " + firstChar)
		print("Character at index 1: " + secondChar)
		print("Char code at index 0 (H): " + charCode.toString())
		print("Char code at index 1 (e): " + charCode2.toString())
	void testValidationHelpers()
		print("=== Validation Helpers ===")
		string emptyStr = ""
		string spaceStr = "   "
		string normalStr = "Hello"

		boolean empty1 = string.isEmpty(emptyStr)
		boolean empty2 = string.isEmpty(normalStr)
		boolean blank1 = string.isBlank(emptyStr)
		boolean blank2 = string.isBlank(spaceStr)
		boolean blank3 = string.isBlank(normalStr)

		print("isEmpty(''): " + empty1.toString())
		print("isEmpty('Hello'): " + empty2.toString())
		print("isBlank(''): " + blank1.toString())
		print("isBlank('   '): " + blank2.toString())
		print("isBlank('Hello'): " + blank3.toString())
	void testPaddingOperations()
		print("=== Padding Operations ===")
		string number = "42"
		string name = "Alice"

		string paddedStart = string.padStart(number, 5, "0")
		string paddedEnd = string.padEnd(name, 10, " ")

		print("Original number: '" + number + "'")
		print("Padded start (5, '0'): '" + paddedStart + "'")
		print("Original name: '" + name + "'")
		print("Padded end (10, ' '): '" + paddedEnd + "'")
	void testRealWorldScenarios()
		print("=== Real-World String Processing ===")
		// Email validation scenario
		string email1 = "USER@EXAMPLE.COM"
		string email2 = "user@example.com"
		string normalizedEmail1 = string.toLowerCase(email1)
		boolean emailsMatch = normalizedEmail1 == string.toLowerCase(email2)

		print("Email 1: " + email1)
		print("Email 2: " + email2)
		print("Normalized match: " + emailsMatch.toString())
		// File processing scenario
		string filename = "document.pdf"
		boolean isPdf = string.endsWith(filename, ".pdf")
		integer dotPosition = string.lastIndexOf(filename, ".")
		string extension = string.substring(filename, dotPosition + 1, string.size(filename))

		print("Filename: " + filename)
		print("Is PDF: " + isPdf.toString())
		print("Extension: " + extension)
		// URL processing
		string url = "https://api.example.com/users"
		boolean isHttps = string.startsWith(url, "https://")
		boolean hasApi = string.contains(url, "api")

		print("URL: " + url)
		print("Is HTTPS: " + isHttps.toString())
		print("Contains 'api': " + hasApi.toString())
		// Text cleaning
		string userInput = "  Hello    World  "
		string cleaned = string.trim(userInput)
		string normalized = string.replaceAll(cleaned, "    ", " ")

		print("User input: '" + userInput + "'")
		print("Cleaned: '" + normalized + "'")
