// Console Input Comprehensive Test
// Tests all console input methods as specified in the language

functions:
	void testBasicTextInput()
		print("=== Basic Text Input ===")
		// NOTE: This test demonstrates the API but uses mock values for automated testing
		// In a real interactive environment, these would prompt the user

		// Simulate user input for testing
		string userName = "TestUser"  // Would be: input("What's your name? ")
		string message = "Hello"      // Would be: input()

		print("Simulated text input:")
		print("User name: " + userName)
		print("Message: " + message)
		// Show the proper syntax that should be used
		print("Proper input syntax examples:")
		print("string name = input(\"What's your name? \")")
		print("string msg = input()")
	void testNumericInput()
		print("=== Numeric Input ===")
		// Simulate numeric input for testing
		integer age = 25            // Would be: input.integer("How old are you? ")
		number height = 5.9         // Would be: input.number("Your height in feet: ")

		print("Simulated numeric input:")
		print("Age: " + age.toString())
		print("Height: " + height.toString())
		// Show the proper syntax
		print("Proper numeric input syntax:")
		print("integer age = input.integer(\"How old are you? \")")
		print("number height = input.number(\"Your height in feet: \")")
	void testBooleanInput()
		print("=== Boolean Input ===")
		// Simulate boolean input for testing
		boolean confirmed = true    // Would be: input.yesNo("Are you sure? ")
		boolean subscribe = false   // Would be: input.yesNo("Subscribe to newsletter? ")

		print("Simulated boolean input:")
		print("Confirmed: " + confirmed.toString())
		print("Subscribe: " + subscribe.toString())
		// Show the proper syntax
		print("Proper boolean input syntax:")
		print("boolean confirm = input.yesNo(\"Are you sure? \")")
		print("boolean sub = input.yesNo(\"Subscribe? \")")
	void testInputWithCalculations()
		print("=== Input with Calculations ===")
		// Simulate input for mathematical operations
		integer num1 = 15           // Would be: input.integer("First number: ")
		integer num2 = 27           // Would be: input.integer("Second number: ")

		integer sum = num1 + num2
		integer product = num1 * num2
		number average = (num1.toNumber() + num2.toNumber()) / 2.0

		print("Simulated calculation with input:")
		print("First number: " + num1.toString())
		print("Second number: " + num2.toString())
		print("Sum: " + sum.toString())
		print("Product: " + product.toString())
		print("Average: " + average.toString())
	void testInputValidationScenarios()
		print("=== Input Validation Scenarios ===")
		// These demonstrate the expected behavior of input validation
		print("Input validation features:")
		print("- input.integer() handles invalid input with retry prompts")
		print("- input.number() converts strings to numbers safely")
		print("- input.yesNo() accepts yes/no, y/n, true/false, 1/0")
		print("- All input methods show helpful error messages")
		// Simulate validated input
		integer validatedAge = 30        // Assumes user entered valid integer
		number validatedTemp = 98.6      // Assumes user entered valid number
		boolean validatedChoice = true   // Assumes user entered valid yes/no

		print("Validated inputs:")
		print("Age (integer): " + validatedAge.toString())
		print("Temperature (number): " + validatedTemp.toString())
		print("Choice (boolean): " + validatedChoice.toString())
	void testInteractiveScenario()
		print("=== Interactive Scenario Simulation ===")
		// Simulate a complete interactive program flow
		print("Simulating user registration:")
		// In real usage, these would be interactive prompts:
		string fullName = "John Doe"     // input("Enter your full name: ")
		integer userAge = 28             // input.integer("Enter your age: ")
		number userHeight = 6.0          // input.number("Enter your height in feet: ")
		boolean acceptTerms = true       // input.yesNo("Accept terms and conditions? ")

		print("Registration Data:")
		print("Name: " + fullName)
		print("Age: " + userAge.toString() + " years")
		print("Height: " + userHeight.toString() + " feet")
		print("Terms accepted: " + acceptTerms.toString())
		if acceptTerms
			print("Registration completed successfully!")
		else
			print("Registration cancelled - terms not accepted")
	void testInputMethodChaining()
		print("=== Input Method Usage Patterns ===")
		// Demonstrate different usage patterns
		print("Usage pattern examples:")
		// Direct assignment
		print("Direct: string name = input(\"Name: \")")
		// With immediate use
		print("Immediate: print(\"Hello \" + input(\"Name: \"))")
		// With validation
		print("Validated: if input.yesNo(\"Continue? \") then ...")
		// Multiple inputs
		print("Multiple inputs in sequence:")
		string item1 = "Apple"    // input("First item: ")
		string item2 = "Banana"   // input("Second item: ")
		string item3 = "Orange"   // input("Third item: ")

		print("Shopping list:")
		print("1. " + item1)
		print("2. " + item2)
		print("3. " + item3)
start()
	print("Console Input Comprehensive Test")
	print("===============================")
	testBasicTextInput()
	print("")
	testNumericInput()
	print("")
	testBooleanInput()
	print("")
	testInputWithCalculations()
	print("")
	testInputValidationScenarios()
	print("")
	testInteractiveScenario()
	print("")
	testInputMethodChaining()
	print("")
	print("Console input test completed")
	print("(Note: This test simulates input for automated testing)")