// Simple QA Test for Input Method Syntax
// Tests basic input.method() calls for user input operations

functions:

	void testInputMethods()

		// Test basic input method
		string userInput = input("Enter your name: ")
		print("You entered: ")
		print(userInput)

		// Test input.integer() method - placeholder for now
		integer userAge = input.integer("Enter your age: ")
		print("Your age is: ")
		print(userAge.toString())

		// Test input.yesNo() method
		boolean confirm = input.yesNo("Continue? ")
		print("You chose: ")
		print(confirm.toString())

		print("Input method syntax test completed successfully!")

start:

	print("Input Method Syntax QA Test")
	testInputMethods()
	print("Test completed")