// Test: stdlib/json/coverage_prettyDataToText_formatting
// Semantic: SEM/json.prettyDataToText
// Expected output:
//   {
//     "name": "Alice",
//     "age": 30
//   }
//   [
//     1,
//     2,
//     3
//   ]

start:
	any obj = json.textToData("{\"name\":\"Alice\",\"age\":30}")
	printl(json.prettyDataToText(obj))
	any arr = json.textToData("[1,2,3]")
	printl(json.prettyDataToText(arr))
