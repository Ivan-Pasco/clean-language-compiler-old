// Test: stdlib/json/json_encode_list_number
// Semantic: FUNC-BUILTIN — json.encode dispatches to __json_encode_cln_list
//   with elem_tag = 3 (Number). Number lists use 8-byte element stride; the
//   helper checks `elem_tag == 3` and switches to F64Load + float_to_string.
// Regression: see json_encode_typed_list.cln header.
//
// Expected output:
//   [1.5,2.5,3.5]

start:
	list<number> fs = [1.5, 2.5, 3.5]
	print(json.encode(fs))
