// Test: stdlib/json/json_encode_primitives
// Grammar: function_call → namespace "." function_name "(" args ")"
// Semantic: FUNC001 (tracking: FUNC-BUILTIN) — json.encode boxes primitive arguments before passing to json.dataToText
// Regression: SEM-JSON-ENCODE-TRAP — json.encode("non-empty") trapped in WASM before RUN002 (tracking: RUNTIME002) fix
//   Root cause: string/integer/boolean args were not boxed to Any before calling __json_stringify_value.
//   Fix: emit_box_any is called for all non-Any arguments when calling Any-parameter builtins.
//
// Expected output:
//   ""
//   "hello"
//   "open"
//   42
//   3.14
//   true
//   false
//   "has \"quotes\""

start:
	// Empty string — SEM-JSON-ENCODE-TRAP: should produce "" not trap
	string s1 = json.encode("")
	print(s1)

	// Non-empty string literal — SEM-JSON-ENCODE-TRAP: should produce "hello" not trap
	string s2 = json.encode("hello")
	print(s2)

	// String variable (not literal)
	string src = "open"
	string s3 = json.encode(src)
	print(s3)

	// Integer
	string s4 = json.encode(42)
	print(s4)

	// Number
	string s5 = json.encode(3.14)
	print(s5)

	// Boolean true/false
	string s6 = json.encode(true)
	print(s6)
	string s7 = json.encode(false)
	print(s7)

	// String with special chars that need escaping
	string special = "has \"quotes\""
	string s8 = json.encode(special)
	print(s8)
