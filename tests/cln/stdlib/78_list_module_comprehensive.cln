// Test 78: Comprehensive List Module Operations
// Tests all list functions: basic operations, modifications, transformations, functional programming
//
// Changed in 0.33.184: `list.<method>(items, ...)` namespace calls are now the
// method form `items.<method>(...)`; the `list.` namespace has only concat,
// range, fill and join (developer decision)

start:
	// Basic list operations
	list<integer> numbers = [1, 2, 3, 4, 5]
	integer size = numbers.length()
	// Fixed: was list.get(l, i), spec defines l.get(i)
	integer first = numbers.get(0)
	integer last = numbers.get(4)
	print("List: [1, 2, 3, 4, 5]")
	print("Length: " + size.toString())
	print("First: " + first.toString())
	print("Last: " + last.toString())
	// List modification
	numbers.add(6)
	list<integer> modified = numbers
	modified.insert(2, 99)
	list<integer> inserted = modified
	integer removed = inserted.remove(2)
	print("After add 6: length = " + modified.length().toString())
	print("After insert 99 at index 2: length = " + inserted.length().toString())
	print("Removed value: " + removed.toString())
	// Search operations
	list<string> fruits = ["apple", "banana", "apple", "orange"]
	boolean hasApple = fruits.contains("apple")
	integer appleIndex = fruits.indexOf("apple")
	integer lastAppleIndex = fruits.lastIndexOf("apple")
	print("Contains apple: " + hasApple.toString())
	print("First apple index: " + appleIndex.toString())
	print("Last apple index: " + lastAppleIndex.toString())
	// List transformation
	list<integer> data = [5, 2, 8, 1, 9, 3]
	list<integer> sorted = data.sort()
	list<integer> reversed = data.reverse()
	list<integer> section = data.slice(1, 4)
	print("Original: [5, 2, 8, 1, 9, 3]")
	print("Sorted length: " + sorted.length().toString())
	print("Reversed length: " + reversed.length().toString())
	print("Section (1-4) length: " + section.length().toString())
	// List concatenation
	list<string> list1 = ["a", "b"]
	list<string> list2 = ["c", "d"]
	list<string> combined = list.concat(list1, list2)
	print("Combined length: " + combined.length().toString())
	// Utility operations
	list<integer> empty = [0]  // Initialize with dummy value
	boolean isEmpty = empty.isEmpty()
	boolean isNotEmpty = numbers.isNotEmpty()
	print("Empty list is empty: " + isEmpty.toString())
	print("Numbers list is not empty: " + isNotEmpty.toString())
	// First and last element access
	string firstFruit = fruits.first()
	string lastFruit = fruits.last()
	print("First fruit: " + firstFruit)
	print("Last fruit: " + lastFruit)
	// String joining
	list<string> words = ["Clean", "Language", "is", "awesome"]
	string sentence = list.join(words, " ")
	print("Joined sentence: " + sentence)
	// List creation helpers
	list<string> filled = list.fill(3, "hello")
	list<integer> range = list.range(1, 5)
	print("Filled list length: " + filled.length().toString())
	print("Range list length: " + range.length().toString())