// Numeric Literals Comprehensive Test
// Tests all numeric literal formats including alternative bases

functions:
	void testDecimalLiterals()
		print("Testing decimal literals")
		// Positive decimal integers
		integer dec1 = 42
		integer dec2 = 123
		integer dec3 = 999

		// Negative decimal integers
		integer neg1 = -17
		integer neg2 = -999

		// Decimal floating-point
		number float1 = 3.14
		number float2 = -2.5
		number float3 = .5
		number float4 = 6.02e23
		number float5 = -1.23e-4

		print("Decimal integer: " + dec1.toString())
		print("Large decimal: " + dec2.toString())
		print("Another decimal: " + dec3.toString())
		print("Negative decimal: " + neg1.toString())
		print("Large negative: " + neg2.toString())
		print("Pi approximation: " + float1.toString())
		print("Negative float: " + float2.toString())
		print("Leading zero optional: " + float3.toString())
		print("Scientific notation: " + float4.toString())
		print("Negative scientific: " + float5.toString())
	void testHexadecimalLiterals()
		print("Testing hexadecimal literals")
		// Hexadecimal literals
		integer hex1 = 0xff        // 255
		integer hex2 = 0xFF        // 255 (case insensitive)
		integer hex3 = 0x10        // 16
		integer hex4 = 0x0         // 0
		integer hex5 = 0xABCD      // 43981

		// Negative hexadecimal
		integer hexNeg1 = -0xff    // -255
		integer hexNeg2 = -0x10    // -16

		print("Hex 0xff: " + hex1.toString())
		print("Hex 0xFF: " + hex2.toString())
		print("Hex 0x10: " + hex3.toString())
		print("Hex 0x0: " + hex4.toString())
		print("Hex 0xABCD: " + hex5.toString())
		print("Negative hex -0xff: " + hexNeg1.toString())
		print("Negative hex -0x10: " + hexNeg2.toString())
	void testBinaryLiterals()
		print("Testing binary literals")
		// Binary literals
		integer bin1 = 0b1010      // 10
		integer bin2 = 0b1111      // 15
		integer bin3 = 0b0         // 0
		integer bin4 = 0b1         // 1
		integer bin5 = 0b11111111  // 255

		// Negative binary
		integer binNeg1 = -0b1010  // -10
		integer binNeg2 = -0b1111  // -15

		print("Binary 0b1010: " + bin1.toString())
		print("Binary 0b1111: " + bin2.toString())
		print("Binary 0b0: " + bin3.toString())
		print("Binary 0b1: " + bin4.toString())
		print("Binary 0b11111111: " + bin5.toString())
		print("Negative binary -0b1010: " + binNeg1.toString())
		print("Negative binary -0b1111: " + binNeg2.toString())
	void testOctalLiterals()
		print("Testing octal literals")
		// Octal literals
		integer oct1 = 0o777       // 511
		integer oct2 = 0o123       // 83
		integer oct3 = 0o0         // 0
		integer oct4 = 0o7         // 7
		integer oct5 = 0o644       // 420

		// Negative octal
		integer octNeg1 = -0o777   // -511
		integer octNeg2 = -0o123   // -83

		print("Octal 0o777: " + oct1.toString())
		print("Octal 0o123: " + oct2.toString())
		print("Octal 0o0: " + oct3.toString())
		print("Octal 0o7: " + oct4.toString())
		print("Octal 0o644: " + oct5.toString())
		print("Negative octal -0o777: " + octNeg1.toString())
		print("Negative octal -0o123: " + octNeg2.toString())
	void testLiteralComparisons()
		print("Testing literal equivalence")
		// Same values in different bases
		integer decimal = 255
		integer hex = 0xFF
		integer binary = 0b11111111
		integer octal = 0o377

		print("Decimal 255: " + decimal.toString())
		print("Hex 0xFF: " + hex.toString())
		print("Binary 0b11111111: " + binary.toString())
		print("Octal 0o377: " + octal.toString())
		// They should all be equal to 255
		boolean eq1 = decimal == hex
		boolean eq2 = hex == binary
		boolean eq3 = binary == octal
		boolean eq4 = octal == decimal

		print("Decimal == Hex: " + eq1.toString())
		print("Hex == Binary: " + eq2.toString())
		print("Binary == Octal: " + eq3.toString())
		print("Octal == Decimal: " + eq4.toString())
start()
	print("Numeric Literals Comprehensive Test")
	print("===================================")
	testDecimalLiterals()
	print("")
	testHexadecimalLiterals()
	print("")
	testBinaryLiterals()
	print("")
	testOctalLiterals()
	print("")
	testLiteralComparisons()
	print("")
	print("All numeric literal tests passed")