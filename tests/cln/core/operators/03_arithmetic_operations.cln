// Spec Section: 4.3 - Arithmetic Operators
// Grammar: additive_op, power_op, expression
// Semantic: SEM001 — arithmetic operator result type matches operand types
// Tests: Addition, subtraction, multiplication, division, modulo, exponentiation

start:
	integer a = 10
	integer b = 3

	integer sum = a + b
	integer diff = a - b
	integer product = a * b
	integer quotient = a / b
	integer remainder = a % b
	number power = a ^ b

	print(sum)
	print(diff)
	print(product)
	print(quotient)
	print(remainder)
	print(power)