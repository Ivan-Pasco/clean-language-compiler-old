// Test: core/capabilities — class claiming a capability without providing a required
//                            method must fail with SEM011
// Grammar: capability conformance validation in the resolver
// Semantic: SEM011 (missing capability method) — semantic-rules.md §SEM011
// Fixed in: compiler 0.33.184
// Expected output:
// Expected error:
//   SEM011
//   does not implement required method 'draw()'

start:
	print("unreachable")

can Draw:
	draw()

class Circle can Draw
