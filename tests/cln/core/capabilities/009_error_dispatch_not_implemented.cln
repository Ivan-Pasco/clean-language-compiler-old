// Test: core/capabilities — calling a method on a capability-typed value is a v1 compile error
// Grammar: method_call on a receiver whose static type is a capability
// Semantic: runtime dispatch (per-class vtables + call_indirect) ships in a follow-up
// Expected compile error: "not yet dispatchable"

start:
	Circle c = Circle()
	render(c)

can Draw:
	draw()

class Circle can Draw
	functions:
		public:
			draw()
				print("circle")

functions:
	render(Draw thing)
		thing.draw()
