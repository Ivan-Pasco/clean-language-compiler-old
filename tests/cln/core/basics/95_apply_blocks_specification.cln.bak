// Apply-Blocks Specification Implementation Test
// Tests apply-block syntax for function calls and variable declarations

functions:
	void testFunctionApplyBlocks()
		print("=== Function Call Apply-Blocks ===") +
		
		// Individual print statements for comparison
		print("Individual calls:") +
		print "Hello"
		print "World"
		print "Clean"
		
		print("Apply-block equivalent:") +
		// Apply-block syntax: print: applies to each indented item
		print:
			"Hello"
			"World"  
			"Clean"
		
		print("Multiple function apply-blocks:") +
		print:
			"First message"
			"Second message"
		
		// Should be equivalent to: print("First message"), print("Second message")
		
	void testVariableApplyBlocks()
		print("=== Variable Declaration Apply-Blocks ===") +
		
		// Traditional variable declarations
		integer count1 = 1
		integer maxSize1 = 100
		integer currentIndex1 = -1
		
		// Apply-block syntax for variables
		integer:
			count2 = 2
			maxSize2 = 200
			currentIndex2 = -2
		
		string:
			name = "Alice"
			version = "1.0"
			status = "active"
		
		print("Traditional declarations:") +
		print "count1: " + count1.toString() ln
		print "maxSize1: " + maxSize1.toString() ln
		print "currentIndex1: " + currentIndex1.toString() ln
		
		print("Apply-block declarations:") +
		print "count2: " + count2.toString() ln
		print "maxSize2: " + maxSize2.toString() ln
		print "currentIndex2: " + currentIndex2.toString() ln
		print "name: " + name ln
		print "version: " + version ln
		print "status: " + status ln
		
	void testConstantApplyBlocks()
		print("=== Constant Apply-Blocks ===") +
		
		// Apply-block syntax for constants
		constant:
			integer MAX_SIZE = 100
			number PI = 3.14159
			string VERSION = "1.0.0"
			boolean DEBUG = true
		
		print("Constants via apply-blocks:") +
		print "MAX_SIZE: " + MAX_SIZE.toString() ln
		print "PI: " + PI.toString() ln
		print "VERSION: " + VERSION ln
		print "DEBUG: " + DEBUG.toString() ln
		
	void testMixedApplyBlocks()
		print("=== Mixed Apply-Block Usage ===") +
		
		// Mix of traditional and apply-block syntax
		number:
			temperature = 23.5
			humidity = 65.2
			pressure = 1013.25
		
		boolean:
			isActive = true
			isComplete = false
			hasErrors = false
		
		// Function apply-blocks with expressions
		print:
			"Temperature: " + temperature.toString()
			"Humidity: " + humidity.toString()
			"Pressure: " + pressure.toString()
			"Active: " + isActive.toString()
			"Complete: " + isComplete.toString()
			"Has Errors: " + hasErrors.toString()
			
	void testNestedApplyBlocks()
		print("=== Nested Apply-Block Context ===") +
		
		string:
			message1 = "First message"
			message2 = "Second message"
			message3 = "Third message"
		
		integer:
			value1 = 10
			value2 = 20
			value3 = 30
		
		print("Nested context messages:") +
		print:
			message1
			message2
			message3
			
		print("Nested context values:") +
		print:
			"Value 1: " + value1.toString()
			"Value 2: " + value2.toString()
			"Value 3: " + value3.toString()

start()
	print("Apply-Blocks Specification Test") +
	print("===============================") +
	testFunctionApplyBlocks()
	print("") +
	testVariableApplyBlocks()
	print("") +
	testConstantApplyBlocks()
	print("") +
	testMixedApplyBlocks()
	print("") +
	testNestedApplyBlocks()
	print("") +
	print("Apply-blocks specification test completed") +