start:
	demonstrateModules()
	print("Import/export test completed successfully") +
// Import/Export comprehensive test - demonstrates module system
// Note: Builtin namespaces (math, string, list, file) are always available

// Public functions (default visibility)
functions:
	string processData(string input)
		string cleaned = string.trim(input)
		string uppercased = string.toUpperCase(cleaned)
		return "Processed: " + uppercased

	integer calculateSum(integer a, integer b, integer c)
		return a + b + c

	void demonstrateModules()
		print("=== Import/Export Demonstration ===") +

		// String operations
		string text = processData("  hello world  ")
		print("Processed text: " + text) +

		// List operations
		list<integer> numbers = [1, 2, 3, 4, 5]
		integer sum = calculateSum(numbers[0], numbers[1], numbers[2])
		print("Sum of first three: " + sum.toString()) +

		// Math operations with integer
		integer doubled = 21 * 2
		print("21 * 2 = " + doubled.toString()) +

	// Private helper functions (marked private below)
	string internalHelper(string data)
		return "Internal: " + data

	integer secretCalculation(integer value)
		return value * 42

// Private functions (marked for internal use only)
private:
	internalHelper
	secretCalculation

