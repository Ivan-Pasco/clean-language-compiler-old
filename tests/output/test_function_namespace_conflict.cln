start()
	// Test potential function vs namespace conflict
	number math_result = math.sqrt(16.0)
	print("Math namespace works")

	// Define a function with the same name as a namespace function
	math_sqrt(value: number) -> number
		// This should not conflict with the namespace math.sqrt
		print("Custom math_sqrt function called")
		return value * 2.0

	number custom_result = math_sqrt(4.0)
	print("Custom function works")