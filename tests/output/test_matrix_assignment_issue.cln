start()
	matrix<integer> intMatrix = [[1, 2]]
	matrix<number> numMatrix = [[1.5, 2.5]]

	// Direct assignment - should this work?
	matrix<number> explicitResult = intMatrix + numMatrix
	print("Explicit assignment works")

	// Inferred assignment
	auto inferredResult = intMatrix + numMatrix
	print("Inferred assignment works")